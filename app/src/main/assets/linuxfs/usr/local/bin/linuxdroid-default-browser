#!/bin/bash
# Make Chromium the default web browser when it is installed (once, so later user choices are kept).
# Pass --force to apply again.
stamp="${XDG_DATA_HOME:-$HOME/.local/share}/linuxdroid/chromium-default-v1"
[ "${1:-}" = "--force" ] && rm -f "$stamp"
[ -e "$stamp" ] && exit 0
desktop=""
for d in chromium.desktop chromium-browser.desktop; do
  [ -f "/usr/share/applications/$d" ] && { desktop="$d"; break; }
done
[ -n "$desktop" ] || exit 0
[ -x /usr/bin/chromium ] || [ -x /usr/bin/chromium-browser ] || exit 0
for mime in x-scheme-handler/http x-scheme-handler/https text/html application/xhtml+xml; do
  xdg-mime default "$desktop" "$mime" 2>/dev/null || true
done
xdg-settings set default-web-browser "$desktop" 2>/dev/null || true
for kw in kwriteconfig6 kwriteconfig5; do
  command -v "$kw" >/dev/null 2>&1 && "$kw" --file kdeglobals --group General --key BrowserApplication "${desktop%.desktop}" 2>/dev/null
done
mkdir -p "${stamp%/*}" && : > "$stamp"
