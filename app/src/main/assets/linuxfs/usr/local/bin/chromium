#!/bin/bash
# LinuxDroid: Chromium wrapper for PRoot + Wayland/X11 + ANGLE (Mesa EGL/GLESv2).
name="$(basename "$0")"
real_bin=""
for cand in \
  /usr/lib/chromium/chromium \
  /usr/lib/chromium-browser/chromium-browser \
  /usr/lib/chromium-browser/chromium \
  "/usr/bin/${name}.distrib"; do
  if [ -x "$cand" ]; then
    real_bin="$cand"
    break
  fi
done

if [ -z "$real_bin" ]; then
  IFS=: read -ra dirs <<< "$PATH"
  for d in "${dirs[@]}"; do
    [ "$d" = "/usr/local/bin" ] && continue
    if [ -x "$d/$name" ] && [ ! "$d/$name" -ef "$0" ]; then
      real_bin="$d/$name"
      break
    fi
  done
fi

if [ -z "$real_bin" ]; then
  echo "$name: command not found" >&2
  exit 127
fi

for arg in "$@"; do
  case "$arg" in
    --version|-v|--help|-h) exec "$real_bin" "$@" ;;
  esac
done

case "${LANG:-}" in
  ""|C|C.*|POSIX) export LANG="en_US.UTF-8" ;;
esac
mkdir -p /tmp/chromium-crashpad 2>/dev/null || true

if [ -r /etc/linuxdroid/gpu.env ]; then
  set -a
  # shellcheck disable=SC1091
  . /etc/linuxdroid/gpu.env
  set +a
fi
if [ -r "${XDG_RUNTIME_DIR:-/run/linuxdroid}/desktop.env" ]; then
  # shellcheck disable=SC1090
  . "${XDG_RUNTIME_DIR:-/run/linuxdroid}/desktop.env"
fi
# ANGLE gles-egl requests an OpenGL ES context; desktop GL overrides break ANGLE initialization on Mali/VirGL.
unset MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE

user_args=()
for arg in "$@"; do
  case "$arg" in
    --no-sandbox|--no-zygote|--disable-gpu-sandbox|--disable-dev-shm-usage|--in-process-gpu|--disable-gpu-watchdog|--disable-vulkan|--ozone-platform-hint=*|--ozone-platform=*)
      ;;
    *)
      user_args+=("$arg")
      ;;
  esac
done

flags=(
  --no-sandbox
  --no-zygote
  --disable-gpu-sandbox
  --disable-dev-shm-usage
  --disable-gpu-watchdog
  --disable-vulkan
  --disable-features=Vulkan,DefaultANGLEVulkan,VulkanFromANGLE,GlobalShortcutsPortal,DesktopCapturePipeWire,WebRtcPipeWireCapturer,AudioServiceOutOfProcess
  --password-store=basic
  --no-first-run
  --no-default-browser-check
  --lang=en-US
  --use-gl=angle
  --use-angle=gles-egl
)

# Wait briefly for on-demand Xwayland socket if nested Wayland compositor is running
if [ ! -S /tmp/.X11-unix/X0 ] && [ ! -S /tmp/.X11-unix/X1 ] && \
   { [ -S "${XDG_RUNTIME_DIR:-/run/linuxdroid}/wayland-1" ] || [ -S "${XDG_RUNTIME_DIR:-/run/linuxdroid}/wayland-2" ]; }; then
  for _ in $(seq 1 20); do
    [ -S /tmp/.X11-unix/X0 ] || [ -S /tmp/.X11-unix/X1 ] && break
    sleep 0.1
  done
fi

# Route Chromium to Xwayland (:0) whenever available so both Adreno Turnip (Zink + Kopper DRI2)
# and Mali / VirGL / llvmpipe present via X11 SHM inside a decorated KWin / XFCE window without
# needing zwp_linux_dmabuf_v1 on nested KWin QPainter (wayland-1).
if [ -S /tmp/.X11-unix/X0 ] || [ -S /tmp/.X11-unix/X1 ]; then
  if [ -z "${DISPLAY:-}" ]; then
    if [ -S /tmp/.X11-unix/X0 ]; then
      export DISPLAY=:0
    else
      export DISPLAY=:1
    fi
  fi
  export WAYLAND_DISPLAY=wayland-off
  export BL_FORCE_X11=1
  if [ -z "${XAUTHORITY:-}" ] || [ ! -r "${XAUTHORITY:-}" ]; then
    for xa in "${XDG_RUNTIME_DIR:-/run/linuxdroid}"/xauth_* "${HOME:-/home/linux}/.Xauthority"; do
      if [ -r "$xa" ]; then
        export XAUTHORITY="$xa"
        break
      fi
    done
  fi
  flags+=(--ozone-platform=x11)
else
  flags+=(--ozone-platform-hint=auto)
fi

if [ "${BL_GPU_APPS:-0}" = "1" ]; then
  if [ "${LINUXDROID_GPU_ACTIVE:-}" = "turnip" ]; then
    flags+=(--in-process-gpu)
  fi
  flags+=(--ignore-gpu-blocklist --enable-gpu-rasterization --enable-zero-copy)
  if [ -x /usr/local/bin/linuxdroid-gpu-launch ]; then
    exec /usr/local/bin/linuxdroid-gpu-launch "$real_bin" "${flags[@]}" "${user_args[@]}"
  fi
fi

export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe
unset MESA_LOADER_DRIVER_OVERRIDE LIBGL_KOPPER_DRI2
exec "$real_bin" "${flags[@]}" "${user_args[@]}"
