#!/bin/bash
set -u

export BL_DESKTOP=1
export HOME="${HOME:-/home/linux}"
export USER="${USER:-$(id -un 2>/dev/null || echo linux)}"
export LOGNAME="$USER"
export SHELL=/bin/bash
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export FLATPAK_BWRAP="/usr/local/bin/bwrap"
export GLIBC_TUNABLES="${GLIBC_TUNABLES:-glibc.pthread.rseq=0:glibc.malloc.top_pad=16777216}"
if [ "$(ulimit -Sn 2>/dev/null || echo 0)" -gt 16384 ] 2>/dev/null; then
  ulimit -Sn 16384 2>/dev/null || true
fi

boot_step() {
  local step_num="$1"
  local msg="$2"
  echo "== [BOOT ${step_num}/6] ${msg}"
  if [ -n "${BL_BOOT_STATUS:-}" ]; then
    printf '%s|%s\n' "$step_num" "$msg" > "${BL_BOOT_STATUS}.tmp" 2>/dev/null && \
      mv -f "${BL_BOOT_STATUS}.tmp" "${BL_BOOT_STATUS}" 2>/dev/null || true
  fi
}

if [ -n "${BL_LOG:-}" ]; then
  mkdir -p "$(dirname "$BL_LOG")" 2>/dev/null || true
  if [ "$(stat -c %s "$BL_LOG" 2>/dev/null || echo 0)" -gt 8388608 ]; then
    mv -f "$BL_LOG" "$BL_LOG.1" 2>/dev/null || true
  fi
  exec >>"$BL_LOG" 2>&1
  echo "== linuxdroid-session $(date -u '+%Y-%m-%d %H:%M:%S UTC') user=$USER uid=$(id -u) ${BL_WIDTH:-1920}x${BL_HEIGHT:-1080}@${BL_REFRESH:-60}"
fi

if [ -n "${BL_CPU_CORES:-}" ] && command -v taskset >/dev/null 2>&1; then
  if taskset -pc "$BL_CPU_CORES" $$ >/dev/null 2>&1; then
    echo "== cpu affinity pinned to cores: ${BL_CPU_CORES} (${BL_CPU_COUNT:-custom} cores)"
  fi
fi

boot_step 4 "Preparing Ubuntu environment & system services..."

sync_timezone() {
  local zone="${TZ:-}"
  case "$zone" in ''|/*|*..*) return 0 ;; esac
  [ -f "/usr/share/zoneinfo/$zone" ] || return 0
  if [ "$(readlink /etc/localtime 2>/dev/null)" != "/usr/share/zoneinfo/$zone" ]; then
    linuxdroid-root ln -sfn "/usr/share/zoneinfo/$zone" /etc/localtime 2>/dev/null || true
    printf '%s\n' "$zone" | linuxdroid-root tee /etc/timezone >/dev/null 2>&1 || true
  fi
}
sync_timezone

sync_android_groups() {
  [ -r /etc/group ] || return 0
  local gids gid gname user_id rem
  gids="$(id -G 2>/dev/null || true)"
  [ -n "$gids" ] || return 0
  local missing_lines=""
  for gid in $gids; do
    case "$gid" in ''|*[!0-9]*) continue ;; esac
    if ! grep -qE "^[^:]+:[^:]*:${gid}:" /etc/group 2>/dev/null; then
      case "$gid" in
        1015) gname="sdcard_rw" ;;
        1023) gname="media_rw" ;;
        1028) gname="sdcard_r" ;;
        1077) gname="external_storage" ;;
        1078) gname="ext_data_rw" ;;
        1079) gname="ext_obb_rw" ;;
        3001) gname="net_bt_admin" ;;
        3002) gname="net_bt" ;;
        3003) gname="inet" ;;
        3004) gname="net_raw" ;;
        3005) gname="net_admin" ;;
        3006) gname="net_bw_stats" ;;
        3007) gname="net_bw_acct" ;;
        3009) gname="readproc" ;;
        3010) gname="wakelock" ;;
        3011) gname="uhid" ;;
        3012) gname="readtracefs" ;;
        9997) gname="everybody" ;;
        *)
          user_id=$((gid / 100000))
          rem=$((gid % 100000))
          if [ "$rem" -ge 20000 ] && [ "$rem" -le 29999 ]; then
            gname="u${user_id}_a$((rem - 20000))_cache"
          elif [ "$rem" -ge 30000 ] && [ "$rem" -le 39999 ]; then
            gname="u${user_id}_a$((rem - 30000))_ext"
          elif [ "$rem" -ge 40000 ] && [ "$rem" -le 49999 ]; then
            gname="u${user_id}_a$((rem - 40000))_ext_cache"
          elif [ "$rem" -ge 50000 ] && [ "$rem" -le 59999 ]; then
            if [ "$user_id" -eq 0 ]; then
              gname="all_a$((rem - 50000))"
            else
              gname="u${user_id}_all_a$((rem - 50000))"
            fi
          else
            gname="aid_${gid}"
          fi
          ;;
      esac
      if grep -qE "^${gname}:" /etc/group 2>/dev/null; then
        gname="aid_${gid}"
      fi
      missing_lines="${missing_lines}${gname}:x:${gid}:${USER},root"$'\n'
    fi
  done
  if [ -n "$missing_lines" ]; then
    printf '%s' "$missing_lines" >> /etc/group 2>/dev/null || \
      printf '%s' "$missing_lines" | linuxdroid-root tee -a /etc/group >/dev/null 2>&1 || true
  fi
}
sync_android_groups

prepare_locale() {
  local dir=/usr/lib/locale stamp=/var/tmp/.linuxdroid-locale
  [ -f "$stamp" ] && [ -f "$dir/locale-archive" ] && return 0
  if [ -d "$dir/C.utf8" ] && command -v localedef >/dev/null 2>&1; then
    LINUXDROID_LINK_RENAME=1 linuxdroid-root localedef --add-to-archive --replace "$dir/C.utf8" >/dev/null 2>&1 || true
    touch "$stamp" 2>/dev/null || true
  fi
}
prepare_locale

# Remove systemd's /bin/false session D-Bus stub and KSplash plasma_waitforname service if present,
# and neutralize /usr/bin/ksplashqml so KDE's fullscreen LayerOverlay splash never covers the desktop.
for stub_svc in \
  /usr/share/dbus-1/services/org.freedesktop.systemd1.service \
  /usr/share/dbus-1/services/org.kde.KSplash.service \
  /usr/share/dbus-1/services/org.freedesktop.portal.Desktop.service \
  /usr/share/dbus-1/services/org.freedesktop.portal.Documents.service \
  /usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.kde.service \
  /usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.gtk.service; do
  if [ -f "$stub_svc" ]; then
    rm -f "$stub_svc" 2>/dev/null || linuxdroid-root rm -f "$stub_svc" 2>/dev/null || true
  fi
done
if [ -f /usr/bin/ksplashqml ] && ! grep -q "^# LinuxDroid" /usr/bin/ksplashqml 2>/dev/null; then
  cp -f /usr/local/bin/ksplashqml /usr/bin/ksplashqml 2>/dev/null || \
    linuxdroid-root cp -f /usr/local/bin/ksplashqml /usr/bin/ksplashqml 2>/dev/null || true
fi

# GPU acceleration shims: route GPU-capable apps through linuxdroid-gpu-launch (Settings > Hardware toggle).
for gpu_app in firefox mpv vlc krita gimp kdenlive obs godot glxgears vkcube; do
  gpu_real=""
  for gpu_dir in /usr/bin /bin /usr/games /opt/bin; do
    [ -x "$gpu_dir/$gpu_app" ] && gpu_real="$gpu_dir/$gpu_app" && break
  done
  [ -n "$gpu_real" ] || continue
  [ -e "/usr/local/bin/$gpu_app" ] && continue
  gpu_body="#!/bin/sh
exec /usr/local/bin/linuxdroid-gpu-launch $gpu_app \"\$@\""
  printf '%s\n' "$gpu_body" > "/usr/local/bin/$gpu_app" 2>/dev/null && chmod 755 "/usr/local/bin/$gpu_app" 2>/dev/null || \
    linuxdroid-root sh -c "printf '%s\n' '$gpu_body' > /usr/local/bin/$gpu_app && chmod 755 /usr/local/bin/$gpu_app" 2>/dev/null || true
done

# Ensure /usr/bin/plasmashell and /usr/bin/kwin_wayland_wrapper use the LinuxDroid wrappers even when invoked by full path
for kde_tool in plasmashell kwin_wayland_wrapper; do
  if [ ! -x "/usr/bin/${kde_tool}.distrib" ] && [ -x "/usr/lib/linuxdroid/${kde_tool}.real" ]; then
    cp -a "/usr/lib/linuxdroid/${kde_tool}.real" "/usr/bin/${kde_tool}.distrib" 2>/dev/null || \
      linuxdroid-root cp -a "/usr/lib/linuxdroid/${kde_tool}.real" "/usr/bin/${kde_tool}.distrib" 2>/dev/null || true
  fi
  if [ -x "/usr/local/bin/$kde_tool" ] && [ -f "/usr/bin/$kde_tool" ]; then
    if ! grep -q "^# LinuxDroid $kde_tool" "/usr/bin/$kde_tool" 2>/dev/null; then
      (
        if [ ! -e "/usr/bin/${kde_tool}.distrib" ]; then
          cp -a "/usr/bin/$kde_tool" "/usr/bin/${kde_tool}.distrib" 2>/dev/null || \
            linuxdroid-root cp -a "/usr/bin/$kde_tool" "/usr/bin/${kde_tool}.distrib" 2>/dev/null || true
        fi
        if [ -x "/usr/bin/${kde_tool}.distrib" ]; then
          cp -f "/usr/local/bin/$kde_tool" "/usr/bin/$kde_tool" 2>/dev/null || \
            linuxdroid-root cp -f "/usr/local/bin/$kde_tool" "/usr/bin/$kde_tool" 2>/dev/null || true
        fi
      )
    fi
  fi
done

# Ensure any existing /opt/blender installation uses the safe wrapper without MESA_NO_ERROR / DRI_PRIME / bundled libvulkan
if [ -x /opt/blender/blender ]; then
  rm -f "${HOME:-/home/linux}/.cache/linuxdroid/gpu-fallback/blender" \
        "${HOME:-/home/linux}/.cache/linuxdroid/gpu-fallback/blender-launcher" \
        /opt/blender/lib/libvulkan.so* 2>/dev/null || \
    linuxdroid-root rm -f /opt/blender/lib/libvulkan.so* 2>/dev/null || true
  refresh_blender_wrapper='
    rm -f /opt/blender/lib/libvulkan.so* 2>/dev/null || true
    cat > /usr/local/bin/blender.tmp <<'\''WRAP'\''
#!/bin/sh
# BL_WRAPPER_V7
unset MESA_NO_ERROR DRI_PRIME
export LIBDECOR_PLUGIN_DIR=/nonexistent
export LP_NUM_THREADS="${BL_CPU_COUNT:-4}"
if [ "${BL_GPU_APPS:-1}" = "1" ]; then
  unset LIBGL_ALWAYS_SOFTWARE
else
  unset MESA_LOADER_DRIVER_OVERRIDE LIBGL_KOPPER_DRI2 MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE
  export LIBGL_ALWAYS_SOFTWARE=1
  export GALLIUM_DRIVER=llvmpipe
fi
if [ "${LIBGL_ALWAYS_SOFTWARE:-}" = "1" ] && [ "${BL_GPU_APPS:-1}" != "1" ]; then
  case " $* " in
    *" --version "*|*" -v "*|*" --help "*|*" -h "*|*" -b "*|*" --background "*) ;;
    *)
      set -- --python-expr "import bpy
try:
    bpy.context.preferences.system.viewport_aa = \"OFF\"
    bpy.context.preferences.system.anisotropic_filter = \"FILTER_0\"
except Exception:
    pass" "$@"
      ;;
  esac
fi
export LD_LIBRARY_PATH="/usr/lib/aarch64-linux-gnu:/opt/blender/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [ -x /opt/blender/blender-launcher ]; then
  exec /usr/local/bin/linuxdroid-gpu-launch /opt/blender/blender-launcher "$@"
fi
exec /usr/local/bin/linuxdroid-gpu-launch /opt/blender/blender "$@"
WRAP
    chmod 755 /usr/local/bin/blender.tmp && mv -f /usr/local/bin/blender.tmp /usr/local/bin/blender
    if [ -f /opt/blender/blender.desktop ]; then
      sed -e "s#^Exec=blender#Exec=/usr/local/bin/blender#" -e "/^PrefersNonDefaultGPU=/d" /opt/blender/blender.desktop > /usr/share/applications/blender.desktop.tmp &&
      chmod 644 /usr/share/applications/blender.desktop.tmp &&
      mv -f /usr/share/applications/blender.desktop.tmp /usr/share/applications/blender.desktop
    fi
  '
  if ! grep -q "BL_WRAPPER_V7" /usr/local/bin/blender 2>/dev/null || grep -q "^PrefersNonDefaultGPU=" /usr/share/applications/blender.desktop 2>/dev/null || [ ! -s /usr/share/applications/blender.desktop ]; then
    sh -c "$refresh_blender_wrapper" 2>/dev/null || linuxdroid-root sh -c "$refresh_blender_wrapper" 2>/dev/null || true
  fi
fi

rm -f /tmp/.bl-clock
head -c 8 /dev/zero > /tmp/.bl-clock 2>/dev/null || true
if [ "${BL_ZRAM:-0}" = "1" ]; then
  printf 0 > /tmp/.bl-zram 2>/dev/null || true
else
  rm -f /tmp/.bl-zram 2>/dev/null || true
fi

# Clean stale X11/ICE/D-Bus locks & sockets from any interrupted prior session (preserving .linuxdroid-svc-v3-* cache)
rm -rf /tmp/.ICE-unix /tmp/.X11-unix /tmp/.X*-lock /tmp/dbus-* /tmp/.linuxdroid-svc-v2-* 2>/dev/null || true
mkdir -p /tmp/.X11-unix /tmp/.ICE-unix /dev/shm
chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix /dev/shm 2>/dev/null || true

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/linuxdroid}"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
find "$XDG_RUNTIME_DIR" -mindepth 1 -maxdepth 1 \
  ! -name 'wayland-0*' \
  ! -name 'keymap.xkb' \
  ! -name 'pulse*' \
  ! -name 'gvfs*' \
  ! -name 'virgl*' \
  ! -name 'root*' \
  -exec rm -rf {} + 2>/dev/null || true

export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_DIRS="$XDG_DATA_HOME/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export MESA_SHADER_CACHE_DIR="${MESA_SHADER_CACHE_DIR:-$XDG_CACHE_HOME/mesa_shader_cache}"
export ICEAUTHORITY="$XDG_RUNTIME_DIR/ICEauthority"
mkdir -p "$HOME" "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$MESA_SHADER_CACHE_DIR"
rm -f "$HOME/.ICEauthority-c" "$HOME/.ICEauthority-l" "$HOME/.Xauthority-c" "$HOME/.Xauthority-l" \
      "$ICEAUTHORITY" "${ICEAUTHORITY}-c" "${ICEAUTHORITY}-l" 2>/dev/null || true

skel_done="$XDG_DATA_HOME/linuxdroid/skel-initialized"
if [ -d /etc/skel ] && [ ! -e "$skel_done" ]; then
  cp -rn /etc/skel/. "$HOME/" 2>/dev/null || true
  mkdir -p "${skel_done%/*}" && : > "$skel_done"
fi
[ -e "$HOME/.sudo_as_admin_successful" ] || : > "$HOME/.sudo_as_admin_successful" 2>/dev/null || true

if [ -d /sdcard ]; then
  ln -sfn /sdcard "$HOME/Android" 2>/dev/null || true
fi

if [ -d /mnt/linuxdroid ] && [ "$(ls -A /mnt/linuxdroid 2>/dev/null)" ]; then
  mkdir -p "$HOME/Mounts"
  for m in /mnt/linuxdroid/*; do
    [ -e "$m" ] || continue
    ln -sfn "$m" "$HOME/Mounts/$(basename "$m")" 2>/dev/null || true
  done
fi

/usr/local/bin/linuxdroid-bookmarks 2>/dev/null || true
/usr/local/bin/linuxdroid-default-browser 2>/dev/null || true

if [ -r /etc/linuxdroid/gpu.env ]; then
  set -a
  # shellcheck disable=SC1091
  . /etc/linuxdroid/gpu.env
  set +a
  unset MESA_NO_ERROR
  if [ "${LINUXDROID_GPU_ACTIVE:-}" = "turnip" ]; then
    unset MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE ZINK_DESCRIPTORS
    export TU_DEBUG="${TU_DEBUG:-noconform,sysmem}"
    export LIBGL_KOPPER_DRI2=true
    export MESA_VK_WSI_DEBUG=sw
    export MESA_VK_WSI_PRESENT_MODE=mailbox
    export QT_WAYLAND_FORCE_NONBLOCKING_SWAP_SUPPORT=1
  fi
  if [ "${BL_GPU_DESKTOP:-0}" = "1" ]; then
    rm -f "$XDG_CACHE_HOME/linuxdroid/gpu-desktop-failed" 2>/dev/null || true
  fi
  if [ -n "${VK_DRIVER_FILES:-}" ]; then
    resolved_icds=""
    IFS=':' read -ra icd_entries <<< "$VK_DRIVER_FILES"
    for icd_path in "${icd_entries[@]}"; do
      if [ ! -f "$icd_path" ]; then
        alt_path="${icd_path/.aarch64.json/.json}"
        [ -f "$alt_path" ] && icd_path="$alt_path"
      fi
      resolved_icds="${resolved_icds:+$resolved_icds:}$icd_path"
    done
    export VK_DRIVER_FILES="$resolved_icds"
    export VK_ICD_FILENAMES="$resolved_icds"
  fi
  echo "== gpu mode: ${LINUXDROID_GPU_MODE:-auto} (${LINUXDROID_GPU_SUMMARY:-default})"
  if [ -x /usr/local/bin/linuxdroid-gpu-diag ]; then
    /usr/local/bin/linuxdroid-gpu-diag >/dev/null 2>&1 &
  fi
  if [ -x /usr/local/bin/linuxdroid-gpu-test ]; then
    ( sleep 8; /usr/local/bin/linuxdroid-gpu-test >/dev/null 2>&1 ) &
  fi
fi

start_system_bus() {
  command -v dbus-daemon >/dev/null 2>&1 || return 0
  mkdir -p /tmp/linuxdroid-dbus
  cat > /tmp/linuxdroid-dbus/system.conf <<'BUSCONF'
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>system</type>
  <listen>unix:path=/run/dbus/system_bus_socket</listen>
  <auth>EXTERNAL</auth>
  <auth>ANONYMOUS</auth>
  <allow_anonymous/>
  <policy context="default">
    <allow user="*"/>
    <allow own="*"/>
    <allow send_destination="*"/>
    <allow receive_sender="*"/>
  </policy>
</busconfig>
BUSCONF
  linuxdroid-root mkdir -p /run/dbus /run/flatpak 2>/dev/null || mkdir -p /run/dbus /run/flatpak 2>/dev/null || true
  linuxdroid-root chmod 777 /run/dbus /run/flatpak 2>/dev/null || chmod 777 /run/dbus /run/flatpak 2>/dev/null || true
  local uid_now gid_now
  uid_now="$(id -u 2>/dev/null || echo 1000)"
  gid_now="$(id -g 2>/dev/null || echo 1000)"
  if [ ! -w "/run/user/$uid_now" ]; then
    mkdir -p "/run/user/$uid_now" 2>/dev/null || {
      linuxdroid-root mkdir -p "/run/user/$uid_now" 2>/dev/null || true
      linuxdroid-root chown "$uid_now:$gid_now" "/run/user/$uid_now" 2>/dev/null || true
      linuxdroid-root chmod 700 "/run/user/$uid_now" 2>/dev/null || true
    }
  fi
  rm -f /run/dbus/system_bus_socket 2>/dev/null || linuxdroid-root rm -f /run/dbus/system_bus_socket 2>/dev/null || true
  dbus-daemon --config-file=/tmp/linuxdroid-dbus/system.conf --nofork --nopidfile >/dev/null 2>&1 &
  for _ in $(seq 1 40); do
    [ -S /run/dbus/system_bus_socket ] && break
    sleep 0.05
  done
  if [ -S /run/dbus/system_bus_socket ] && [ -x /usr/local/bin/linuxdroid-systembus ]; then
    DBUS_SYSTEM_BUS_ADDRESS="unix:path=/run/dbus/system_bus_socket" /usr/local/bin/linuxdroid-systembus >/dev/null 2>&1 &
  fi
}
start_system_bus

wl_sock="$XDG_RUNTIME_DIR/${WAYLAND_DISPLAY:-wayland-0}"
for _ in $(seq 1 100); do
  [ -S "$wl_sock" ] && break
  sleep 0.05
done

if [ ! -S "$wl_sock" ]; then
  echo "ERROR: Android Wayland compositor socket not found at $wl_sock"
  exit 2
fi

exec /usr/local/bin/linuxdroid-desktop "$@"
