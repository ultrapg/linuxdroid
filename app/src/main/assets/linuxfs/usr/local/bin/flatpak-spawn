#!/usr/bin/python3 -BE
import os
import sys

FLAGS_0 = {
    "--host",
    "--clear-env",
    "--watch-bus",
    "--expose-pids",
    "--share-pids",
    "--sandbox",
    "--no-network",
    "--latest-version",
    "-v",
    "--verbose",
}

FLAGS_1 = {
    "--env",
    "--unset-env",
    "--directory",
    "--forward-fd",
    "--sandbox-flag",
    "--sandbox-expose",
    "--sandbox-expose-ro",
    "--sandbox-expose-path",
    "--sandbox-expose-path-ro",
    "--sandbox-expose-fd",
    "--sandbox-expose-fd-ro",
    "--sandbox-a11y-own-name",
    "--usr-path",
    "--app-path",
}

PRESERVE_KEYS = (
    "LD_PRELOAD",
    "LINUXDROID_ROOT_SOCKET",
    "BL_DESKTOP",
    "HOME",
    "USER",
    "LOGNAME",
    "LANG",
    "LC_ALL",
    "TERM",
    "PULSE_SERVER",
    "XDG_RUNTIME_DIR",
    "DISPLAY",
    "WAYLAND_DISPLAY",
    "DBUS_SESSION_BUS_ADDRESS",
    "FLATPAK_BWRAP",
    "BL_HOST_DBUS_SESSION_BUS_ADDRESS",
    "BL_HOST_XDG_RUNTIME_DIR",
    "BL_HOST_WAYLAND_DISPLAY",
    "BL_HOST_DISPLAY",
)

SANDBOX_ONLY_ENV_KEYS = (
    "BL_FLATPAK_LD",
    "BL_FLATPAK_LIBPATH",
    "BL_FLATPAK_USR",
    "BL_FLATPAK_APP",
    "PYTHONHOME",
    "GDK_PIXBUF_MODULE_FILE",
    "GIO_EXTRA_MODULES",
)


def strip_sandbox_paths(key, keep_flatpak_exports=False):
    val = os.environ.get(key)
    if not val:
        return
    cleaned = []
    for p in val.split(":"):
        if not p:
            continue
        if keep_flatpak_exports and p.endswith("/flatpak/exports/share"):
            cleaned.append(p)
            continue
        if p.startswith(("/app/", "/app", "/tmp/.bwrap-rt-lib", "/var/lib/flatpak/")):
            continue
        if "/.local/share/flatpak/" in p:
            continue
        cleaned.append(p)
    if cleaned:
        os.environ[key] = ":".join(cleaned)
    else:
        os.environ.pop(key, None)


def main(argv):
    args = argv[1:]
    for a in args:
        if a == "--":
            break
        if a in ("-h", "--help"):
            print("Usage: flatpak-spawn [OPTION…] COMMAND [ARGUMENT…]")
            return 0
        if a == "--version":
            print("flatpak-spawn 1.14.6")
            return 0

    env_updates = {}
    env_unsets = []
    clear_env = False
    is_host = False
    workdir = None

    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            i += 1
            break
        if a in FLAGS_0:
            if a == "--clear-env":
                clear_env = True
            elif a == "--host":
                is_host = True
            i += 1
            continue
        matched_eq = False
        for prefix in FLAGS_1:
            if a.startswith(prefix + "="):
                val = a[len(prefix) + 1 :]
                if prefix == "--env" and "=" in val:
                    k, v = val.split("=", 1)
                    env_updates[k] = v
                elif prefix == "--unset-env":
                    env_unsets.append(val)
                elif prefix == "--directory":
                    workdir = val
                matched_eq = True
                break
        if matched_eq:
            i += 1
            continue
        if a in FLAGS_1 and i + 1 < len(args):
            val = args[i + 1]
            if a == "--env" and "=" in val:
                k, v = val.split("=", 1)
                env_updates[k] = v
            elif a == "--unset-env":
                env_unsets.append(val)
            elif a == "--directory":
                workdir = val
            i += 2
            continue
        if a.startswith("-"):
            i += 1
            continue
        break

    cmd = args[i:]
    if not cmd:
        print("flatpak-spawn: No command specified", file=sys.stderr)
        return 1

    if clear_env:
        keep_keys = list(PRESERVE_KEYS)
        if not is_host:
            keep_keys.extend(SANDBOX_ONLY_ENV_KEYS)
            keep_keys.append("PATH")
        preserved = {k: os.environ[k] for k in keep_keys if k in os.environ}
        os.environ.clear()
        os.environ.update(preserved)

    if is_host:
        for k in SANDBOX_ONLY_ENV_KEYS:
            os.environ.pop(k, None)
        for k in (
            "LD_LIBRARY_PATH",
            "GI_TYPELIB_PATH",
            "PYTHONPATH",
            "LIBGL_DRIVERS_PATH",
            "__EGL_VENDOR_LIBRARY_DIRS",
            "GST_PLUGIN_SYSTEM_PATH_1_0",
            "QT_PLUGIN_PATH",
            "QML2_IMPORT_PATH",
        ):
            strip_sandbox_paths(k)
        strip_sandbox_paths("XDG_DATA_DIRS", keep_flatpak_exports=True)
        for saved_k, real_k in (
            ("BL_HOST_DBUS_SESSION_BUS_ADDRESS", "DBUS_SESSION_BUS_ADDRESS"),
            ("BL_HOST_XDG_RUNTIME_DIR", "XDG_RUNTIME_DIR"),
            ("BL_HOST_WAYLAND_DISPLAY", "WAYLAND_DISPLAY"),
            ("BL_HOST_DISPLAY", "DISPLAY"),
        ):
            saved_val = os.environ.pop(saved_k, None)
            if saved_val:
                os.environ[real_k] = saved_val
        os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    elif "PATH" not in os.environ:
        os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

    for k in env_unsets:
        if k != "LINUXDROID_ROOT_SOCKET":
            os.environ.pop(k, None)
    for k, v in env_updates.items():
        os.environ[k] = v

    if workdir and os.path.isdir(workdir):
        try:
            os.chdir(workdir)
        except OSError:
            pass

    try:
        os.execvp(cmd[0], cmd)
    except FileNotFoundError:
        print(f"flatpak-spawn: {cmd[0]}: command not found", file=sys.stderr)
        return 127
    except OSError as e:
        print(f"flatpak-spawn: {cmd[0]}: {e.strerror or e}", file=sys.stderr)
        return 126


if __name__ == "__main__":
    sys.exit(main(sys.argv))
