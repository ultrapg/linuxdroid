NEVER_SYMLINK_PREFIXES = (
    "libc.so",
    "ld-linux",
    "libm.so",
    "libpthread.so",
    "libdl.so",
    "librt.so",
    "libresolv.so",
    "libnss_",
    "libnsl.so",
    "libutil.so",
