#!/usr/bin/python3 -BE
import glob
import os
import shutil
import subprocess
import sys

FLAGS_0 = {
    "--level-prefix",
    "--unshare-all",
    "--share-net",
    "--unshare-user",
    "--unshare-user-try",
    "--unshare-ipc",
    "--unshare-pid",
    "--unshare-net",
    "--unshare-uts",
    "--unshare-cgroup",
    "--unshare-cgroup-try",
    "--disable-userns",
    "--assert-userns-disabled",
    "--clearenv",
    "--new-session",
    "--die-with-parent",
    "--as-pid-1",
    "--not-a-security-boundary",
}

FLAGS_1 = {
    "--args",
    "--argv0",
    "--userns",
    "--userns2",
    "--pidns",
    "--uid",
    "--gid",
    "--hostname",
    "--chdir",
    "--unsetenv",
    "--lock-file",
    "--sync-fd",
    "--remount-ro",
    "--overlay-src",
    "--tmp-overlay",
    "--ro-overlay",
    "--exec-label",
    "--file-label",
    "--proc",
    "--dev",
    "--tmpfs",
    "--mqueue",
    "--dir",
    "--seccomp",
    "--add-seccomp-fd",
    "--block-fd",
    "--userns-block-fd",
    "--info-fd",
    "--json-status-fd",
    "--cap-add",
    "--cap-drop",
    "--perms",
    "--size",
}

FLAGS_2 = {
    "--setenv",
    "--bind",
    "--bind-try",
    "--dev-bind",
    "--dev-bind-try",
    "--ro-bind",
    "--ro-bind-try",
    "--bind-fd",
    "--ro-bind-fd",
    "--file",
    "--bind-data",
    "--ro-bind-data",
    "--symlink",
    "--chmod",
}

FLAGS_3 = {
    "--overlay",
}

NEVER_SYMLINK_PREFIXES = (
    "libc.so",
    "ld-linux",
    "libm.so",
    "libpthread.so",
    "libdl.so",
    "librt.so",
    "libresolv.so",
    "libnss_",
    "libnsl.so",
    "libutil.so",
    "libBrokenLocale.so",
    "libanl.so",
    "libgcc_s.so",
    "libstdc++.so",
)


def read_args_fd(fd_str):
    try:
        fd = int(fd_str)
        data = b""
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            data += chunk
        os.close(fd)
        parts = [p.decode("utf-8", errors="surrogateescape") for p in data.split(b"\0")]
        if parts and parts[-1] == "":
            parts.pop()
        return parts
    except (OSError, ValueError):
        return []


def expand_args(raw_args):
    expanded = []
    i = 0
    while i < len(raw_args):
        a = raw_args[i]
        if a == "--":
            expanded.extend(raw_args[i:])
            break
        if a == "--args" and i + 1 < len(raw_args):
            expanded.extend(expand_args(read_args_fd(raw_args[i + 1])))
            i += 2
            continue
        expanded.append(a)
        i += 1
    return expanded


def copy_fd_to_dest(fd_str, dest):
    try:
        fd = int(fd_str)
        data = b""
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            data += chunk
        os.close(fd)
    except (OSError, ValueError):
        return None

    if dest == "/etc/ld.so.conf":
        staged_conf = f"/tmp/.bwrap-ld-so-conf-{os.getpid()}"
        try:
            with open(staged_conf, "wb") as f:
                f.write(data)
            return staged_conf
        except OSError:
            return None

    home_dir = os.environ.get("HOME") or "/home/linux"
    allowed_prefixes = ("/tmp/", "/run/", "/var/tmp/", home_dir.rstrip("/") + "/")
    if not dest.startswith(allowed_prefixes):
        return None

    try:
        parent = os.path.dirname(dest)
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(dest, "wb") as f:
            f.write(data)
        return dest
    except OSError:
        return None


def prepend_env_path(key, entries, default_existing=""):
    raw = os.environ.get(key, "") or default_existing
    cur = [p for p in raw.split(":") if p]
    for e in reversed(entries):
        if e and os.path.isdir(e):
            if e in cur:
                cur.remove(e)
            cur.insert(0, e)
    if cur:
        os.environ[key] = ":".join(cur)


def append_env_path(key, entries, default_existing=""):
    raw = os.environ.get(key, "") or default_existing
    cur = [p for p in raw.split(":") if p]
    for e in entries:
        if e and os.path.isdir(e) and e not in cur:
            cur.append(e)
    if cur:
        os.environ[key] = ":".join(cur)


def build_filtered_runtime_libdir(usr_src):
    rt_lib_dir = f"/tmp/.bwrap-rt-lib-{os.getuid()}"
    try:
        os.makedirs(rt_lib_dir, exist_ok=True)
    except OSError:
        return None

    host_lib_dirs = (
        "/usr/lib/aarch64-linux-gnu",
        "/lib/aarch64-linux-gnu",
        "/usr/lib64",
        "/lib64",
        "/usr/lib",
        "/lib",
    )
    candidate_dirs = (
        os.path.join(usr_src, "lib", "aarch64-linux-gnu"),
        os.path.join(usr_src, "lib64"),
        os.path.join(usr_src, "lib"),
    )
    for src_dir in candidate_dirs:
        if not os.path.isdir(src_dir):
            continue
        try:
            names = os.listdir(src_dir)
        except OSError:
            continue
        for name in names:
            if ".so" not in name:
                continue
            if name.startswith(NEVER_SYMLINK_PREFIXES):
                continue
            if any(os.path.exists(os.path.join(hd, name)) for hd in host_lib_dirs):
                continue
            src_file = os.path.join(src_dir, name)
            dst_link = os.path.join(rt_lib_dir, name)
            try:
                if os.path.lexists(dst_link):
                    os.unlink(dst_link)
                os.symlink(src_file, dst_link)
            except OSError:
                pass
    return rt_lib_dir


def find_runtime_ld_linux(usr_src):
    if not usr_src:
        return None
    for rel in (
        ("lib", "aarch64-linux-gnu", "ld-linux-aarch64.so.1"),
        ("lib64", "ld-linux-aarch64.so.1"),
        ("lib", "ld-linux-aarch64.so.1"),
    ):
        cand = os.path.join(usr_src, *rel)
        if os.path.isfile(cand):
            return cand
    return None


def map_sandbox_virtual_path(vpath, app_src, usr_src, runtime_ext_dirs):
    if not vpath:
        return vpath
    for dst_prefix, src_prefix in sorted(runtime_ext_dirs, key=lambda kv: len(kv[0]), reverse=True):
        if vpath == dst_prefix:
            return src_prefix
        if vpath.startswith(dst_prefix + "/"):
            return src_prefix + vpath[len(dst_prefix) :]
    if app_src and (vpath == "/app" or vpath.startswith("/app/")):
        return app_src.rstrip("/") + vpath[4:]
    if usr_src and (vpath == "/usr" or vpath.startswith("/usr/")) and not vpath.startswith("/usr/local/"):
        return usr_src.rstrip("/") + vpath[4:]
    if usr_src and vpath.startswith("/bin/"):
        cand = os.path.join(usr_src, "bin", vpath[5:])
        if os.path.lexists(cand):
            return cand
    return vpath


def resolve_sandbox_file(raw_path, app_src, usr_src, runtime_ext_dirs):
    if not raw_path:
        return None
    cand = None
    if "/" not in raw_path:
        if raw_path == "flatpak-spawn" and os.path.exists("/usr/local/bin/flatpak-spawn"):
            cand = "/usr/local/bin/flatpak-spawn"
        if cand is None and app_src:
            p = os.path.join(app_src, "bin", raw_path)
            if os.path.lexists(p):
                cand = p
        if cand is None and usr_src:
            p = os.path.join(usr_src, "bin", raw_path)
            if os.path.lexists(p):
                cand = p
        if cand is None:
            cand = shutil.which(raw_path)
    else:
        mapped = map_sandbox_virtual_path(raw_path, app_src, usr_src, runtime_ext_dirs)
        cand = mapped if os.path.lexists(mapped) else raw_path

    if not cand:
        return None

    for _ in range(16):
        if not os.path.islink(cand):
            break
        try:
            target = os.readlink(cand)
        except OSError:
            break
        if target.startswith("/"):
            mapped = map_sandbox_virtual_path(target, app_src, usr_src, runtime_ext_dirs)
            cand = mapped if os.path.lexists(mapped) else target
        else:
            cand = os.path.normpath(os.path.join(os.path.dirname(cand), target))
    return cand


def build_runtime_library_path(app_src, usr_src, runtime_ext_dirs):
    raw_dirs = []
    if app_src:
        raw_dirs.extend(
            [
                os.path.join(app_src, "lib", "aarch64-linux-gnu"),
                os.path.join(app_src, "lib64"),
                os.path.join(app_src, "lib"),
            ]
        )
    for conf_file in sorted(glob.glob("/run/flatpak/ld.so.conf.d/*.conf")):
        try:
            with open(conf_file, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    s = line.strip()
                    if not s or s.startswith("#") or s.startswith("include "):
                        continue
                    raw_dirs.append(map_sandbox_virtual_path(s, app_src, usr_src, runtime_ext_dirs))
        except OSError:
            pass
    for _, ext_src in runtime_ext_dirs:
        raw_dirs.extend(
            [
                os.path.join(ext_src, "lib", "aarch64-linux-gnu"),
                os.path.join(ext_src, "lib64"),
                os.path.join(ext_src, "lib"),
            ]
        )
    if usr_src:
        raw_dirs.extend(
            [
                os.path.join(usr_src, "lib", "aarch64-linux-gnu"),
                os.path.join(usr_src, "lib64"),
                os.path.join(usr_src, "lib"),
            ]
        )
    seen = set()
    out = []
    for d in raw_dirs:
        if d and d not in seen and os.path.isdir(d):
            seen.add(d)
            out.append(d)
    return ":".join(out)


def prepare_relocated_pixbuf_cache(usr_src):
    if not usr_src:
        return None
    matches = glob.glob(os.path.join(usr_src, "lib", "*", "gdk-pixbuf-2.0", "*", "loaders.cache")) + glob.glob(
        os.path.join(usr_src, "lib*", "gdk-pixbuf-2.0", "*", "loaders.cache")
    )
    if not matches:
        return None
    src_cache = matches[0]
    try:
        with open(src_cache, "r", encoding="utf-8", errors="replace") as f:
            content = f.read()
        relocated = content.replace('"/usr/', f'"{usr_src.rstrip("/")}/')
        tag = f"{abs(hash(usr_src)) & 0xffffffff:08x}"
        out_cache = f"/tmp/.bwrap-pixbuf-{os.getuid()}-{tag}.cache"
        with open(out_cache, "w", encoding="utf-8") as f:
            f.write(relocated)
        return out_cache
    except OSError:
        return None


def is_flatpak_owned_path(path, app_src, usr_src):
    if not path or path.startswith("/usr/local/"):
        return False
    if app_src and path.startswith(app_src.rstrip("/") + "/"):
        return True
    if usr_src and path.startswith(usr_src.rstrip("/") + "/"):
        return True
    if path.startswith("/var/lib/flatpak/") or "/.local/share/flatpak/" in path:
        return True
    return False


def read_file_header(path, nbytes=256):
    try:
        with open(path, "rb") as f:
            return f.read(nbytes)
    except OSError:
        return b""


def main(argv):
    for a in argv[1:]:
        if a == "--":
            break
        if a == "--version":
            print("bubblewrap 0.11.0")
            return 0
        if a == "--help":
            print("usage: bwrap [OPTIONS...] [--] COMMAND [ARGS...]")
            return 0

    keep_root_sock = os.environ.get("LINUXDROID_ROOT_SOCKET")
    saved_host_env = {}
    for real_k, saved_k in (
        ("DBUS_SESSION_BUS_ADDRESS", "BL_HOST_DBUS_SESSION_BUS_ADDRESS"),
        ("XDG_RUNTIME_DIR", "BL_HOST_XDG_RUNTIME_DIR"),
        ("WAYLAND_DISPLAY", "BL_HOST_WAYLAND_DISPLAY"),
        ("DISPLAY", "BL_HOST_DISPLAY"),
    ):
        val = os.environ.get(saved_k) or os.environ.get(real_k)
        if val:
            saved_host_env[saved_k] = val

    args = expand_args(argv[1:])
    chdir_path = None
    argv0 = None
    info_fds = []
    block_fds = []
    close_fds = []
    app_src = None
    usr_src = None
    runtime_ext_dirs = []
    staged_ld_conf = None
    ephemeral_binds = {}

    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            i += 1
            break
        if a in FLAGS_0:
            if a == "--clearenv":
                keep_preload = os.environ.get("LD_PRELOAD")
                os.environ.clear()
                os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
                if keep_preload:
                    os.environ["LD_PRELOAD"] = keep_preload
                if keep_root_sock:
                    os.environ["LINUXDROID_ROOT_SOCKET"] = keep_root_sock
            i += 1
        elif a in FLAGS_1 and i + 1 < len(args):
            val = args[i + 1]
            if a == "--chdir":
                chdir_path = val
            elif a == "--argv0":
                argv0 = val
            elif a == "--unsetenv":
                if val != "LINUXDROID_ROOT_SOCKET":
                    os.environ.pop(val, None)
            elif a == "--dir":
                try:
                    os.makedirs(val, exist_ok=True)
                except OSError:
                    pass
            elif a in ("--info-fd", "--json-status-fd"):
                info_fds.append(val)
            elif a in ("--block-fd", "--userns-block-fd"):
                block_fds.append(val)
            elif a in ("--seccomp", "--add-seccomp-fd"):
                close_fds.append(val)
            i += 2
        elif a in FLAGS_2 and i + 2 < len(args):
            v1, v2 = args[i + 1], args[i + 2]
            if a == "--setenv":
                os.environ[v1] = v2
            elif a in ("--file", "--bind-data", "--ro-bind-data"):
                out_path = copy_fd_to_dest(v1, v2)
                if v2 == "/etc/ld.so.conf" and out_path:
                    staged_ld_conf = out_path
            elif a in ("--bind", "--bind-try", "--ro-bind", "--ro-bind-try", "--dev-bind", "--dev-bind-try"):
                if v2 == "/app" and v1 != "/app" and os.path.isdir(v1):
                    app_src = v1
                elif v2 == "/usr" and v1 != "/usr" and os.path.isdir(v1):
                    usr_src = v1
                elif v2.startswith(("/usr/", "/app/")) and v1 != v2 and os.path.isdir(v1):
                    runtime_ext_dirs.append((v2.rstrip("/"), v1.rstrip("/")))
                elif v2.startswith(("/tmp/", "/run/", "/var/tmp/")) and v1 != v2 and os.path.exists(v1):
                    ephemeral_binds[v2.rstrip("/")] = v1.rstrip("/")
                    try:
                        parent = os.path.dirname(v2)
                        if parent:
                            os.makedirs(parent, exist_ok=True)
                        if os.path.islink(v2) or not os.path.exists(v2) or not os.path.isdir(v2):
                            if os.path.lexists(v2) and not os.path.isdir(v2):
                                os.unlink(v2)
                            if not os.path.lexists(v2):
                                os.symlink(v1, v2)
                    except OSError:
                        pass
            elif a == "--symlink":
                try:
                    if v2.startswith(("/tmp/", "/run/", "/var/tmp/")):
                        parent = os.path.dirname(v2)
                        if parent:
                            os.makedirs(parent, exist_ok=True)
                        if os.path.lexists(v2):
                            os.unlink(v2)
                        os.symlink(v1, v2)
                except OSError:
                    pass
            i += 3
        elif a in FLAGS_3 and i + 3 < len(args):
            i += 4
        elif a.startswith("-"):
            i += 1
        else:
            break

    cmd = args[i:]
    if not cmd:
        print("bwrap: No command specified", file=sys.stderr)
        return 1

    if ephemeral_binds:
        remapped_cmd = []
        for token in cmd:
            for dst_prefix, src_prefix in ephemeral_binds.items():
                if token == dst_prefix:
                    token = src_prefix
                    break
                if token.startswith(dst_prefix + "/"):
                    token = src_prefix + token[len(dst_prefix) :]
                    break
            remapped_cmd.append(token)
        cmd = remapped_cmd

    is_ldconfig = os.path.basename(cmd[0]) == "ldconfig"
    if is_ldconfig and staged_ld_conf and "-f" not in cmd:
        cmd = [cmd[0], "-f", staged_ld_conf] + cmd[1:]

    for fd_str in close_fds:
        try:
            os.close(int(fd_str))
        except (OSError, ValueError):
            pass

    if keep_root_sock and "LINUXDROID_ROOT_SOCKET" not in os.environ:
        os.environ["LINUXDROID_ROOT_SOCKET"] = keep_root_sock
    for saved_k, saved_v in saved_host_env.items():
        os.environ.setdefault(saved_k, saved_v)

    prepend_env_path("PATH", ["/usr/local/bin", "/usr/sbin", "/usr/bin", "/sbin", "/bin"])

    if app_src:
        try:
            if os.path.islink("/app") or not os.path.exists("/app"):
                if os.path.islink("/app"):
                    os.unlink("/app")
                os.symlink(app_src, "/app")
        except OSError:
            subprocess.call(["/usr/local/bin/linuxdroid-root", "ln", "-sfn", app_src, "/app"])
        prepend_env_path("PATH", [os.path.join(app_src, "bin"), "/usr/local/bin"])
        prepend_env_path(
            "XDG_DATA_DIRS",
            [os.path.join(app_src, "share")],
            default_existing="/usr/local/share:/usr/share",
        )
        prepend_env_path(
            "GI_TYPELIB_PATH",
            [
                os.path.join(app_src, "lib", "aarch64-linux-gnu", "girepository-1.0"),
                os.path.join(app_src, "lib", "girepository-1.0"),
            ],
        )
        py_app_dirs = (
            glob.glob(os.path.join(app_src, "lib", "python*", "site-packages"))
            + glob.glob(os.path.join(app_src, "lib", "python*", "dist-packages"))
            + [os.path.join(app_src, "share")]
        )
        prepend_env_path("PYTHONPATH", py_app_dirs)
        if cmd[0].startswith("/app/"):
            candidate = os.path.join(app_src, cmd[0][len("/app/") :])
            if os.path.exists(candidate):
                cmd[0] = candidate

    rt_ld_linux = find_runtime_ld_linux(usr_src) if (usr_src and not is_ldconfig) else None
    rt_lib_path = ""

    if usr_src and not is_ldconfig:
        append_env_path("PATH", [os.path.join(usr_src, "bin")])
        prepend_env_path(
            "XDG_DATA_DIRS",
            ([os.path.join(app_src, "share")] if app_src else []) + [os.path.join(usr_src, "share")],
            default_existing="/usr/local/share:/usr/share",
        )
        typelib_dirs = []
        if app_src:
            typelib_dirs.extend(
                [
                    os.path.join(app_src, "lib", "aarch64-linux-gnu", "girepository-1.0"),
                    os.path.join(app_src, "lib", "girepository-1.0"),
                ]
            )
        typelib_dirs.extend(
            [
                os.path.join(usr_src, "lib", "aarch64-linux-gnu", "girepository-1.0"),
                os.path.join(usr_src, "lib", "girepository-1.0"),
            ]
        )
        existing_typelibs = [d for d in typelib_dirs if os.path.isdir(d)]
        if existing_typelibs:
            os.environ["GI_TYPELIB_PATH"] = ":".join(existing_typelibs)

        pixbuf_cache = prepare_relocated_pixbuf_cache(usr_src)
        if pixbuf_cache:
            os.environ["GDK_PIXBUF_MODULE_FILE"] = pixbuf_cache

        gio_mods = os.path.join(usr_src, "lib", "aarch64-linux-gnu", "gio", "modules")
        if os.path.isdir(gio_mods):
            os.environ["GIO_EXTRA_MODULES"] = gio_mods

        gst_dirs = []
        if app_src:
            gst_dirs.append(os.path.join(app_src, "lib", "aarch64-linux-gnu", "gstreamer-1.0"))
        gst_dirs.append(os.path.join(usr_src, "lib", "aarch64-linux-gnu", "gstreamer-1.0"))
        prepend_env_path("GST_PLUGIN_SYSTEM_PATH_1_0", gst_dirs)

        qt_plugin_dirs = []
        if app_src:
            qt_plugin_dirs.append(os.path.join(app_src, "lib", "plugins"))
        qt_plugin_dirs.extend(
            [
                os.path.join(usr_src, "lib", "plugins"),
                os.path.join(usr_src, "lib", "aarch64-linux-gnu", "plugins"),
            ]
        )
        prepend_env_path("QT_PLUGIN_PATH", qt_plugin_dirs)

        qml_dirs = []
        if app_src:
            qml_dirs.append(os.path.join(app_src, "lib", "qml"))
        qml_dirs.extend(
            [
                os.path.join(usr_src, "lib", "qml"),
                os.path.join(usr_src, "lib", "aarch64-linux-gnu", "qml"),
            ]
        )
        prepend_env_path("QML2_IMPORT_PATH", qml_dirs)

        dri_dirs = []
        egl_vendor_dirs = []
        for _, ext_src in runtime_ext_dirs:
            dri_dirs.extend(
                [
                    os.path.join(ext_src, "lib", "dri"),
                    os.path.join(ext_src, "lib", "aarch64-linux-gnu", "dri"),
                ]
            )
            egl_vendor_dirs.append(os.path.join(ext_src, "share", "glvnd", "egl_vendor.d"))
        egl_vendor_dirs.append(os.path.join(usr_src, "share", "glvnd", "egl_vendor.d"))
        prepend_env_path("LIBGL_DRIVERS_PATH", dri_dirs)
        prepend_env_path("__EGL_VENDOR_LIBRARY_DIRS", egl_vendor_dirs)

        if rt_ld_linux:
            rt_lib_path = build_runtime_library_path(app_src, usr_src, runtime_ext_dirs)
            os.environ["BL_FLATPAK_LD"] = rt_ld_linux
            os.environ["BL_FLATPAK_LIBPATH"] = rt_lib_path
            os.environ["BL_FLATPAK_USR"] = usr_src
            if app_src:
                os.environ["BL_FLATPAK_APP"] = app_src
        else:
            if app_src:
                prepend_env_path(
                    "LD_LIBRARY_PATH",
                    [
                        os.path.join(app_src, "lib", "aarch64-linux-gnu"),
                        os.path.join(app_src, "lib64"),
                        os.path.join(app_src, "lib"),
                    ],
                )
            rt_libdir = build_filtered_runtime_libdir(usr_src)
            if rt_libdir:
                append_env_path("LD_LIBRARY_PATH", [rt_libdir])

    for fd_str in info_fds:
        try:
            fd = int(fd_str)
            os.write(fd, f'{{"child-pid": {os.getpid()}}}\n'.encode())
            os.close(fd)
        except (OSError, ValueError):
            pass

    for fd_str in block_fds:
        try:
            fd = int(fd_str)
            os.read(fd, 1)
            os.close(fd)
        except (OSError, ValueError):
            pass

    if chdir_path and os.path.isdir(chdir_path):
        try:
            os.chdir(chdir_path)
        except OSError:
            pass

    if rt_ld_linux:
        exe_path = resolve_sandbox_file(cmd[0], app_src, usr_src, runtime_ext_dirs)
        for _ in range(4):
            if not exe_path or exe_path.startswith("/usr/local/") or not os.path.isfile(exe_path):
                break
            head = read_file_header(exe_path, 256)
            if not head.startswith(b"#!"):
                break
            shebang = head[2:].splitlines()[0].decode("utf-8", errors="replace").strip()
            parts = shebang.split(None, 1)
            if not parts:
                break
            interp = parts[0]
            rest = parts[1].strip() if len(parts) > 1 else ""
            script_arg = exe_path
            if os.path.basename(interp) == "env":
                tokens = rest.split()
                idx = 0
                while idx < len(tokens) and (tokens[idx] == "-S" or "=" in tokens[idx]):
                    if "=" in tokens[idx]:
                        ek, ev = tokens[idx].split("=", 1)
                        os.environ[ek] = ev
                    idx += 1
                if idx >= len(tokens):
                    break
                resolved_tool = resolve_sandbox_file(tokens[idx], app_src, usr_src, runtime_ext_dirs)
                if not resolved_tool:
                    break
                cmd = [resolved_tool] + tokens[idx + 1 :] + [script_arg] + cmd[1:]
                exe_path = resolved_tool
                argv0 = None
            else:
                resolved_interp = resolve_sandbox_file(interp, app_src, usr_src, runtime_ext_dirs)
                if not resolved_interp:
                    break
                cmd = [resolved_interp] + ([rest] if rest else []) + [script_arg] + cmd[1:]
                exe_path = resolved_interp
                argv0 = None

        if exe_path and exe_path != rt_ld_linux and is_flatpak_owned_path(exe_path, app_src, usr_src):
            head = read_file_header(exe_path, 8)
            if head.startswith(b"\x7fELF"):
                if usr_src and os.path.basename(exe_path).startswith("python3") and exe_path.startswith(usr_src.rstrip("/") + "/"):
                    os.environ["PYTHONHOME"] = usr_src
                effective_argv0 = argv0 if argv0 is not None else cmd[0]
                ld_args = [rt_ld_linux, "--inhibit-cache", "--argv0", effective_argv0]
                if rt_lib_path:
                    ld_args.extend(["--library-path", rt_lib_path])
                ld_args.append(exe_path)
                ld_args.extend(cmd[1:])
                os.execv(rt_ld_linux, ld_args)

    exec_args = [argv0 if argv0 is not None else cmd[0]] + cmd[1:]
    try:
        os.execvp(cmd[0], exec_args)
    except FileNotFoundError:
        print(f"bwrap: execvp {cmd[0]}: No such file or directory", file=sys.stderr)
        return 127
    except OSError as e:
        print(f"bwrap: execvp {cmd[0]}: {e.strerror or e}", file=sys.stderr)
        return 126


if __name__ == "__main__":
    sys.exit(main(sys.argv))
