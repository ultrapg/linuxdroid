#!/bin/bash
# LinuxDroid plasmashell wrapper: ensures KDE Plasma's desktop wallpaper and bottom taskbar panel
# render reliably via native Wayland SHM buffers into KWin's nested Wayland compositor (wayland-1),
# while LinuxDroid's host Vulkan compositor and GPU-accelerated applications (Turnip + Zink + Kopper)
# handle hardware GPU acceleration without Wayland EGL / Mesa Kopper event-queue conflicts.
set -u

REAL_PLASMASHELL=""
for candidate in /usr/lib/linuxdroid/plasmashell.real /usr/bin/plasmashell.distrib /usr/bin/plasmashell; do
  if [ -x "$candidate" ] && ! grep -q "^# LinuxDroid plasmashell" "$candidate" 2>/dev/null; then
    REAL_PLASMASHELL="$candidate"
    break
  fi
done
if [ -z "$REAL_PLASMASHELL" ]; then
  echo "linuxdroid plasmashell wrapper: real plasmashell binary not found" >&2
  exit 127
fi

export QT_QUICK_BACKEND=software
export QSG_RENDER_LOOP=basic
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe
unset MESA_LOADER_DRIVER_OVERRIDE LIBGL_KOPPER_DRI2 MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE ZINK_DESCRIPTORS MESA_NO_ERROR

# Ensure plasmashell always attaches to nested KWin (wayland-1 / wayland-2) and never to the host
# compositor (wayland-0), which lacks org_kde_plasma_shell and would hide the panel behind KWin.
xdg_rt="${XDG_RUNTIME_DIR:-/run/linuxdroid}"
if [ "${WAYLAND_DISPLAY:-wayland-0}" = "wayland-0" ] || [ ! -S "$xdg_rt/${WAYLAND_DISPLAY:-wayland-1}" ]; then
  for _ in $(seq 1 100); do
    if [ -S "$xdg_rt/wayland-1" ]; then
      export WAYLAND_DISPLAY="wayland-1"
      break
    elif [ -S "$xdg_rt/wayland-2" ]; then
      export WAYLAND_DISPLAY="wayland-2"
      break
    fi
    sleep 0.1
  done
  if [ "${WAYLAND_DISPLAY:-wayland-0}" = "wayland-0" ]; then
    export WAYLAND_DISPLAY="wayland-1"
  fi
fi

exec "$REAL_PLASMASHELL" "$@"
