#!/bin/bash
# LinuxDroid GPU Diagnostics: probes DRM/KGSL/Mali nodes, sysfs uevents, Vulkan ICDs,
# Mesa/EGL/GBM/GL libraries, render node resolution, and active desktop/app GPU fallback flags.
set -u

CACHE_DIR="${XDG_CACHE_HOME:-${HOME:-/home/linux}/.cache}/linuxdroid"
mkdir -p "$CACHE_DIR" 2>/dev/null || true
OUT_FILE="$CACHE_DIR/gpu-diag.txt"

if [ -r /etc/linuxdroid/gpu.env ]; then
  set -a
  # shellcheck disable=SC1091
  . /etc/linuxdroid/gpu.env
  set +a
fi

{
  echo "=== LinuxDroid GPU Diagnostics ($(date -u '+%Y-%m-%d %H:%M:%S UTC')) ==="
  echo "USER=${USER:-$(id -un 2>/dev/null || echo linux)} UID=$(id -u 2>/dev/null || echo 1000) GIDS=$(id -G 2>/dev/null || true)"
  echo "UNAME=$(uname -a 2>/dev/null || true)"
  echo "GPU_MODE=${LINUXDROID_GPU_MODE:-auto}"
  echo "GPU_ACTIVE=${LINUXDROID_GPU_ACTIVE:-unknown}"
  echo "GPU_FAMILY=${LINUXDROID_GPU_FAMILY:-unknown}"
  echo "GPU_SUMMARY=${LINUXDROID_GPU_SUMMARY:-none}"
  echo "BL_GPU_APPS=${BL_GPU_APPS:-0} BL_GPU_DESKTOP=${BL_GPU_DESKTOP:-0}"
  echo "VK_DRIVER_FILES=${VK_DRIVER_FILES:-unset}"
  echo "VK_ICD_FILENAMES=${VK_ICD_FILENAMES:-unset}"
  echo "GALLIUM_DRIVER=${GALLIUM_DRIVER:-unset} MESA_LOADER_DRIVER_OVERRIDE=${MESA_LOADER_DRIVER_OVERRIDE:-unset}"
  echo "ZINK_DESCRIPTORS=${ZINK_DESCRIPTORS:-unset} LIBGL_KOPPER_DRI2=${LIBGL_KOPPER_DRI2:-unset}"
  echo "TU_DEBUG=${TU_DEBUG:-unset} MESA_VK_WSI_DEBUG=${MESA_VK_WSI_DEBUG:-unset} VN_DEBUG=${VN_DEBUG:-unset}"
  echo "VTEST_SOCKET_NAME=${VTEST_SOCKET_NAME:-unset}"
  echo "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset} DISPLAY=${DISPLAY:-unset} XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-unset}"

  echo "--- Runtime Sockets & Shared Memory ---"
  ls -la "${XDG_RUNTIME_DIR:-/run/linuxdroid}" /tmp/.X11-unix /dev/shm 2>/dev/null || true

  echo "--- Device Nodes ---"
  ls -la /dev/kgsl-3d0 /dev/mali0 /dev/dri /dev/dri/* /dev/ion /dev/dma_heap /dev/dma_heap/* /dev/ashmem 2>/dev/null || true

  echo "--- Sysfs DRM & Char Nodes ---"
  for uev in /sys/dev/char/*/uevent /sys/dev/char/*/device/uevent /sys/dev/char/*/device/drm/*/dev /sys/class/kgsl/kgsl-3d0/gpu_model /sys/class/kgsl/kgsl-3d0/gpubusy; do
    [ -r "$uev" ] || continue
    echo "[$uev]"
    cat "$uev" 2>/dev/null || true
  done

  echo "--- Vulkan ICD Files & Libraries ---"
  for icd in /usr/share/vulkan/icd.d/*.json /etc/vulkan/icd.d/*.json; do
    [ -r "$icd" ] || continue
    echo "[$icd]"
    cat "$icd" 2>/dev/null || true
  done
  ls -la /usr/lib/aarch64-linux-gnu/libvulkan* /usr/lib/aarch64-linux-gnu/libEGL* /usr/lib/aarch64-linux-gnu/libGL* /usr/lib/aarch64-linux-gnu/libgbm* /usr/lib/aarch64-linux-gnu/dri/* 2>/dev/null | head -n 45 || true

  echo "--- Mesa & Graphics Package Versions ---"
  if command -v dpkg-query >/dev/null 2>&1; then
    dpkg-query -W -f='${Package}=${Version} (${db:Status-Abbrev})\n' \
      mesa-vulkan-drivers libgl1-mesa-dri libegl-mesa0 libgbm1 libglx-mesa0 libdrm2 \
      kwin-wayland plasma-workspace xwayland chromium firefox blender 2>/dev/null || true
  fi

  echo "--- libdrm Render Node Resolution ---"
  python3 - <<'PY' 2>/dev/null || true
import ctypes, os, stat

class DrmDevice(ctypes.Structure):
    _fields_ = [
        ("nodes", ctypes.POINTER(ctypes.c_char_p)),
        ("available_nodes", ctypes.c_int),
        ("bustype", ctypes.c_int),
    ]

try:
    if os.path.exists("/usr/local/lib/libblsession.so"):
        try:
            ctypes.CDLL("/usr/local/lib/libblsession.so", mode=ctypes.RTLD_GLOBAL)
        except Exception:
            pass
    drm = ctypes.CDLL("libdrm.so.2")
    drm.drmGetDeviceFromDevId.argtypes = [ctypes.c_ulong, ctypes.c_uint, ctypes.POINTER(ctypes.POINTER(DrmDevice))]
    drm.drmGetDeviceFromDevId.restype = ctypes.c_int
    for label, path in [("devId=0 (nested wayland-1 fallback)", None), ("renderD128", "/dev/dri/renderD128"), ("kgsl-3d0", "/dev/kgsl-3d0"), ("mali0", "/dev/mali0")]:
        rdev = 0
        if path:
            if not os.path.exists(path):
                continue
            rdev = os.stat(path).st_rdev
        dev_ptr = ctypes.POINTER(DrmDevice)()
        rc = drm.drmGetDeviceFromDevId(rdev, 0, ctypes.byref(dev_ptr))
        node_str = "none"
        avail = 0
        if rc == 0 and bool(dev_ptr) and bool(dev_ptr.contents.nodes):
            avail = dev_ptr.contents.available_nodes
            for idx in (2, 0, 1):
                if avail & (1 << idx):
                    raw = dev_ptr.contents.nodes[idx]
                    if raw:
                        node_str = raw.decode("utf-8", "replace")
                        break
        print(f"drmGetDeviceFromDevId({label}, rdev={rdev}): rc={rc} avail=0x{avail:x} node={node_str}")
    if os.path.exists("/dev/dri/renderD128"):
        fd = os.open("/dev/dri/renderD128", os.O_RDWR | os.O_CLOEXEC)
        try:
            drm.drmGetNodeTypeFromFd.argtypes = [ctypes.c_int]
            drm.drmGetNodeTypeFromFd.restype = ctypes.c_int
            ntype = drm.drmGetNodeTypeFromFd(fd)
            class DrmVersion(ctypes.Structure):
                _fields_ = [
                    ("version_major", ctypes.c_int),
                    ("version_minor", ctypes.c_int),
                    ("version_patchlevel", ctypes.c_int),
                    ("name_len", ctypes.c_int),
                    ("name", ctypes.c_char_p),
                    ("date_len", ctypes.c_int),
                    ("date", ctypes.c_char_p),
                    ("desc_len", ctypes.c_int),
                    ("desc", ctypes.c_char_p),
                ]
            drm.drmGetVersion.argtypes = [ctypes.c_int]
            drm.drmGetVersion.restype = ctypes.POINTER(DrmVersion)
            drm.drmFreeVersion.argtypes = [ctypes.POINTER(DrmVersion)]
            vp = drm.drmGetVersion(fd)
            vname = vp.contents.name.decode("utf-8", "replace") if bool(vp) and vp.contents.name else "null"
            if bool(vp):
                drm.drmFreeVersion(vp)
            print(f"renderD128 fd probe: nodeType={ntype} drmVersionName={vname}")
        finally:
            os.close(fd)
except Exception as e:
    print(f"libdrm probe error: {e}")
PY

  echo "--- Direct Vulkan & EGL Library Probe ---"
  python3 - <<'PY' 2>/dev/null || true
import ctypes

try:
    vk = ctypes.CDLL("libvulkan.so.1")
    vk.vkCreateInstance.restype = ctypes.c_int
    vk.vkCreateInstance.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_void_p)]
    vk.vkEnumeratePhysicalDevices.restype = ctypes.c_int
    vk.vkEnumeratePhysicalDevices.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_uint32), ctypes.POINTER(ctypes.c_void_p)]
    vk.vkDestroyInstance.argtypes = [ctypes.c_void_p, ctypes.c_void_p]

    class VkInstanceCreateInfo(ctypes.Structure):
        _fields_ = [
            ("sType", ctypes.c_int),
            ("pNext", ctypes.c_void_p),
            ("flags", ctypes.c_uint32),
            ("pApplicationInfo", ctypes.c_void_p),
            ("enabledLayerCount", ctypes.c_uint32),
            ("ppEnabledLayerNames", ctypes.c_void_p),
            ("enabledExtensionCount", ctypes.c_uint32),
            ("ppEnabledExtensionNames", ctypes.c_void_p),
        ]

    info = VkInstanceCreateInfo(sType=1)
    inst = ctypes.c_void_p()
    rc = vk.vkCreateInstance(ctypes.byref(info), None, ctypes.byref(inst))
    if rc == 0 and inst.value:
        cnt = ctypes.c_uint32(0)
        rc_enum = vk.vkEnumeratePhysicalDevices(inst, ctypes.byref(cnt), None)
        print(f"Vulkan ctypes probe: vkCreateInstance=OK, physicalDevices={cnt.value} (rc={rc_enum})")
        vk.vkDestroyInstance(inst, None)
    else:
        print(f"Vulkan ctypes probe: vkCreateInstance failed (rc={rc})")
except Exception as e:
    print(f"Vulkan ctypes probe error: {e}")

try:
    egl = ctypes.CDLL("libEGL.so.1")
    egl.eglGetPlatformDisplay.argtypes = [ctypes.c_uint, ctypes.c_void_p, ctypes.c_void_p]
    egl.eglGetPlatformDisplay.restype = ctypes.c_void_p
    egl.eglGetDisplay.argtypes = [ctypes.c_void_p]
    egl.eglGetDisplay.restype = ctypes.c_void_p
    egl.eglInitialize.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int)]
    egl.eglInitialize.restype = ctypes.c_uint
    egl.eglQueryString.argtypes = [ctypes.c_void_p, ctypes.c_int]
    egl.eglQueryString.restype = ctypes.c_char_p
    egl.eglGetError.restype = ctypes.c_int
    dpy = egl.eglGetPlatformDisplay(0x31DD, None, None) or egl.eglGetDisplay(None)
    maj, mn = ctypes.c_int(0), ctypes.c_int(0)
    ok = egl.eglInitialize(dpy, ctypes.byref(maj), ctypes.byref(mn)) if dpy else 0
    if ok:
        vendor = (egl.eglQueryString(dpy, 0x3053) or b"").decode("utf-8", "replace")
        ver = (egl.eglQueryString(dpy, 0x3054) or b"").decode("utf-8", "replace")
        print(f"EGL surfaceless display: OK ({maj.value}.{mn.value}) vendor='{vendor}' version='{ver}'")
    else:
        print(f"EGL surfaceless display: init failed (dpy={dpy}, err=0x{egl.eglGetError():x})")
except Exception as e:
    print(f"EGL ctypes probe error: {e}")
PY

  if command -v vulkaninfo >/dev/null 2>&1; then
    echo "--- vulkaninfo --summary ---"
    timeout 6 vulkaninfo --summary 2>&1 | head -n 45 || true
  fi

  echo "--- Fallback Status & App Logs ---"
  if [ -e "$CACHE_DIR/gpu-desktop-failed" ]; then
    echo "gpu-desktop-failed: PRESENT ($(tr '\n' ' ' < "$CACHE_DIR/gpu-desktop-failed" 2>/dev/null))"
  else
    echo "gpu-desktop-failed: clean"
  fi
  if [ -d "$CACHE_DIR/gpu-fallback" ] && [ -n "$(ls -A "$CACHE_DIR/gpu-fallback" 2>/dev/null)" ]; then
    echo "app gpu-fallback markers: $(ls "$CACHE_DIR/gpu-fallback" 2>/dev/null | tr '\n' ' ')"
  else
    echo "app gpu-fallback markers: none"
  fi
  if [ -s "$CACHE_DIR/kwin-gpu.log" ]; then
    echo "--- kwin-gpu.log (last 25 lines) ---"
    tail -n 25 "$CACHE_DIR/kwin-gpu.log" 2>/dev/null || true
  fi
  if [ -s "$CACHE_DIR/gpu-apps.log" ]; then
    echo "--- gpu-apps.log (last 30 lines) ---"
    tail -n 30 "$CACHE_DIR/gpu-apps.log" 2>/dev/null || true
  fi
} > "${OUT_FILE}.tmp" 2>&1

mv -f "${OUT_FILE}.tmp" "$OUT_FILE" 2>/dev/null || true
cat "$OUT_FILE" 2>/dev/null || true
