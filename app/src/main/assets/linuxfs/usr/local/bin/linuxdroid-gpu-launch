#!/bin/bash
# LinuxDroid: launch an app with GPU acceleration (Zink/Turnip or Venus/VirGL) when enabled in Settings.
# If the hardware launch fails right away, the app is restarted with software rendering and
# remembered so later launches skip the GPU. Usage: linuxdroid-gpu-launch NAME_OR_PATH [ARGS...]
set -u
target="${1:-}"
[ -n "$target" ] || { echo "usage: linuxdroid-gpu-launch PROGRAM [ARGS...]" >&2; exit 2; }
shift

resolve() {
  case "$1" in
    /*) [ -x "$1" ] && echo "$1" ;;
    *)
      local dirs d
      IFS=: read -ra dirs <<< "$PATH"
      for d in "${dirs[@]}"; do
        [ "$d" = "/usr/local/bin" ] && continue
        [ -x "$d/$1" ] && { echo "$d/$1"; return; }
      done
      ;;
  esac
}

real="$(resolve "$target")"
[ -n "$real" ] || { echo "$target: command not found" >&2; exit 127; }
name="$(basename "$target")"
cache_dir="${XDG_CACHE_HOME:-${HOME:-/home/linux}/.cache}/linuxdroid"
mark="$cache_dir/gpu-fallback"
app_log="$cache_dir/gpu-apps.log"
mkdir -p "$cache_dir" 2>/dev/null || true

log_event() {
  printf '[%s] [%s] %s\n' "$(date -u '+%Y-%m-%d %H:%M:%S UTC')" "$name" "$*" >> "$app_log" 2>/dev/null || true
}

run_software() {
  log_event "Launching in software rendering mode (BL_GPU_APPS=${BL_GPU_APPS:-0}, fallback_marker=$([ -e "$mark/$name" ] && echo yes || echo no))"
  export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe
  unset MESA_LOADER_DRIVER_OVERRIDE LIBGL_KOPPER_DRI2 MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE ZINK_DESCRIPTORS
  exec "$real" "$@"
}

if [ "${BL_GPU_APPS:-0}" != "1" ] || [ -e "$mark/$name" ]; then
  run_software "$@"
fi

log_event "Launching with hardware GPU acceleration ($real $*) WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset} DISPLAY=${DISPLAY:-unset}"
start="$(date +%s)"
err_capture="$cache_dir/last-${name}-$$.err"
/usr/local/bin/linuxdroid-gpu "$real" "$@" 2> >(tee -a "$cache_dir/last-${name}-gpu.err" "$err_capture" >&2)
rc=$?
elapsed=$(( $(date +%s) - start ))
if [ -s "$err_capture" ]; then
  tail -n 20 "$err_capture" 2>/dev/null | while IFS= read -r line; do
    log_event "stderr: $line"
  done
fi
rm -f "$err_capture" 2>/dev/null || true
if [ "$rc" -ne 0 ] && [ "$rc" -ne 130 ] && [ "$rc" -ne 143 ] && [ "$elapsed" -lt 6 ]; then
  mkdir -p "$mark" 2>/dev/null && printf 'exit=%s elapsed=%ss at %s\n' "$rc" "$elapsed" "$(date -u '+%Y-%m-%d %H:%M:%S UTC')" > "$mark/$name" 2>/dev/null
  log_event "GPU start failed (exit $rc in ${elapsed}s); recorded fallback marker and restarting in software mode."
  echo "linuxdroid-gpu-launch: GPU start failed for $name (exit $rc); using software rendering." >&2
  run_software "$@"
fi
log_event "Exited with code $rc after ${elapsed}s"
exit "$rc"
