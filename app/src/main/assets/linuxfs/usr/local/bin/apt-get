#!/usr/bin/python3 -BE
import os
import resource
import subprocess
import sys

REAL_APT_GET = "/usr/bin/apt-get"
LISTS_DIR = "/var/lib/apt/lists"
AUTO_UPDATE_CMDS = {
    "install",
    "reinstall",
    "upgrade",
    "dist-upgrade",
    "full-upgrade",
    "build-dep",
    "download",
    "source",
}


def cap_nofile_soft_limit(max_soft=8192):
    try:
        soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
        if soft == resource.RLIM_INFINITY or soft > max_soft:
            target = max_soft if hard == resource.RLIM_INFINITY else min(max_soft, hard)
            resource.setrlimit(resource.RLIMIT_NOFILE, (target, hard))
    except (OSError, ValueError):
        pass


def resolve_real_binary(primary):
    distrib = primary + ".distrib"
    try:
        with open(primary, "rb") as f:
            if f.read(2) == b"#!" and os.path.isfile(distrib):
                return distrib
    except OSError:
        pass
    return primary


def ensure_sbin_path():
    required = ["/usr/local/sbin", "/usr/local/bin", "/usr/sbin", "/usr/bin", "/sbin", "/bin"]
    parts = [p for p in os.environ.get("PATH", "").split(":") if p]
    for req in reversed(required):
        if req not in parts:
            parts.insert(0, req)
    os.environ["PATH"] = ":".join(parts)


def has_apt_lists():
    try:
        for entry in os.listdir(LISTS_DIR):
            if entry in ("lock", "partial", "auxfiles"):
                continue
            full = os.path.join(LISTS_DIR, entry)
            if os.path.isfile(full) and os.path.getsize(full) > 0:
                return True
    except OSError:
        pass
    return False


def find_subcommand(args):
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            break
        if a in ("-o", "--option", "-c", "--config-file", "-t", "--target-release", "-a", "--host-architecture"):
            i += 2
            continue
        if a.startswith("-"):
            i += 1
            continue
        return a
    return None


def main(argv):
    cap_nofile_soft_limit()
    ensure_sbin_path()
    real_apt_get = resolve_real_binary(REAL_APT_GET)
    subcmd = find_subcommand(argv[1:])
    if os.geteuid() == 0 and subcmd in AUTO_UPDATE_CMDS and not has_apt_lists():
        if os.path.exists(real_apt_get):
            print("LinuxDroid: APT package lists are empty; running 'apt-get update' first...", file=sys.stderr, flush=True)
            subprocess.call([real_apt_get, "update"])
    os.execv(real_apt_get, [real_apt_get] + argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
