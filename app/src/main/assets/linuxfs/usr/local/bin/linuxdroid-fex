#!/usr/bin/python3 -BE
import json
import os
from pathlib import Path
import shutil
import struct
import subprocess
import sys

X86_MACHINES = {3: "i386", 62: "x86_64"}
ARM_MACHINES = {40: "arm", 183: "arm64"}


def elf_arch(path):
    try:
        with open(path, "rb") as f:
            head = f.read(20)
    except OSError:
        return None
    if len(head) < 20 or head[:4] != b"\x7fELF":
        return None
    machine = struct.unpack_from("<H" if head[5] == 1 else ">H", head, 18)[0]
    return X86_MACHINES.get(machine) or ARM_MACHINES.get(machine) or "other"


def find_fex():
    for candidate in ("/usr/bin/FEXInterpreter", "/usr/bin/FEXLoader", "/usr/bin/FEX",
                      "/usr/local/bin/FEXInterpreter", "/usr/local/bin/FEX"):
        if os.access(candidate, os.X_OK):
            return candidate
    return shutil.which("FEXInterpreter") or shutil.which("FEXLoader") or shutil.which("FEX")


def _is_nonempty_dir(path: Path) -> bool:
    try:
        return path.is_dir() and any(path.iterdir())
    except OSError:
        return False


def _fex_paths(home: Path):
    env_home = os.environ.get("HOME")
    use_xdg_env = bool(env_home and Path(env_home) == home)
    xdg_data = Path(os.environ["XDG_DATA_HOME"]) if (use_xdg_env and os.environ.get("XDG_DATA_HOME")) else (home / ".local" / "share")
    xdg_cfg = Path(os.environ["XDG_CONFIG_HOME"]) if (use_xdg_env and os.environ.get("XDG_CONFIG_HOME")) else (home / ".config")
    return xdg_data / "fex-emu" / "RootFS", xdg_cfg / "fex-emu", home / ".fex-emu"


def _locate_rootfs(home: Path):
    xdg_rootfs_dir, _, legacy_dir = _fex_paths(home)
    legacy_rootfs_dir = legacy_dir / "RootFS"
    candidates = []
    for d in (xdg_rootfs_dir, legacy_rootfs_dir):
        if d not in candidates:
            candidates.append(d)
    for fex_dir in candidates:
        if fex_dir.is_dir():
            # Prefer extracted directories because Android lacks /dev/fuse for .ero/.sqsh mounts.
            dirs = sorted([p for p in fex_dir.iterdir() if _is_nonempty_dir(p)])
            if dirs:
                return dirs[-1].name, fex_dir
    for fex_dir in candidates:
        if fex_dir.is_dir():
            archives = sorted(
                [p for p in fex_dir.iterdir() if p.is_file() and p.suffix in (".sqsh", ".ero") and p.stat().st_size > 0]
            )
            if archives:
                return archives[-1].name, fex_dir
    return None, None


def find_rootfs(home: Path):
    name, _ = _locate_rootfs(home)
    return name


def _silence_x86_preload_warning(rootfs_dir: Path, rootfs_name: str):
    if not rootfs_dir or not rootfs_name:
        return
    etc_dir = rootfs_dir / rootfs_name / "etc"
    if etc_dir.is_dir():
        preload = etc_dir / "ld.so.preload"
        if not preload.exists():
            try:
                preload.touch(exist_ok=True)
            except OSError:
                pass


def ensure_fex_config(home: Path):
    xdg_rootfs_dir, xdg_cfg_dir, legacy_dir = _fex_paths(home)
    rootfs, rootfs_parent = _locate_rootfs(home)
    _silence_x86_preload_warning(rootfs_parent, rootfs)

    # FEX-Emu enters legacy mode whenever ~/.fex-emu exists, expecting RootFS under ~/.fex-emu/RootFS.
    # Never create ~/.fex-emu from scratch when using XDG; if ~/.fex-emu already exists while RootFS
    # was fetched into XDG (~/.local/share/fex-emu/RootFS), bridge ~/.fex-emu/RootFS via symlink.
    cfg_targets = []
    if legacy_dir.is_dir():
        legacy_rfs = legacy_dir / "RootFS"
        if rootfs_parent and rootfs_parent != legacy_rfs and not legacy_rfs.exists():
            try:
                legacy_rfs.symlink_to(rootfs_parent)
            except OSError:
                pass
        cfg_targets.append(legacy_dir / "Config.json")
        if xdg_cfg_dir.is_dir() or rootfs_parent == xdg_rootfs_dir:
            cfg_targets.append(xdg_cfg_dir / "Config.json")
    else:
        cfg_targets.append(xdg_cfg_dir / "Config.json")

    host_thunks = next((p for p in (
        "/usr/lib/aarch64-linux-gnu/fex-emu/HostThunks",
        "/usr/lib/fex-emu/HostThunks",
        "/usr/local/lib/fex-emu/HostThunks",
    ) if os.path.isdir(p)), None)
    guest_thunks = next((p for p in (
        "/usr/share/fex-emu/GuestThunks",
        "/usr/local/share/fex-emu/GuestThunks",
    ) if os.path.isdir(p)), None)

    for cfg_file in cfg_targets:
        cfg_file.parent.mkdir(parents=True, exist_ok=True)
        data = {}
        if cfg_file.is_file():
            try:
                data = json.loads(cfg_file.read_text(encoding="utf-8"))
            except Exception:
                data = {}
        cfg = data.setdefault("Config", {})
        current = cfg.get("RootFS")
        check_dir = rootfs_parent or (legacy_dir / "RootFS" if legacy_dir.is_dir() else xdg_rootfs_dir)
        current_valid = bool(
            current
            and check_dir
            and (
                _is_nonempty_dir(check_dir / current)
                or (
                    not (rootfs and rootfs_parent and _is_nonempty_dir(rootfs_parent / rootfs))
                    and (check_dir / current).is_file()
                )
            )
        )
        if rootfs and not current_valid:
            cfg["RootFS"] = rootfs
        if host_thunks and guest_thunks:
            cfg.setdefault("ThunkHostLibs", host_thunks)
            cfg.setdefault("ThunkGuestLibs", guest_thunks)
            thunks = data.setdefault("ThunksDB", {})
            thunks.setdefault("GL", 1)
            thunks.setdefault("Vulkan", 1)
            thunks.setdefault("WaylandClient", 1)
        cfg_file.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    return rootfs


def clean_guest_env(env):
    out = dict(env)
    preloads = [p for p in (out.get("LD_PRELOAD") or "").replace(" ", ":").split(":")
                if p and ("/" not in p or (os.path.exists(p) and elf_arch(p) not in ARM_MACHINES.values()))]
    lib_paths = [p for p in (out.get("LD_LIBRARY_PATH") or "").split(":")
                 if p and "aarch64" not in p and "arm64" not in p]
    if preloads:
        out["LD_PRELOAD"] = ":".join(preloads)
    else:
        out.pop("LD_PRELOAD", None)
    if lib_paths:
        out["LD_LIBRARY_PATH"] = ":".join(lib_paths)
    else:
        out.pop("LD_LIBRARY_PATH", None)
    return out


def main(argv):
    home = Path(os.environ.get("HOME") or Path.home())
    cmd = argv[0] if argv else "status"

    if cmd == "status":
        fex = find_fex()
        rootfs = ensure_fex_config(home)
        print(json.dumps({"fex": fex, "rootfs": rootfs, "ready": bool(fex and rootfs)}, indent=2))
        return 0

    if cmd == "fetch-rootfs":
        existing_name, existing_parent = _locate_rootfs(home)
        if (
            "--force" not in argv[1:]
            and existing_name
            and existing_parent
            and _is_nonempty_dir(existing_parent / existing_name)
        ):
            ensure_fex_config(home)
            print(f"FEX RootFS '{existing_name}' is already extracted and configured.")
            return 0
        fetcher = shutil.which("FEXRootFSFetcher")
        if not fetcher:
            print("FEXRootFSFetcher is not installed in this rootfs.", file=sys.stderr)
            return 1
        rc = subprocess.call(
            [
                fetcher,
                "-y",
                "-x",
                "--distro-name=ubuntu",
                "--distro-version=24.04",
                "--distro-list-first",
                "--force-ui=tty",
            ]
        )
        rootfs = ensure_fex_config(home)
        if rc != 0 and not rootfs:
            return rc
        return 0 if rootfs else 1

    if cmd == "needs":
        target = argv[1] if len(argv) > 1 else ""
        return 0 if elf_arch(target) in X86_MACHINES.values() else 1

    if cmd == "run":
        rest = argv[1:]
        if "--" in rest:
            rest = rest[rest.index("--") + 1:]
        if not rest:
            print("usage: linuxdroid-fex run -- PROGRAM [ARGS...]", file=sys.stderr)
            return 2
        prog = shutil.which(rest[0]) if "/" not in rest[0] else os.path.abspath(rest[0])
        prog = prog or rest[0]
        if elf_arch(prog) not in X86_MACHINES.values():
            os.execvp(rest[0], rest)
        fex = find_fex()
        if not fex:
            print("linuxdroid-fex: FEXInterpreter is not installed.", file=sys.stderr)
            return 127
        ensure_fex_config(home)
        guest_env = clean_guest_env(os.environ)
        os.execve(fex, [fex, prog] + rest[1:], guest_env)

    print("usage: linuxdroid-fex [status | fetch-rootfs | needs FILE | run -- PROGRAM ARGS...]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
