#!/usr/bin/python3 -BE
import os
import resource
import shutil
import socket
import subprocess
import sys
import time

REAL_FLATPAK = "/usr/bin/flatpak"
_SELF_DIR = os.path.dirname(os.path.abspath(__file__))
BWRAP_SHIM = (
    os.path.join(_SELF_DIR, "bwrap")
    if os.path.exists(os.path.join(_SELF_DIR, "bwrap"))
    else "/usr/local/bin/bwrap"
)
LINUXDROID_ROOT = (
    os.path.join(_SELF_DIR, "linuxdroid-root")
    if os.path.exists(os.path.join(_SELF_DIR, "linuxdroid-root"))
    else "/usr/local/bin/linuxdroid-root"
)

SYSTEM_MUTATING_CMDS = {
    "remote-add",
    "remote-modify",
    "remote-delete",
    "install",
    "update",
    "uninstall",
    "remove",
    "repair",
    "mask",
    "override",
    "pin",
}

SYSTEM_BUS_CONF = """<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>system</type>
  <listen>unix:path=/run/dbus/system_bus_socket</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow user="*"/>
    <allow own="*"/>
    <allow send_destination="*"/>
    <allow receive_sender="*"/>
  </policy>
</busconfig>
"""


SESSION_BUS_CONF_TMPL = """<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>session</type>
  <listen>unix:path={sock_path}</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow user="*"/>
    <allow own="*"/>
    <allow send_destination="*"/>
    <allow receive_sender="*"/>
  </policy>
</busconfig>
"""


def cap_nofile_soft_limit(max_soft=8192):
    try:
        soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
        if soft == resource.RLIM_INFINITY or soft > max_soft:
            target = max_soft if hard == resource.RLIM_INFINITY else min(max_soft, hard)
            resource.setrlimit(resource.RLIMIT_NOFILE, (target, hard))
    except (OSError, ValueError):
        pass


def is_unix_socket_live(path):
    if not os.path.exists(path):
        return False
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.settimeout(0.5)
        s.connect(path)
        return True
    except OSError:
        return False
    finally:
        s.close()


def is_dbus_address_live(addr):
    if not addr or not addr.startswith("unix:"):
        return False
    spec = addr[5:].split(";", 1)[0]
    kv = {}
    for part in spec.split(","):
        if "=" in part:
            k, v = part.split("=", 1)
            kv[k] = v
    if "path" in kv:
        return is_unix_socket_live(kv["path"])
    if "abstract" in kv:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.settimeout(0.5)
            s.connect("\0" + kv["abstract"])
            return True
        except OSError:
            return False
        finally:
            s.close()
    return False


def ensure_runtime_dirs():
    uid = os.geteuid()
    gid = os.getegid()
    user_run = f"/run/user/{uid}"
    need_root = False
    for d, mode in (("/run/dbus", 0o777), ("/run/flatpak", 0o777), (user_run, 0o700)):
        if not (os.path.isdir(d) and os.access(d, os.W_OK | os.X_OK)):
            try:
                os.makedirs(d, mode=mode, exist_ok=True)
                os.chmod(d, mode)
            except OSError:
                need_root = True
    if need_root and os.path.exists(LINUXDROID_ROOT):
        subprocess.call(
            [
                LINUXDROID_ROOT,
                "sh",
                "-c",
                f"mkdir -p -m 777 /run/dbus /run/flatpak && mkdir -p -m 700 {user_run} && chown {uid}:{gid} {user_run} && chmod 700 {user_run}",
            ]
        )


def ensure_system_bus():
    ensure_runtime_dirs()
    sock = "/run/dbus/system_bus_socket"
    if is_unix_socket_live(sock):
        return
    dbus_daemon = shutil.which("dbus-daemon")
    if not dbus_daemon:
        return
    try:
        os.makedirs("/tmp/linuxdroid-dbus", exist_ok=True)
        conf_path = "/tmp/linuxdroid-dbus/system.conf"
        with open(conf_path, "w", encoding="utf-8") as f:
            f.write(SYSTEM_BUS_CONF)
        if os.path.lexists(sock):
            try:
                os.unlink(sock)
            except OSError:
                subprocess.call([LINUXDROID_ROOT, "rm", "-f", sock])
        subprocess.Popen(
            [dbus_daemon, f"--config-file={conf_path}", "--nofork", "--nopidfile"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        for _ in range(40):
            if is_unix_socket_live(sock):
                break
            time.sleep(0.05)
    except OSError:
        pass


def ensure_session_bus():
    ensure_runtime_dirs()
    uid = os.geteuid()
    xdg_run = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{uid}"
    os.environ["XDG_RUNTIME_DIR"] = xdg_run

    cur_addr = os.environ.get("DBUS_SESSION_BUS_ADDRESS", "")
    if is_dbus_address_live(cur_addr):
        return

    bus_addr_file = os.path.join(xdg_run, "bus-address")
    if os.path.isfile(bus_addr_file):
        try:
            with open(bus_addr_file, "r", encoding="utf-8") as f:
                saved_addr = f.read().strip()
            if is_dbus_address_live(saved_addr):
                os.environ["DBUS_SESSION_BUS_ADDRESS"] = saved_addr
                return
        except OSError:
            pass

    std_bus = os.path.join(xdg_run, "bus")
    if is_unix_socket_live(std_bus):
        os.environ["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={std_bus}"
        return

    dbus_daemon = shutil.which("dbus-daemon")
    if not dbus_daemon:
        return
    try:
        os.makedirs("/tmp/linuxdroid-dbus", exist_ok=True)
        sock = f"/tmp/linuxdroid-dbus/session-{uid}.sock"
        if not is_unix_socket_live(sock):
            conf_path = f"/tmp/linuxdroid-dbus/session-{uid}.conf"
            with open(conf_path, "w", encoding="utf-8") as f:
                f.write(SESSION_BUS_CONF_TMPL.format(sock_path=sock))
            if os.path.lexists(sock):
                try:
                    os.unlink(sock)
                except OSError:
                    pass
            subprocess.Popen(
                [dbus_daemon, f"--config-file={conf_path}", "--nofork", "--nopidfile"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            for _ in range(40):
                if is_unix_socket_live(sock):
                    break
                time.sleep(0.05)
        if is_unix_socket_live(sock):
            os.environ["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={sock}"
    except OSError:
        pass


def find_subcommand_and_scope(args):
    subcmd = None
    explicit_user = False
    for a in args:
        if a == "--":
            break
        if a in ("--user", "-u"):
            explicit_user = True
        elif not a.startswith("-") and subcmd is None:
            subcmd = a
    return subcmd, explicit_user


def inject_no_documents_portal_if_needed(args):
    if os.access("/dev/fuse", os.R_OK | os.W_OK):
        return args
    for a in args:
        if a == "--":
            break
        if a in ("--no-documents-portal", "-h", "--help"):
            return args
    out = list(args)
    for idx, a in enumerate(out):
        if a == "run":
            out.insert(idx + 1, "--no-documents-portal")
            break
    return out


def main(argv):
    if not os.path.exists(REAL_FLATPAK):
        print("flatpak: command not found (install with: sudo apt install flatpak)", file=sys.stderr)
        return 127

    cap_nofile_soft_limit()
    os.environ.setdefault("FLATPAK_BWRAP", BWRAP_SHIM)
    args = argv[1:]
    subcmd, explicit_user = find_subcommand_and_scope(args)

    if subcmd == "run":
        ensure_system_bus()
        ensure_session_bus()
        args = inject_no_documents_portal_if_needed(args)

    if os.geteuid() != 0 and not explicit_user and subcmd in SYSTEM_MUTATING_CMDS:
        os.execv(LINUXDROID_ROOT, [LINUXDROID_ROOT, REAL_FLATPAK] + args)

    os.execv(REAL_FLATPAK, [REAL_FLATPAK] + args)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
