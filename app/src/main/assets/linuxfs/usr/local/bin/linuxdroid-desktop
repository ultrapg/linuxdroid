#!/bin/bash
set -u

export BL_DESKTOP=1
export LINUXDROID_PARENT_WAYLAND="${WAYLAND_DISPLAY:-wayland-0}"
export FLATPAK_BWRAP="/usr/local/bin/bwrap"
export XDG_DATA_DIRS="${HOME:-/home/linux}/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export APPIMAGE_EXTRACT_AND_RUN=1
export KDE_DEBUG=1
export QT_LOGGING_RULES="${QT_LOGGING_RULES:-*.debug=false;qt.qpa.*=false}"
export GTK_USE_PORTAL=0
export GDK_DEBUG=no-portals
export ELECTRON_DISABLE_SANDBOX=1
export QTWEBENGINE_DISABLE_SANDBOX=1
export MOZ_FORCE_DISABLE_E10S=1
export MOZ_SHM_NO_SEALS=1
export MOZ_FAKE_NO_SANDBOX=1
export MOZ_DISABLE_CONTENT_SANDBOX=1
export MOZ_DISABLE_GMP_SANDBOX=1
export MOZ_DISABLE_RDD_SANDBOX=1
export MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1
export MOZ_DISABLE_UTILITY_SANDBOX=1
export MOZ_DISABLE_GPU_SANDBOX=1
export MOZ_DISABLE_NPAPI_SANDBOX=1
export MOZ_ASSUME_USER_NS=0
export MOZ_CRASHREPORTER_DISABLE=1

WIDTH="${BL_WIDTH:-1920}"
HEIGHT="${BL_HEIGHT:-1080}"
PIXEL_WIDTH="${BL_PIXEL_WIDTH:-$WIDTH}"
PIXEL_HEIGHT="${BL_PIXEL_HEIGHT:-$HEIGHT}"
SCALE="${BL_SCALE:-1}"
mkdir -p "${XDG_RUNTIME_DIR:-/run/linuxdroid}" 2>/dev/null || true
cat > "${XDG_RUNTIME_DIR:-/run/linuxdroid}/desktop.env" <<EOF
export BL_WIDTH="${WIDTH}"
export BL_HEIGHT="${HEIGHT}"
export BL_PIXEL_WIDTH="${PIXEL_WIDTH}"
export BL_PIXEL_HEIGHT="${PIXEL_HEIGHT}"
export BL_SCALE="${SCALE}"
export BL_GPU_APPS="${BL_GPU_APPS:-1}"
export BL_GPU_DESKTOP="${BL_GPU_DESKTOP:-0}"
EOF

boot_step() {
  local step_num="$1"
  local msg="$2"
  echo "== [BOOT ${step_num}/6] ${msg}"
  if [ -n "${BL_BOOT_STATUS:-}" ]; then
    printf '%s|%s\n' "$step_num" "$msg" > "${BL_BOOT_STATUS}.tmp" 2>/dev/null && \
      mv -f "${BL_BOOT_STATUS}.tmp" "${BL_BOOT_STATUS}" 2>/dev/null || true
  fi
}

boot_ready() {
  local msg="$1"
  echo "== [BOOT READY] ${msg}"
  if [ -n "${BL_BOOT_STATUS:-}" ]; then
    printf 'READY|%s\n' "$msg" > "${BL_BOOT_STATUS}.tmp" 2>/dev/null && \
      mv -f "${BL_BOOT_STATUS}.tmp" "${BL_BOOT_STATUS}" 2>/dev/null || true
  fi
}

for conf in client client-rt; do
  if [ -d "/etc/pipewire" ] && [ ! -f "/etc/pipewire/$conf.conf.d/linuxdroid-rt.conf" ]; then
    linuxdroid-root sh -c "mkdir -p /etc/pipewire/$conf.conf.d && printf 'context.properties = {\n    module.rt = false\n}\n' >/etc/pipewire/$conf.conf.d/linuxdroid-rt.conf" 2>/dev/null || true
  fi
done

python3 /usr/local/bin/linuxdroid-open --install >/dev/null 2>&1 || true
update-mime-database "$HOME/.local/share/mime" >/dev/null 2>&1 &

desktop_choice="${LINUXDROID_DESKTOP:-auto}"
if [ "$desktop_choice" = "auto" ]; then
  if command -v startplasma-wayland >/dev/null 2>&1; then
    desktop_choice="kde"
  elif command -v startxfce4 >/dev/null 2>&1; then
    desktop_choice="xfce"
  elif command -v startlxqt >/dev/null 2>&1; then
    desktop_choice="lxqt"
  else
    desktop_choice="fallback"
  fi
fi

start_x11_helpers() {
  local disp="$1"
  local want_ime="${2:-}"
  (
    local chosen_disp=""
    for _ in $(seq 1 120); do
      for candidate in $disp; do
        if DISPLAY="$candidate" python3 -c "import ctypes; x=ctypes.CDLL('libX11.so.6'); x.XOpenDisplay.restype=ctypes.c_void_p; d=x.XOpenDisplay(None); raise SystemExit(0 if d else 1)" 2>/dev/null; then
          chosen_disp="$candidate"
          break 2
        fi
      done
      sleep 0.1
    done
    [ -n "$chosen_disp" ] || exit 0
    if [ -n "${BL_ANDROID_CLIPBOARD:-}" ] && [ -x /usr/local/bin/linuxdroid-clipboard ]; then
      DISPLAY="$chosen_disp" /usr/local/bin/linuxdroid-clipboard "$BL_ANDROID_CLIPBOARD" >/dev/null 2>&1 &
    fi
    if [ "$want_ime" = "x11-ime" ] && [ -x /usr/local/bin/linuxdroid-ime ]; then
      DISPLAY="$chosen_disp" /usr/local/bin/linuxdroid-ime --x11 >/dev/null 2>&1 &
    fi
    wait
  ) &
}

# Configure default taskbar pinned launchers to strictly Settings, Dolphin (File Explorer), and Chromium,
# while preserving all standard panel/taskbar widgets and removing missing Discover entries.
configure_kde_default_launchers() {
  local default_launchers="applications:systemsettings.desktop,applications:org.kde.dolphin.desktop,applications:chromium.desktop"
  local stamp="$HOME/.local/share/linuxdroid/launchers-v5"
  local tm_xml="/usr/share/plasma/plasmoids/org.kde.plasma.taskmanager/contents/config/main.xml"
  local panel_js="/usr/share/plasma/layout-templates/org.kde.plasma.desktop.defaultPanel/contents/layout.js"

  local need_sys_patch=0
  if [ -f "$tm_xml" ] && ! grep -q "<default>${default_launchers}</default>" "$tm_xml" 2>/dev/null; then
    need_sys_patch=1
  fi
  if [ -f "$panel_js" ] && ! grep -q 'writeConfig("launchers"' "$panel_js" 2>/dev/null; then
    need_sys_patch=1
  fi
  if grep -q "Theme=org.kde.Breeze" /usr/share/plasma/look-and-feel/*/contents/defaults 2>/dev/null; then
    need_sys_patch=1
  fi
  if [ "$need_sys_patch" = 1 ]; then
    local sys_py='
import glob, os, re, sys
defaults, tm_xml, panel_js = sys.argv[1], sys.argv[2], sys.argv[3]
if os.path.isfile(tm_xml):
    txt = open(tm_xml, "r", encoding="utf-8").read()
    new_txt = re.sub(
        r"(<entry\s+name=\"launchers\"[^>]*>.*?<default>)[^<]*(</default>)",
        lambda m: m.group(1) + defaults + m.group(2),
        txt,
        flags=re.S,
    )
    if new_txt != txt:
        open(tm_xml, "w", encoding="utf-8").write(new_txt)
if os.path.isfile(panel_js):
    txt = open(panel_js, "r", encoding="utf-8").read()
    if "writeConfig(\"launchers\"" not in txt and "panel.addWidget(\"org.kde.plasma.icontasks\")" in txt:
        repl = (
            "var icontasks = panel.addWidget(\"org.kde.plasma.icontasks\");\n"
            "icontasks.currentConfigGroup = [\"General\"];\n"
            f"icontasks.writeConfig(\"launchers\", \"{defaults}\");"
        )
        new_txt = txt.replace("panel.addWidget(\"org.kde.plasma.icontasks\")", repl, 1)
        open(panel_js, "w", encoding="utf-8").write(new_txt)
for lnf_def in glob.glob("/usr/share/plasma/look-and-feel/*/contents/defaults"):
    try:
        txt = open(lnf_def, "r", encoding="utf-8").read()
        new_txt = re.sub(r"(\[KSplash\]\s*\n)Theme=[^\n]+", r"\1Engine=none\nTheme=None", txt)
        if new_txt != txt:
            open(lnf_def, "w", encoding="utf-8").write(new_txt)
    except OSError:
        pass
'
    python3 -B -c "$sys_py" "$default_launchers" "$tm_xml" "$panel_js" 2>/dev/null || \
      linuxdroid-root python3 -B -c "$sys_py" "$default_launchers" "$tm_xml" "$panel_js" 2>/dev/null || true
  fi

  mkdir -p "$HOME/.config" "$HOME/.config/kdedefaults"
  for ksplash_cfg in "$HOME/.config/ksplashrc" "$HOME/.config/kdedefaults/ksplashrc"; do
    printf '[KSplash]\nEngine=none\nTheme=None\n' > "$ksplash_cfg" 2>/dev/null || true
  done
  python3 -B - "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" "$stamp" "$default_launchers" <<'PY' 2>/dev/null || true
import glob
import os
import re
import sys

rc_path, stamp_path, defaults = sys.argv[1], sys.argv[2], sys.argv[3]
cfg_dir = os.path.dirname(rc_path)
os.makedirs(cfg_dir, exist_ok=True)

# Pre-seed kconf_updaterc if missing so kconf_update does not stall 30s on first start
kconf_rc = os.path.join(cfg_dir, "kconf_updaterc")
if not os.path.isfile(kconf_rc):
    upd_files = sorted(glob.glob("/usr/share/kconf_update/*.upd"))
    if upd_files:
        upd_lines = []
        for p in upd_files:
            try:
                st = os.stat(p)
                ids = []
                with open(p, "r", encoding="utf-8", errors="ignore") as uf:
                    for uln in uf:
                        if uln.startswith("Id="):
                            ids.append(uln.split("=", 1)[1].strip())
                if ids:
                    upd_lines.append(
                        f"[{os.path.basename(p)}]\nctime={int(st.st_ctime)}\ndone={','.join(ids)}\nmtime={int(st.st_mtime)}\n\n"
                    )
            except OSError:
                pass
        if upd_lines:
            with open(kconf_rc, "w", encoding="utf-8") as kf:
                kf.writelines(upd_lines)

# Pre-seed plasmashellrc if missing so first start does not stall on 13 JS migration scripts
pshell_rc = os.path.join(cfg_dir, "plasmashellrc")
if not os.path.isfile(pshell_rc):
    js_updates = sorted(glob.glob("/usr/share/plasma/shells/org.kde.plasma.desktop/contents/updates/*.js"))
    with open(pshell_rc, "w", encoding="utf-8") as pf:
        pf.write("[PlasmaViews][Panel 2][Defaults]\nthickness=44\n")
        if js_updates:
            pf.write("\n[Updates]\nperformed=" + ",".join(js_updates) + "\n")

# Ensure kactivitymanagerdrc has a deterministic default activity UUID before seeding appletsrc
kamd_rc = os.path.join(cfg_dir, "kactivitymanagerdrc")
act_id = "9001631a-e1b7-46bd-8e06-7dab8d8032a4"
if os.path.isfile(kamd_rc):
    try:
        with open(kamd_rc, "r", encoding="utf-8", errors="ignore") as af:
            for aln in af:
                if aln.startswith("currentActivity="):
                    val = aln.split("=", 1)[1].strip()
                    if val:
                        act_id = val
                    break
    except OSError:
        pass
else:
    with open(kamd_rc, "w", encoding="utf-8") as af:
        af.write(f"[activities]\n{act_id}=Default\n\n[main]\ncurrentActivity={act_id}\n")

# If appletsrc does not exist yet on first start (or lacks a panel from an interrupted boot),
# pre-seed the complete desktop + bottom taskbar panel
raw_lines = []
if os.path.isfile(rc_path):
    with open(rc_path, "r", encoding="utf-8", errors="surrogateescape") as f:
        raw_lines = f.readlines()

has_panel_or_tasks = any(
    ln.strip() in (
        "plugin=org.kde.panel",
        "plugin=org.kde.plasma.icontasks",
        "plugin=org.kde.plasma.taskmanager",
    )
    for ln in raw_lines
)

if not raw_lines or not has_panel_or_tasks:
    seed_appletsrc = f"""[ActionPlugins][0]
RightButton;NoModifier=org.kde.contextmenu
wheel:Vertical;NoModifier=org.kde.switchdesktop

[ActionPlugins][1]
RightButton;NoModifier=org.kde.contextmenu

[Containments][1]
ItemGeometriesHorizontal=
activityId={act_id}
formfactor=0
immutability=1
lastScreen=0
location=0
plugin=org.kde.plasma.folder
wallpaperplugin=org.kde.image

[Containments][2]
activityId=
formfactor=2
immutability=1
lastScreen=0
location=4
plugin=org.kde.panel
wallpaperplugin=org.kde.image

[Containments][2][Applets][15]
immutability=1
plugin=org.kde.plasma.digitalclock

[Containments][2][Applets][16]
immutability=1
plugin=org.kde.plasma.showdesktop

[Containments][2][Applets][3]
immutability=1
plugin=org.kde.plasma.kickoff

[Containments][2][Applets][3][Configuration][General]
favoritesPortedToKAstats=true

[Containments][2][Applets][3][Configuration][Shortcuts]
global=Alt+F1

[Containments][2][Applets][3][Shortcuts]
global=Alt+F1

[Containments][2][Applets][4]
immutability=1
plugin=org.kde.plasma.pager

[Containments][2][Applets][5]
immutability=1
plugin=org.kde.plasma.icontasks

[Containments][2][Applets][5][Configuration][General]
launchers={defaults}

[Containments][2][Applets][6]
immutability=1
plugin=org.kde.plasma.marginsseparator

[Containments][2][Applets][7]
immutability=1
plugin=org.kde.plasma.systemtray

[Containments][2][Applets][7][Configuration]
SystrayContainmentId=8

[Containments][2][General]
AppletOrder=3;4;5;6;7;15;16

[Containments][8]
activityId=
formfactor=2
immutability=1
lastScreen=0
location=4
plugin=org.kde.plasma.private.systemtray
wallpaperplugin=org.kde.image

[Containments][8][Applets][10]
immutability=1
plugin=org.kde.plasma.keyboardlayout

[Containments][8][Applets][11]
immutability=1
plugin=org.kde.plasma.devicenotifier

[Containments][8][Applets][12]
immutability=1
plugin=org.kde.plasma.volume

[Containments][8][Applets][13]
immutability=1
plugin=org.kde.plasma.manage-inputmethod

[Containments][8][Applets][14]
immutability=1
plugin=org.kde.plasma.notifications

[Containments][8][Applets][9]
immutability=1
plugin=org.kde.plasma.clipboard

[Containments][8][General]
extraItems=org.kde.plasma.clipboard,org.kde.plasma.mediacontroller,org.kde.plasma.keyboardlayout,org.kde.plasma.battery,org.kde.plasma.devicenotifier,org.kde.plasma.volume,org.kde.plasma.manage-inputmethod,org.kde.plasma.networkmanagement,org.kde.plasma.notifications
knownItems=org.kde.plasma.clipboard,org.kde.plasma.mediacontroller,org.kde.plasma.keyboardlayout,org.kde.plasma.battery,org.kde.plasma.devicenotifier,org.kde.plasma.volume,org.kde.plasma.manage-inputmethod,org.kde.plasma.networkmanagement,org.kde.plasma.notifications

[ScreenMapping]
itemsOnDisabledScreens=
screenMapping=
"""
    tmp_path = rc_path + ".tmp"
    with open(tmp_path, "w", encoding="utf-8") as f:
        f.write(seed_appletsrc)
    os.replace(tmp_path, rc_path)
    raise SystemExit(0)

first_run = not os.path.exists(stamp_path)
drop_discover = not os.path.exists("/usr/share/applications/org.kde.discover.desktop")

sections = []
cur_hdr = ""
cur_lines = []
for line in raw_lines:
    stripped = line.strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        sections.append([cur_hdr, cur_lines])
        cur_hdr = stripped
        cur_lines = []
    else:
        cur_lines.append(line)
sections.append([cur_hdr, cur_lines])

applet_re = re.compile(r"^\[Containments\]\[\d+\]\[Applets\]\[\d+\]$")
task_prefixes = []
for hdr, body in sections:
    if applet_re.match(hdr):
        for ln in body:
            s = ln.strip()
            if s in ("plugin=org.kde.plasma.icontasks", "plugin=org.kde.plasma.taskmanager"):
                task_prefixes.append(hdr)
                break

changed = False
containment_re = re.compile(r"^\[Containments\]\[\d+\]$")
for hdr, body in sections:
    if hdr == "[ScreenMapping]":
        target_sm = ["itemsOnDisabledScreens=\n", "screenMapping=\n"]
        if body != target_sm:
            body[:] = target_sm
            changed = True
    elif containment_re.match(hdr):
        is_desktop = any(ln.strip() in ("plugin=org.kde.plasma.folder", "plugin=org.kde.desktopcontainment") for ln in body)
        is_panel = any(ln.strip() in ("plugin=org.kde.panel", "plugin=org.kde.plasma.private.systemtray") for ln in body)
        if is_desktop or is_panel:
            new_body = []
            seen_screen = False
            seen_act = False
            seen_loc = False
            for ln in body:
                if ln.startswith("lastScreen="):
                    if ln != "lastScreen=0\n":
                        changed = True
                    new_body.append("lastScreen=0\n")
                    seen_screen = True
                elif is_desktop and ln.startswith("activityId="):
                    target_act = f"activityId={act_id}\n"
                    if ln != target_act:
                        changed = True
                    new_body.append(target_act)
                    seen_act = True
                elif is_panel and ln.startswith("location="):
                    if ln != "location=4\n":
                        changed = True
                    new_body.append("location=4\n")
                    seen_loc = True
                else:
                    new_body.append(ln)
            if not seen_screen:
                new_body.insert(0, "lastScreen=0\n")
                changed = True
            if is_desktop and not seen_act:
                new_body.insert(0, f"activityId={act_id}\n")
                changed = True
            if is_panel and not seen_loc:
                new_body.insert(0, "location=4\n")
                changed = True
            body[:] = new_body

if first_run and task_prefixes:
    for prefix in task_prefixes:
        cfg_hdr = prefix + "[Configuration][General]"
        for hdr, body in sections:
            if hdr.startswith(prefix + "[") and hdr != cfg_hdr:
                new_body = [ln for ln in body if not ln.startswith("launchers=")]
                if new_body != body:
                    body[:] = new_body
                    changed = True
        cfg_idx = next((i for i, (h, _) in enumerate(sections) if h == cfg_hdr), None)
        target_line = f"launchers={defaults}\n"
        if cfg_idx is not None:
            body = sections[cfg_idx][1]
            found_key = False
            new_body = []
            for ln in body:
                if ln.startswith("launchers="):
                    if not found_key:
                        if ln != target_line:
                            changed = True
                        new_body.append(target_line)
                        found_key = True
                    else:
                        changed = True
                else:
                    new_body.append(ln)
            if not found_key:
                insert_at = len(new_body)
                while insert_at > 0 and new_body[insert_at - 1].strip() == "":
                    insert_at -= 1
                new_body.insert(insert_at, target_line)
                changed = True
            body[:] = new_body
        else:
            parent_idx = next(i for i, (h, _) in enumerate(sections) if h == prefix)
            if sections[parent_idx][1] and sections[parent_idx][1][-1].strip() != "":
                sections[parent_idx][1].append("\n")
            sections.insert(parent_idx + 1, [cfg_hdr, [target_line, "\n"]])
            changed = True
else:
    for hdr, body in sections:
        new_body = []
        for ln in body:
            if ln.startswith("launchers="):
                val = ln[len("launchers="):].strip()
                items = [
                    x for x in val.split(",")
                    if x and not (drop_discover and "org.kde.discover.desktop" in x)
                ]
                new_ln = f"launchers={','.join(items) if items else defaults}\n"
                if new_ln != ln:
                    changed = True
                new_body.append(new_ln)
            else:
                new_body.append(ln)
        body[:] = new_body

if changed:
    out = []
    for hdr, body in sections:
        if hdr:
            out.append(hdr + "\n")
        out.extend(body)
    tmp_path = rc_path + ".tmp"
    with open(tmp_path, "w", encoding="utf-8", errors="surrogateescape") as f:
        f.writelines(out)
    os.replace(tmp_path, rc_path)
PY
}

sync_live_kde_launchers() {
  local default_launchers="applications:systemsettings.desktop,applications:org.kde.dolphin.desktop,applications:chromium.desktop"
  local stamp="$HOME/.local/share/linuxdroid/launchers-v5" first=1
  [ -e "$stamp" ] && first=0
  # Browsers are installed on demand: never pin a missing one (it renders as a blank icon), and pin an
  # installed one exactly once so it shows up in the taskbar after the user installs it.
  local missing_csv="" add_csv="" b
  for b in chromium firefox; do
    if [ -f "/usr/share/applications/$b.desktop" ]; then
      if [ ! -e "$HOME/.local/share/linuxdroid/pinned-$b" ]; then
        add_csv="${add_csv:+$add_csv,}applications:$b.desktop"
      fi
    else
      missing_csv="${missing_csv:+$missing_csv,}applications:$b.desktop"
    fi
  done
  local js='
    var missing = "'"$missing_csv"'".split(",").filter(function (x) { return x.length > 0; });
    var addList = "'"$add_csv"'".split(",").filter(function (x) { return x.length > 0; });
    function isMissing(l) { return missing.indexOf(l) >= 0; }
    var defaults = "'"$default_launchers"'".split(",").filter(function (l) { return !isMissing(l); }).join(",");
    var forceReset = '"$([ "$first" = 1 ] && echo true || echo false)"';
    var dropDiscover = '"$([ -e /usr/share/applications/org.kde.discover.desktop ] && echo false || echo true)"';
    var ps = panels();
    if (ps.length === 0 && typeof loadTemplate === "function") {
      try { loadTemplate("org.kde.plasma.desktop.defaultPanel"); } catch (e) {}
      ps = panels();
    }
    try {
      var ds = (typeof desktops === "function") ? desktops() : [];
      for (var d = 0; d < ds.length; d++) {
        ds[d].wallpaperPlugin = "org.kde.image";
      }
    } catch (e) {}
    var matched = 0;
    for (var i = 0; i < ps.length; i++) {
      var ws = ps[i].widgets();
      for (var j = 0; j < ws.length; j++) {
        var w = ws[j];
        if (w.type == "org.kde.plasma.icontasks" || w.type == "org.kde.plasma.taskmanager") {
          matched++;
          w.currentConfigGroup = ["General"];
          var cur = String(w.readConfig("launchers", ""));
          if (forceReset) {
            if (cur != defaults) {
              w.writeConfig("launchers", defaults);
            }
            continue;
          }
          if (cur.length == 0 || cur.indexOf("preferred://") >= 0) {
            w.writeConfig("launchers", defaults);
            continue;
          }
          var keep = cur.split(",").filter(function (l) {
            return l.length > 0 && !isMissing(l) && !(dropDiscover && l.indexOf("org.kde.discover.desktop") >= 0);
          });
          for (var a = 0; a < addList.length; a++) {
            if (keep.indexOf(addList[a]) < 0) { keep.push(addList[a]); }
          }
          if (keep.length == 0) {
            w.writeConfig("launchers", defaults);
          } else if (keep.join(",") != cur) {
            w.writeConfig("launchers", keep.join(","));
          }
        }
      }
    }
    if (matched > 0) { print("LAUNCHERS_READY:" + matched); }'
  local reply
  reply="$(dbus-send --session --dest=org.kde.plasmashell --type=method_call --print-reply /PlasmaShell \
    org.kde.PlasmaShell.evaluateScript string:"$js" 2>/dev/null || true)"
  if printf '%s' "$reply" | grep -q "LAUNCHERS_READY:"; then
    mkdir -p "$HOME/.local/share/linuxdroid" && : > "$stamp"
    for b in chromium firefox; do
      [ -f "/usr/share/applications/$b.desktop" ] && : > "$HOME/.local/share/linuxdroid/pinned-$b"
    done
    return 0
  fi
  return 1
}

prune_missing_launchers() {
  configure_kde_default_launchers
}

if [ "$desktop_choice" = "kde" ]; then
  prune_missing_launchers
  boot_step 5 "Starting KDE Plasma Wayland (${PIXEL_WIDTH}x${PIXEL_HEIGHT}, scale=${SCALE})..."

  export XDG_SESSION_TYPE=wayland
  export XDG_CURRENT_DESKTOP=KDE
  export XDG_SESSION_DESKTOP=KDE
  export DESKTOP_SESSION=plasma
  export KDE_FULL_SESSION=true
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    export KDE_SESSION_VERSION=6
    KWRITECONFIG=kwriteconfig6
  else
    export KDE_SESSION_VERSION=5
    KWRITECONFIG=kwriteconfig5
  fi
  export KDE_APPLICATIONS_AS_SCOPE=0
  export QT_QPA_PLATFORM="wayland;xcb"
  unset QT_QPA_PLATFORMTHEME
  export GDK_BACKEND="wayland,x11"
  export SDL_VIDEODRIVER="wayland,x11"

  # Nested KWin Wayland uses QPainter wl_shm into LinuxDroid's Vulkan compositor so it starts
  # reliably across Snapdragon KGSL, MediaTek, and Exynos without requiring DRM/GBM modesetting.
  # Native SoC Vulkan (Turnip / Venus / PanVK) remains active via VK_ICD_FILENAMES, and full
  # hardware OpenGL is available anytime via `linuxdroid-gpu <program>`.
  gpu_fail="${XDG_CACHE_HOME:-$HOME/.cache}/linuxdroid/gpu-desktop-failed"
  kwin_gpu_log="${XDG_CACHE_HOME:-$HOME/.cache}/linuxdroid/kwin-gpu.log"
  mkdir -p "${gpu_fail%/*}" 2>/dev/null || true
  gpu_desktop=0
  if [ "${BL_GPU_DESKTOP:-0}" = "1" ] && [ ! -e "$gpu_fail" ]; then
    gpu_desktop=1
  fi
  unset GALLIUM_THREAD
  export LP_NUM_THREADS="${BL_CPU_COUNT:-4}"
  export QSG_RENDER_LOOP=basic
  export KWIN_USE_OVERLAYS=0
  export KWIN_EFFECTS_FORCE_ANIMATIONS=0
  export KWIN_WAYLAND_NO_PERMISSION_CHECKS=1
  export KWIN_SCREENSHOT_NO_PERMISSION_CHECKS=1
  export KWIN_WAYLAND_NO_XAUTHORITY=1
  unset MESA_NO_ERROR
  # Nested KWin Wayland, kded5, ksmserver, and plasmashell start with QPainter/software QtQuick
  # so they never stall or fail trying to create DRM/GBM/EGL surfaces on nested wayland-1.
  # LinuxDroid's host compositor composites on the hardware Vulkan GPU, and desktop apps via
  # /usr/local/bin/linuxdroid-gpu-launch activate hardware GPU acceleration independently.
  export KWIN_COMPOSE=Q
  export QT_QUICK_BACKEND=software
  export GALLIUM_THREAD=0
  unset MESA_LOADER_DRIVER_OVERRIDE LIBGL_KOPPER_DRI2 MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE KWIN_RENDER_NODES KWIN_DRM_DEVICES
  export LIBGL_ALWAYS_SOFTWARE=1
  export GALLIUM_DRIVER=llvmpipe
  if [ "$gpu_desktop" = 1 ]; then
    echo "== linuxdroid-desktop: hybrid GPU desktop (Host Vulkan + KWin QPainter + GPU apps, ${LINUXDROID_GPU_ACTIVE:-gpu})"
  fi

  mkdir -p "$HOME/.local/share/applications" "$HOME/.config"
  cat > "$HOME/.local/share/applications/linuxdroid-ime.desktop" <<'ENTRY'
[Desktop Entry]
Type=Application
Name=Android Native Keyboard
Exec=/usr/local/bin/linuxdroid-ime
NoDisplay=true
X-KDE-Wayland-VirtualKeyboard=true
ENTRY

  # Configure all KDE INI settings in a single fast Python pass instead of 19 separate kwriteconfig5 processes
  python3 -B - "$HOME/.config" "$SCALE" "${BL_UI_SCALE:-$SCALE}" "${LANG:-C.UTF-8}" "$HOME/.local/share/applications/linuxdroid-ime.desktop" "$HOME/.local/share/linuxdroid/desktop-tuned-v1" "$WIDTH" "$HEIGHT" <<'PY' 2>/dev/null || true
import os
import re
import sys

cfg_dir, scale_s, ui_scale_s, lang, ime_desktop, tuned_stamp, width_s, height_s = sys.argv[1:9]
os.makedirs(cfg_dir, exist_ok=True)
try:
    scale = float(scale_s)
except Exception:
    scale = 1.0
try:
    ui_scale = float(ui_scale_s)
except Exception:
    ui_scale = scale
try:
    disp_w = max(640, int(width_s))
    disp_h = max(480, int(height_s))
except Exception:
    disp_w, disp_h = 1920, 1080

win_w = max(560, disp_w - 64)
win_h = max(400, disp_h - 120)
max_w = disp_w
max_h = max(420, disp_h - 48)

cursor_px = str(max(24, int(round(24.0 * scale))))
font_dpi = str(int(round(96.0 * ui_scale / scale)) if abs(ui_scale - scale) > 0.01 else 0)

def update_ini(filename, updates):
    path = os.path.join(cfg_dir, filename)
    text = ""
    if os.path.isfile(path):
        try:
            with open(path, "r", encoding="utf-8", errors="surrogateescape") as f:
                text = f.read()
        except OSError:
            text = ""
    orig = text
    for group, kv in updates.items():
        hdr = f"[{group}]"
        idx = text.find(hdr)
        if idx == -1:
            if text and not text.endswith("\n"):
                text += "\n"
            if text:
                text += "\n"
            text += hdr + "\n"
            for k, v in kv.items():
                text += f"{k}={v}\n"
        else:
            start = idx + len(hdr)
            nl = text.find("\n", start)
            body_start = nl + 1 if nl != -1 else len(text)
            next_hdr = re.search(r"(?m)^\[", text[body_start:])
            body_end = body_start + next_hdr.start() if next_hdr else len(text)
            body = text[body_start:body_end]
            lines = body.splitlines(True)
            for k, v in kv.items():
                prefix = k + "="
                replaced = False
                for i, ln in enumerate(lines):
                    if ln.startswith(prefix):
                        lines[i] = f"{k}={v}\n"
                        replaced = True
                        break
                if not replaced:
                    insert_at = len(lines)
                    while insert_at > 0 and lines[insert_at - 1].strip() == "":
                        insert_at -= 1
                    lines.insert(insert_at, f"{k}={v}\n")
            text = text[:body_start] + "".join(lines) + text[body_end:]
    if text != orig:
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as f:
            f.write(text)
        os.replace(tmp, path)

update_ini("kwinrc", {
    "Compositing": {"Backend": "QPainter"},
    "Wayland": {"InputMethod": ime_desktop, "VirtualKeyboardEnabled": "true"},
    "Xwayland": {"Scale": scale_s},
    "Windows": {"BorderlessMaximizedWindows": "false", "Placement": "Centered"},
