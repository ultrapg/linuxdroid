update_ini("kcmfonts", {"General": {"forceFontDPI": font_dpi}})
PY

  echo "== linuxdroid-desktop: starting KDE Plasma Wayland (logical=${WIDTH}x${HEIGHT}, pixel=${PIXEL_WIDTH}x${PIXEL_HEIGHT}, scale=${SCALE}, gpu_desktop=${gpu_desktop})"
  export -f start_x11_helpers configure_kde_default_launchers sync_live_kde_launchers prune_missing_launchers
  dbus-run-session -- /bin/bash -c '
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
      printf "%s\n" "$DBUS_SESSION_BUS_ADDRESS" > "$XDG_RUNTIME_DIR/bus-address" 2>/dev/null || true
    fi
    if [ -x /usr/local/bin/linuxdroid-flatpak-helper ]; then
      /usr/local/bin/linuxdroid-flatpak-helper >/dev/null 2>&1 &
    fi
    write_status() {
      echo "$2"
      if [ -n "${BL_BOOT_STATUS:-}" ]; then
        printf "%s\n" "$1" > "${BL_BOOT_STATUS}.tmp" 2>/dev/null && \
          mv -f "${BL_BOOT_STATUS}.tmp" "${BL_BOOT_STATUS}" 2>/dev/null || true
      fi
    }
    start_x11_helpers ":0 :1" ""
    (
      wl1_ready=0
      wl_nested_sock="wayland-1"
      for i in $(seq 1 150); do
        if [ -S "$XDG_RUNTIME_DIR/wayland-1" ]; then
          wl1_ready=1
          wl_nested_sock="wayland-1"
        elif [ -S "$XDG_RUNTIME_DIR/wayland-2" ]; then
          wl1_ready=1
          wl_nested_sock="wayland-2"
        fi
        if [ "$wl1_ready" = "1" ]; then
          WAYLAND_DISPLAY="$wl_nested_sock" DISPLAY=":0" BL_WIDTH="$WIDTH" BL_HEIGHT="$HEIGHT" BL_SCALE="$SCALE" BL_GPU_APPS="${BL_GPU_APPS:-1}" \
            dbus-update-activation-environment WAYLAND_DISPLAY DISPLAY BL_WIDTH BL_HEIGHT BL_SCALE BL_GPU_APPS >/dev/null 2>&1 || true
          for kamd in /usr/lib/*/libexec/kactivitymanagerd /usr/lib/kactivitymanagerd /usr/libexec/kactivitymanagerd; do
            if [ -x "$kamd" ]; then
              WAYLAND_DISPLAY="$wl_nested_sock" "$kamd" >/dev/null 2>&1 &
              break
            fi
          done
          pkill -x ksplashqml 2>/dev/null || true
          write_status "6|Loading KDE Plasma desktop & taskbar..." "== [BOOT 6/6] Loading KDE Plasma desktop & taskbar..."
          break
        fi
        if [ "$i" -eq 45 ] && [ ! -S "$XDG_RUNTIME_DIR/wayland-1" ] && ! pgrep -x kwin_wayland >/dev/null 2>&1; then
          echo "== linuxdroid-desktop: kwin_wayland not running at 4.5s; starting kwin_wayland_wrapper fallback"
          /usr/local/bin/kwin_wayland_wrapper --xwayland >/dev/null 2>&1 &
        fi
        if [ "$i" -eq 85 ] && [ ! -S "$XDG_RUNTIME_DIR/wayland-1" ] && ! pgrep -x kwin_wayland >/dev/null 2>&1; then
          echo "== linuxdroid-desktop: kwin_wayland still not running at 8.5s; starting direct kwin_wayland fallback"
          KWIN_COMPOSE=Q QT_QUICK_BACKEND=software LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe KWIN_WAYLAND_NO_XAUTHORITY=1 \
            /usr/bin/kwin_wayland --wayland-display "${LINUXDROID_PARENT_WAYLAND:-wayland-0}" --socket wayland-1 --xwayland \
            --width "${WIDTH}" --height "${HEIGHT}" --scale "${SCALE}" --no-lockscreen >/dev/null 2>&1 &
        fi
        sleep 0.1
      done
      if [ "$wl1_ready" != "1" ]; then
        echo "== linuxdroid-desktop: wayland-1 did not appear within 15s; marking READY to avoid boot screen hang"
        write_status "READY|KDE Plasma desktop ready" "== [BOOT READY] KDE Plasma desktop ready"
        exit 0
      fi
      shell_up=0
      for j in $(seq 1 60); do
        if [ "$j" -eq 15 ] && ! pgrep -x plasmashell.real >/dev/null 2>&1 && ! pgrep -x plasmashell.distrib >/dev/null 2>&1 && ! pgrep -x plasmashell >/dev/null 2>&1; then
          WAYLAND_DISPLAY="$wl_nested_sock" /usr/local/bin/plasmashell >/dev/null 2>&1 &
        fi
        if dbus-send --session --dest=org.kde.plasmashell --type=method_call --print-reply /PlasmaShell org.freedesktop.DBus.Introspectable.Introspect 2>/dev/null | grep -q "org.kde.PlasmaShell"; then
          pkill -x ksplashqml 2>/dev/null || true
          dbus-send --session --dest=org.kde.KWin --type=method_call /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true
          dbus-send --session --dest=org.kde.KWin --type=method_call /VirtualKeyboard org.freedesktop.DBus.Properties.Set string:"org.kde.kwin.VirtualKeyboard" string:"enabled" variant:boolean:true >/dev/null 2>&1 || true
          for _ in $(seq 1 40); do
            if sync_live_kde_launchers; then
              break
            fi
            sleep 0.25
          done
          write_status "READY|KDE Plasma desktop ready" "== [BOOT READY] KDE Plasma desktop ready"
          shell_up=1
          break
        fi
        sleep 0.2
      done
      if [ "$shell_up" = "0" ]; then
        echo "== linuxdroid-desktop: Plasma shell did not register within 12s; launching fallback plasmashell"
        pkill -9 -x plasmashell.real 2>/dev/null || pkill -9 -x plasmashell.distrib 2>/dev/null || pkill -9 -x plasmashell 2>/dev/null || true
        WAYLAND_DISPLAY="$wl_nested_sock" QT_QUICK_BACKEND=software LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe \
          /usr/local/bin/plasmashell >/dev/null 2>&1 &
        write_status "READY|KDE Plasma desktop ready" "== [BOOT READY] KDE Plasma desktop ready"
        for _ in $(seq 1 50); do
          if dbus-send --session --dest=org.kde.plasmashell --type=method_call --print-reply /PlasmaShell org.freedesktop.DBus.Introspectable.Introspect 2>/dev/null | grep -q "org.kde.PlasmaShell"; then
            for _ in $(seq 1 20); do
              if sync_live_kde_launchers; then
                break
              fi
              sleep 0.25
            done
            break
          fi
          sleep 0.2
        done
      fi
    ) &
    watcher_pid=$!
    trap "kill $watcher_pid 2>/dev/null || true" EXIT TERM INT
    export -n start_x11_helpers configure_kde_default_launchers sync_live_kde_launchers prune_missing_launchers 2>/dev/null || true
    startplasma-wayland
  '
  rc=$?
  echo "== linuxdroid-desktop: KDE Plasma Wayland exited (code=$rc)"
  exit "$rc"
fi

configure_xfce_scaling() {
  local scale_val="$1"
  mkdir -p "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml"
  python3 - "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml" "$scale_val" <<'PY' 2>/dev/null || true
import os
import shutil
import sys
import xml.etree.ElementTree as ET

conf_dir = sys.argv[1]
try:
    scale = max(1.0, min(3.0, float(sys.argv[2])))
except Exception:
    scale = 1.0

dpi = int(round(96.0 * scale))
gdk_scale = 2 if scale >= 1.9 else 1
cursor_size = int(round(24.0 * scale))
wm_theme = "Default-xhdpi" if scale >= 1.75 else ("Default-hdpi" if scale >= 1.25 else "Default")

def load_channel(filename, channel_name, fallback_path=None):
    target = os.path.join(conf_dir, filename)
    source = target if os.path.isfile(target) else (fallback_path if fallback_path and os.path.isfile(fallback_path) else None)
    if source:
        try:
            tree = ET.parse(source)
            return target, tree, tree.getroot()
        except Exception:
            pass
    root = ET.Element("channel", {"name": channel_name, "version": "1.0"})
    return target, ET.ElementTree(root), root

def ensure_group(parent, name):
    for child in parent.findall("property"):
        if child.get("name") == name:
            child.set("type", "empty")
            child.attrib.pop("value", None)
            return child
    el = ET.SubElement(parent, "property", {"name": name, "type": "empty"})
    return el

def set_prop(parent, name, ptype, val):
    for child in parent.findall("property"):
        if child.get("name") == name:
            child.clear()
            child.set("name", name)
            child.set("type", ptype)
            child.set("value", str(val))
            return
    ET.SubElement(parent, "property", {"name": name, "type": ptype, "value": str(val)})

# 1. xsettings.xml (DPI, Gdk/WindowScalingFactor, CursorThemeSize)
xset_target, xset_tree, xset_root = load_channel(
    "xsettings.xml",
    "xsettings",
    "/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml",
)
xft_grp = ensure_group(xset_root, "Xft")
set_prop(xft_grp, "DPI", "int", dpi)
set_prop(xft_grp, "Antialias", "int", 1)
set_prop(xft_grp, "Hinting", "int", 1)
set_prop(xft_grp, "HintStyle", "string", "hintslight")

gdk_grp = ensure_group(xset_root, "Gdk")
set_prop(gdk_grp, "WindowScalingFactor", "int", gdk_scale)

gtk_grp = ensure_group(xset_root, "Gtk")
set_prop(gtk_grp, "CursorThemeSize", "int", cursor_size)
xset_tree.write(xset_target, encoding="UTF-8", xml_declaration=True)

# 2. xfwm4.xml (compositing off + HiDPI window border theme)
xfwm_target, xfwm_tree, xfwm_root = load_channel("xfwm4.xml", "xfwm4")
gen_grp = ensure_group(xfwm_root, "general")
set_prop(gen_grp, "use_compositing", "bool", "false")
set_prop(gen_grp, "vblank_mode", "string", "off")
set_prop(gen_grp, "theme", "string", wm_theme)
xfwm_tree.write(xfwm_target, encoding="UTF-8", xml_declaration=True)

# 3. xfce4-panel.xml default pinned launchers: Settings, File Explorer (Thunar), and Chromium only
home_dir = os.path.expanduser("~")
xfce_stamp = os.path.join(home_dir, ".local", "share", "linuxdroid", "xfce-launchers-v5")
panel_target = os.path.join(conf_dir, "xfce4-panel.xml")
if not os.path.exists(xfce_stamp) or not os.path.isfile(panel_target):
    _, panel_tree, panel_root = load_channel(
        "xfce4-panel.xml",
        "xfce4-panel",
        "/etc/xdg/xfce4/panel/default.xml",
    )
    pinned_desktops = ["xfce-settings-manager.desktop", "thunar.desktop", "chromium.desktop"]
    # Browsers install on demand: on a real XFCE image, do not pin launchers whose .desktop file is missing.
    if os.path.exists("/usr/share/applications/xfce-settings-manager.desktop"):
        pinned_desktops = [d for d in pinned_desktops if os.path.exists("/usr/share/applications/" + d)]
    plugins_el = None
    panels_el = None
    for child in panel_root.findall("property"):
        if child.get("name") == "plugins":
            plugins_el = child
        elif child.get("name") == "panels":
            panels_el = child
    if plugins_el is not None:
        used_ids = set()
        for p in plugins_el.findall("property"):
            pname = p.get("name", "")
            if pname.startswith("plugin-") and pname[7:].isdigit():
                used_ids.add(int(pname[7:]))
        launcher_props = [
            p for p in plugins_el.findall("property") if p.get("value") == "launcher"
        ]
        kept_ids = []
        removed_ids = set()
        for idx, lp in enumerate(launcher_props):
            pname = lp.get("name", "")
            pid_str = pname[len("plugin-") :] if pname.startswith("plugin-") else ""
            if idx < len(pinned_desktops):
                for sub in list(lp):
                    lp.remove(sub)
                items_el = ET.SubElement(lp, "property", {"name": "items", "type": "array"})
                ET.SubElement(items_el, "value", {"type": "string", "value": pinned_desktops[idx]})
                if pid_str:
                    kept_ids.append(pid_str)
            else:
                if pid_str:
                    removed_ids.add(pid_str)
                plugins_el.remove(lp)
        added_ids = []
        next_id = max(used_ids, default=0) + 1
        for idx in range(len(launcher_props), len(pinned_desktops)):
            while next_id in used_ids:
                next_id += 1
            used_ids.add(next_id)
            pid_str = str(next_id)
            lp = ET.SubElement(plugins_el, "property", {"name": f"plugin-{pid_str}", "type": "string", "value": "launcher"})
            items_el = ET.SubElement(lp, "property", {"name": "items", "type": "array"})
            ET.SubElement(items_el, "value", {"type": "string", "value": pinned_desktops[idx]})
            added_ids.append(pid_str)
            kept_ids.append(pid_str)
        if panels_el is not None:
            all_panel_props = panels_el.findall("property")
            for p_idx, p_el in enumerate(all_panel_props):
                for prop in p_el.findall("property"):
                    if prop.get("name") == "plugin-ids":
                        for val_el in list(prop.findall("value")):
                            if val_el.get("value") in removed_ids:
                                prop.remove(val_el)
                        if added_ids and p_idx == 0:
                            vals = list(prop.findall("value"))
                            insert_pos = 1 if vals else 0
                            for vi, v in enumerate(vals):
                                if v.get("value") in kept_ids:
                                    insert_pos = vi + 1
                            for new_pid in added_ids:
                                new_val = ET.Element("value", {"type": "int", "value": new_pid})
                                prop.insert(insert_pos, new_val)
                                insert_pos += 1
        panel_launcher_dir = os.path.join(home_dir, ".config", "xfce4", "panel")
        if os.path.isdir(panel_launcher_dir):
            for entry in os.listdir(panel_launcher_dir):
                if entry.startswith("launcher-"):
                    shutil.rmtree(os.path.join(panel_launcher_dir, entry), ignore_errors=True)
        panel_tree.write(panel_target, encoding="UTF-8", xml_declaration=True)
        os.makedirs(os.path.dirname(xfce_stamp), exist_ok=True)
        open(xfce_stamp, "w").close()
PY
}

run_xwayland_desktop() {
  local session_cmd="$1"
  local desktop_name="$2"
  if ! command -v Xwayland >/dev/null 2>&1; then
    echo "ERROR: Xwayland is required for $desktop_name but is not installed." >&2
    exit 1
  fi
  local disp=":0"
  rm -f /tmp/.X0-lock /tmp/.X11-unix/X0 2>/dev/null || true

  local dpi
  dpi=$(python3 -c "print(max(96, int(round(96 * float('$SCALE')))))" 2>/dev/null || echo 96)

  boot_step 5 "Starting Xwayland display server (${WIDTH}x${HEIGHT}, scale=${SCALE})..."
  echo "== linuxdroid-desktop: starting Xwayland $disp (${WIDTH}x${HEIGHT}, dpi=${dpi}) on ${LINUXDROID_PARENT_WAYLAND} for $desktop_name"
  env LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe WAYLAND_DISPLAY="${LINUXDROID_PARENT_WAYLAND}" \
    Xwayland "$disp" -dpi "$dpi" -noreset -fullscreen -geometry "${WIDTH}x${HEIGHT}" >/tmp/linuxdroid-xwayland.log 2>&1 &
  local xw_pid=$!
  trap 'kill "$xw_pid" 2>/dev/null || true' EXIT TERM INT

  for _ in $(seq 1 100); do
    [ -S /tmp/.X11-unix/X0 ] && break
    kill -0 "$xw_pid" 2>/dev/null || break
    sleep 0.05
  done

  if [ ! -S /tmp/.X11-unix/X0 ]; then
    echo "ERROR: Xwayland failed to open /tmp/.X11-unix/X0"
    cat /tmp/linuxdroid-xwayland.log 2>/dev/null || true
    exit 1
  fi

  export DISPLAY="$disp"
  export WAYLAND_DISPLAY="wayland-off"
  export BL_FORCE_X11=1
  export XDG_SESSION_TYPE=x11
  export GDK_BACKEND=x11
  export QT_QPA_PLATFORM=xcb
  export SDL_VIDEODRIVER=x11
  export GTK_MODULES="gail:atk-bridge"
  export QT_ACCESSIBILITY=1
  export QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1
  if [ "${BL_GPU_DESKTOP:-0}" = "1" ]; then
    unset MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE
    export GALLIUM_THREAD=0
    export MESA_LOG=null
    if [ "${LINUXDROID_GPU_ACTIVE:-}" = "turnip" ]; then
      unset LIBGL_ALWAYS_SOFTWARE
      export LIBGL_KOPPER_DRI2=true
      export MESA_VK_WSI_DEBUG=sw
    elif [ "${GALLIUM_DRIVER:-}" = "virpipe" ] || [ "${GALLIUM_DRIVER:-}" = "llvmpipe" ]; then
      export LIBGL_ALWAYS_SOFTWARE=1
    elif [ -c /dev/dri/renderD128 ] && [ -r /dev/dri/renderD128 ] && [ -w /dev/dri/renderD128 ]; then
      unset LIBGL_ALWAYS_SOFTWARE
    else
      export LIBGL_ALWAYS_SOFTWARE=1
    fi
  else
    unset MESA_LOADER_DRIVER_OVERRIDE LIBGL_KOPPER_DRI2 MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER=llvmpipe
  fi

  printf 'Xft.dpi: %s\nXcursor.size: %s\n' \
    "$dpi" \
    "$(python3 -c "print(max(24, int(round(24 * float('$SCALE')))))" 2>/dev/null || echo 24)" \
    | xrdb -nocpp -merge 2>/dev/null || true

  if [ "$SCALE" != "1" ] && [ "$SCALE" != "1.0" ]; then
    export QT_AUTO_SCREEN_SCALE_FACTOR=0
    export QT_SCALE_FACTOR="$SCALE"
    export QT_FONT_DPI=96
  else
    unset QT_SCALE_FACTOR QT_FONT_DPI
  fi

  boot_step 6 "Launching ${desktop_name} desktop session..."
  (
    for i in $(seq 1 150); do
      if DISPLAY="$disp" xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q "window id"; then
        if [ "$desktop_name" != "XFCE4" ] || pgrep -f xfce4-panel >/dev/null 2>&1 || pgrep -f xfdesktop >/dev/null 2>&1 || [ "$i" -ge 20 ]; then
          sleep 0.2
          boot_ready "${desktop_name} desktop ready"
          exit 0
        fi
      fi
      sleep 0.15
    done
    boot_ready "${desktop_name} desktop ready"
  ) &
  local ready_pid=$!
  export -f start_x11_helpers
  dbus-run-session -- /bin/bash -c "
    if [ -n \"\${XDG_RUNTIME_DIR:-}\" ] && [ -n \"\${DBUS_SESSION_BUS_ADDRESS:-}\" ]; then
      printf '%s\n' \"\$DBUS_SESSION_BUS_ADDRESS\" > \"\$XDG_RUNTIME_DIR/bus-address\" 2>/dev/null || true
    fi
    if [ -x /usr/local/bin/linuxdroid-flatpak-helper ]; then
      /usr/local/bin/linuxdroid-flatpak-helper >/dev/null 2>&1 &
    fi
    start_x11_helpers '$disp' 'x11-ime'
    exec $session_cmd
  "
  local rc=$?
  kill "$ready_pid" 2>/dev/null || true
  echo "== linuxdroid-desktop: ${desktop_name} exited (code=$rc)"
  kill "$xw_pid" 2>/dev/null || true
  exit "$rc"
}

if [ "$desktop_choice" = "xfce" ]; then
  export XDG_CURRENT_DESKTOP=XFCE
  export XDG_SESSION_DESKTOP=xfce
  export DESKTOP_SESSION=xfce
  configure_xfce_scaling "$SCALE"
  if [ ! -f "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml" ]; then
    cat > "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml" <<'XFSESS'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-session" version="1.0">
  <property name="general" type="empty">
    <property name="FailsafeSessionName" type="string" value="Failsafe"/>
    <property name="SaveOnExit" type="bool" value="false"/>
  </property>
  <property name="startup" type="empty">
    <property name="ssh-agent" type="empty">
      <property name="enabled" type="bool" value="false"/>
    </property>
    <property name="gpg-agent" type="empty">
      <property name="enabled" type="bool" value="false"/>
    </property>
  </property>
</channel>
XFSESS
  fi
  run_xwayland_desktop "startxfce4" "XFCE4"
elif [ "$desktop_choice" = "lxqt" ]; then
  export XDG_CURRENT_DESKTOP=LXQt
  run_xwayland_desktop "startlxqt" "LXQt"
else
  for candidate in mate-session lxsession openbox-session xterm; do
    if command -v "$candidate" >/dev/null 2>&1; then
      run_xwayland_desktop "$candidate" "$candidate"
    fi
  done
  if command -v weston >/dev/null 2>&1; then
    boot_step 6 "Launching Weston Wayland desktop..."
    exec weston --backend=wayland-backend.so --width="$WIDTH" --height="$HEIGHT"
  fi
  echo "No supported desktop session found in rootfs; keeping shell alive."
  exec sleep infinity
fi
