if not os.path.exists(tuned_stamp):
    kdeglobals_updates["KDE"]["SingleClick"] = "false"
    kcminput_updates["Keyboard"] = {"RepeatDelay": "300", "RepeatRate": "30"}
    os.makedirs(os.path.dirname(tuned_stamp), exist_ok=True)
    with open(tuned_stamp, "w", encoding="utf-8"):
        pass
