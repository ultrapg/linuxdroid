#!/bin/bash
set -u

export BL_DESKTOP=1
export LINUXDROID_PARENT_WAYLAND="${WAYLAND_DISPLAY:-wayland-0}"
export APPIMAGE_EXTRACT_AND_RUN=1
export MOZ_DISABLE_CONTENT_SANDBOX=1
export MOZ_DISABLE_GMP_SANDBOX=1
export MOZ_DISABLE_RDD_SANDBOX=1
export MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1
export MOZ_DISABLE_UTILITY_SANDBOX=1
export MOZ_SHM_NO_SEALS=1
export ELECTRON_DISABLE_SANDBOX=1
export NO_AT_BRIDGE=1
export KDE_DEBUG=1
export QT_LOGGING_RULES="${QT_LOGGING_RULES:-*.debug=false;qt.qpa.*=false}"

WIDTH="${BL_WIDTH:-1920}"
HEIGHT="${BL_HEIGHT:-1080}"
SCALE="${BL_SCALE:-1}"

boot_step() {
  local step_num="$1"
  local msg="$2"
  echo "== [BOOT ${step_num}/6] ${msg}"
  if [ -n "${BL_BOOT_STATUS:-}" ]; then
    printf '%s|%s\n' "$step_num" "$msg" > "${BL_BOOT_STATUS}.tmp" 2>/dev/null && \
      mv -f "${BL_BOOT_STATUS}.tmp" "${BL_BOOT_STATUS}" 2>/dev/null || true
  fi
}

boot_ready() {
  local msg="$1"
  echo "== [BOOT READY] ${msg}"
  if [ -n "${BL_BOOT_STATUS:-}" ]; then
    printf 'READY|%s\n' "$msg" > "${BL_BOOT_STATUS}.tmp" 2>/dev/null && \
      mv -f "${BL_BOOT_STATUS}.tmp" "${BL_BOOT_STATUS}" 2>/dev/null || true
  fi
}

for conf in client client-rt; do
  if [ -d "/etc/pipewire" ] && [ ! -f "/etc/pipewire/$conf.conf.d/linuxdroid-rt.conf" ]; then
    linuxdroid-root sh -c "mkdir -p /etc/pipewire/$conf.conf.d && printf 'context.properties = {\n    module.rt = false\n}\n' >/etc/pipewire/$conf.conf.d/linuxdroid-rt.conf" 2>/dev/null || true
  fi
done

python3 /usr/local/bin/linuxdroid-open --install >/dev/null 2>&1 || true
update-mime-database "$HOME/.local/share/mime" >/dev/null 2>&1 &

desktop_choice="${LINUXDROID_DESKTOP:-auto}"
if [ "$desktop_choice" = "auto" ]; then
  if command -v startplasma-wayland >/dev/null 2>&1; then
    desktop_choice="kde"
  elif command -v startxfce4 >/dev/null 2>&1; then
    desktop_choice="xfce"
  elif command -v startlxqt >/dev/null 2>&1; then
    desktop_choice="lxqt"
  else
    desktop_choice="fallback"
  fi
fi

start_x11_helpers() {
  local disp="$1"
  local want_ime="${2:-}"
  (
    local chosen_disp=""
    for _ in $(seq 1 120); do
      for candidate in $disp; do
        if DISPLAY="$candidate" python3 -c "import ctypes; x=ctypes.CDLL('libX11.so.6'); x.XOpenDisplay.restype=ctypes.c_void_p; d=x.XOpenDisplay(None); raise SystemExit(0 if d else 1)" 2>/dev/null; then
          chosen_disp="$candidate"
          break 2
        fi
      done
      sleep 0.1
    done
    [ -n "$chosen_disp" ] || exit 0
    if [ -n "${BL_ANDROID_CLIPBOARD:-}" ] && [ -x /usr/local/bin/linuxdroid-clipboard ]; then
      DISPLAY="$chosen_disp" /usr/local/bin/linuxdroid-clipboard "$BL_ANDROID_CLIPBOARD" >/dev/null 2>&1 &
    fi
    if [ "$want_ime" = "x11-ime" ] && [ -x /usr/local/bin/linuxdroid-ime ]; then
      DISPLAY="$chosen_disp" /usr/local/bin/linuxdroid-ime --x11 >/dev/null 2>&1 &
    fi
    wait
  ) &
}

if [ "$desktop_choice" = "kde" ]; then
  boot_step 5 "Starting KDE Plasma Wayland compositor (${WIDTH}x${HEIGHT})..."

  export XDG_SESSION_TYPE=wayland
  export XDG_CURRENT_DESKTOP=KDE
  export XDG_SESSION_DESKTOP=KDE
  export DESKTOP_SESSION=plasma
  export KDE_FULL_SESSION=true
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    export KDE_SESSION_VERSION=6
    KWRITECONFIG=kwriteconfig6
  else
    export KDE_SESSION_VERSION=5
    KWRITECONFIG=kwriteconfig5
  fi
  export KDE_APPLICATIONS_AS_SCOPE=0
  export QT_QPA_PLATFORM="wayland;xcb"
  unset QT_QPA_PLATFORMTHEME
  export GDK_BACKEND="wayland,x11"
  export SDL_VIDEODRIVER="wayland,x11"
  export MOZ_ENABLE_WAYLAND=1
  export MOZ_USE_XINPUT2=1

  # Nested KWin Wayland uses QPainter wl_shm into LinuxDroid's Vulkan compositor so it starts
  # reliably across Snapdragon KGSL, MediaTek, and Exynos without requiring DRM/GBM modesetting.
  # Native SoC Vulkan (Turnip / Venus / PanVK) remains active via VK_ICD_FILENAMES, and full
  # hardware OpenGL is available anytime via `linuxdroid-gpu <program>`.
  export KWIN_COMPOSE=Q
  export QT_QUICK_BACKEND=software
  export GALLIUM_THREAD=0
  export KWIN_USE_OVERLAYS=0
  export KWIN_EFFECTS_FORCE_ANIMATIONS=0
  export KWIN_WAYLAND_NO_PERMISSION_CHECKS=1
  export KWIN_SCREENSHOT_NO_PERMISSION_CHECKS=1
  if [ "${GALLIUM_DRIVER:-}" = "zink" ]; then
    unset MESA_LOADER_DRIVER_OVERRIDE LIBGL_KOPPER_DRI2
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER=llvmpipe
  fi

  mkdir -p "$HOME/.local/share/applications" "$HOME/.config"
  cat > "$HOME/.local/share/applications/linuxdroid-ime.desktop" <<'ENTRY'
[Desktop Entry]
Type=Application
Name=Android Native Keyboard
Exec=/usr/local/bin/linuxdroid-ime
NoDisplay=true
X-KDE-Wayland-VirtualKeyboard=true
ENTRY

  if command -v "$KWRITECONFIG" >/dev/null 2>&1; then
    "$KWRITECONFIG" --file plasma-localerc --group Formats --key LANG "${LANG:-C.UTF-8}" 2>/dev/null || true
    "$KWRITECONFIG" --file kwinrc --group Wayland --key InputMethod "$HOME/.local/share/applications/linuxdroid-ime.desktop" 2>/dev/null || true
    "$KWRITECONFIG" --file kscreenlockerrc --group Daemon --key Autolock false 2>/dev/null || true
    "$KWRITECONFIG" --file kscreenlockerrc --group Daemon --key LockOnResume false 2>/dev/null || true
    "$KWRITECONFIG" --file kdeglobals --group KDE --key AnimationDurationFactor 0 2>/dev/null || true
    if [ "$SCALE" != "1" ] && [ "$SCALE" != "1.0" ]; then
      dpi=$(python3 -c "print(int(round(96 * float('$SCALE'))))" 2>/dev/null || echo 96)
      "$KWRITECONFIG" --file kcmfonts --group General --key forceFontDPI "$dpi" 2>/dev/null || true
    else
      "$KWRITECONFIG" --file kcmfonts --group General --key forceFontDPI 0 2>/dev/null || true
    fi
  fi

  start_x11_helpers ":0 :1" ""
  echo "== linuxdroid-desktop: starting KDE Plasma Wayland (${WIDTH}x${HEIGHT}, scale=${SCALE}, KWIN_COMPOSE=${KWIN_COMPOSE})"
  dbus-run-session -- /bin/bash -c '
    write_status() {
      echo "$2"
      if [ -n "${BL_BOOT_STATUS:-}" ]; then
        printf "%s\n" "$1" > "${BL_BOOT_STATUS}.tmp" 2>/dev/null && \
          mv -f "${BL_BOOT_STATUS}.tmp" "${BL_BOOT_STATUS}" 2>/dev/null || true
      fi
    }
    (
      for _ in $(seq 1 150); do
        if [ -S "$XDG_RUNTIME_DIR/wayland-1" ]; then
          for kamd in /usr/lib/*/libexec/kactivitymanagerd /usr/lib/kactivitymanagerd /usr/libexec/kactivitymanagerd; do
            if [ -x "$kamd" ]; then
              WAYLAND_DISPLAY=wayland-1 "$kamd" >/dev/null 2>&1 &
              break
            fi
          done
          write_status "6|Loading KDE Plasma desktop shell & panels..." "== [BOOT 6/6] Loading KDE Plasma desktop shell & panels..."
          break
        fi
        sleep 0.1
      done
      for _ in $(seq 1 300); do
        if dbus-send --session --dest=org.kde.plasmashell --type=method_call --print-reply /PlasmaShell org.freedesktop.DBus.Introspectable.Introspect 2>/dev/null | grep -q "org.kde.PlasmaShell"; then
          sleep 1.2
          write_status "READY|KDE Plasma desktop ready" "== [BOOT READY] KDE Plasma desktop ready"
          break
        fi
        sleep 0.25
      done
    ) &
    watcher_pid=$!
    trap "kill $watcher_pid 2>/dev/null || true" EXIT TERM INT
    startplasma-wayland
  '
  rc=$?
  echo "== linuxdroid-desktop: KDE Plasma Wayland exited (code=$rc)"
  exit "$rc"
fi

run_xwayland_desktop() {
  local session_cmd="$1"
  local desktop_name="$2"
  if ! command -v Xwayland >/dev/null 2>&1; then
    echo "ERROR: Xwayland is required for $desktop_name but is not installed." >&2
    exit 1
  fi
  local disp=":0"
  rm -f /tmp/.X0-lock /tmp/.X11-unix/X0 2>/dev/null || true

  boot_step 5 "Starting Xwayland display server (${WIDTH}x${HEIGHT})..."
  echo "== linuxdroid-desktop: starting Xwayland $disp (${WIDTH}x${HEIGHT}) on ${LINUXDROID_PARENT_WAYLAND} for $desktop_name"
  env LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe WAYLAND_DISPLAY="${LINUXDROID_PARENT_WAYLAND}" \
    Xwayland "$disp" -noreset -fullscreen -geometry "${WIDTH}x${HEIGHT}" >/tmp/linuxdroid-xwayland.log 2>&1 &
  local xw_pid=$!
  trap 'kill "$xw_pid" 2>/dev/null || true' EXIT TERM INT

  for _ in $(seq 1 100); do
    [ -S /tmp/.X11-unix/X0 ] && break
    kill -0 "$xw_pid" 2>/dev/null || break
    sleep 0.05
  done

  if [ ! -S /tmp/.X11-unix/X0 ]; then
    echo "ERROR: Xwayland failed to open /tmp/.X11-unix/X0"
    cat /tmp/linuxdroid-xwayland.log 2>/dev/null || true
    exit 1
  fi

  export DISPLAY="$disp"
  unset WAYLAND_DISPLAY
  export XDG_SESSION_TYPE=x11
  export GDK_BACKEND=x11
  export QT_QPA_PLATFORM=xcb
  export SDL_VIDEODRIVER=x11
  export MOZ_ENABLE_WAYLAND=0

  if [ "$SCALE" != "1" ] && [ "$SCALE" != "1.0" ]; then
    local dpi
    dpi=$(python3 -c "print(int(round(96 * float('$SCALE'))))" 2>/dev/null || echo 96)
    printf 'Xft.dpi: %s\n' "$dpi" | xrdb -nocpp -merge 2>/dev/null || true
    export GDK_SCALE=1
    export QT_FONT_DPI="$dpi"
  fi

  boot_step 6 "Launching ${desktop_name} desktop session..."
  start_x11_helpers "$disp" "x11-ime"
  (
    for i in $(seq 1 150); do
      if DISPLAY="$disp" xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q "window id"; then
        if [ "$desktop_name" != "XFCE4" ] || pgrep -u "$(id -u)" -x xfdesktop >/dev/null 2>&1 || [ "$i" -ge 60 ]; then
          sleep 0.4
          boot_ready "${desktop_name} desktop ready"
          exit 0
        fi
      fi
      sleep 0.2
    done
    boot_ready "${desktop_name} desktop ready"
  ) &
  local ready_pid=$!
  dbus-run-session -- $session_cmd
  local rc=$?
  kill "$ready_pid" 2>/dev/null || true
  echo "== linuxdroid-desktop: ${desktop_name} exited (code=$rc)"
  kill "$xw_pid" 2>/dev/null || true
  exit "$rc"
}

if [ "$desktop_choice" = "xfce" ]; then
  export XDG_CURRENT_DESKTOP=XFCE
  export XDG_SESSION_DESKTOP=xfce
  export DESKTOP_SESSION=xfce
  mkdir -p "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml"
  if [ ! -f "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml" ]; then
    cat > "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml" <<'XFWM'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="use_compositing" type="bool" value="false"/>
    <property name="vblank_mode" type="string" value="off"/>
  </property>
</channel>
XFWM
  fi
  if [ ! -f "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml" ]; then
    cat > "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml" <<'XFSESS'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-session" version="1.0">
  <property name="general" type="empty">
    <property name="FailsafeSessionName" type="string" value="Failsafe"/>
    <property name="SaveOnExit" type="bool" value="false"/>
  </property>
  <property name="startup" type="empty">
    <property name="ssh-agent" type="empty">
      <property name="enabled" type="bool" value="false"/>
    </property>
    <property name="gpg-agent" type="empty">
      <property name="enabled" type="bool" value="false"/>
    </property>
  </property>
</channel>
XFSESS
  fi
  run_xwayland_desktop "startxfce4" "XFCE4"
elif [ "$desktop_choice" = "lxqt" ]; then
  export XDG_CURRENT_DESKTOP=LXQt
  run_xwayland_desktop "startlxqt" "LXQt"
else
  for candidate in mate-session lxsession openbox-session xterm; do
    if command -v "$candidate" >/dev/null 2>&1; then
      run_xwayland_desktop "$candidate" "$candidate"
    fi
  done
  if command -v weston >/dev/null 2>&1; then
    boot_step 6 "Launching Weston Wayland desktop..."
    exec weston --backend=wayland-backend.so --width="$WIDTH" --height="$HEIGHT"
  fi
  echo "No supported desktop session found in rootfs; keeping shell alive."
  exec sleep infinity
fi
