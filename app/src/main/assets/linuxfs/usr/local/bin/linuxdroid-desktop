#!/bin/bash
set -u

export BL_DESKTOP=1
export LINUXDROID_PARENT_WAYLAND="${WAYLAND_DISPLAY:-wayland-0}"
export FLATPAK_BWRAP="/usr/local/bin/bwrap"
export XDG_DATA_DIRS="${HOME:-/home/linux}/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export APPIMAGE_EXTRACT_AND_RUN=1
export KDE_DEBUG=1
export QT_LOGGING_RULES="${QT_LOGGING_RULES:-*.debug=false;qt.qpa.*=false}"
export GTK_USE_PORTAL=0
export GDK_DEBUG=no-portals
export ELECTRON_DISABLE_SANDBOX=1
export QTWEBENGINE_DISABLE_SANDBOX=1
export MOZ_FORCE_DISABLE_E10S=1
export MOZ_SHM_NO_SEALS=1
export MOZ_FAKE_NO_SANDBOX=1
export MOZ_DISABLE_CONTENT_SANDBOX=1
export MOZ_DISABLE_GMP_SANDBOX=1
export MOZ_DISABLE_RDD_SANDBOX=1
export MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1
export MOZ_DISABLE_UTILITY_SANDBOX=1
export MOZ_DISABLE_GPU_SANDBOX=1
export MOZ_DISABLE_NPAPI_SANDBOX=1
export MOZ_ASSUME_USER_NS=0
export MOZ_CRASHREPORTER_DISABLE=1

WIDTH="${BL_WIDTH:-1920}"
HEIGHT="${BL_HEIGHT:-1080}"
PIXEL_WIDTH="${BL_PIXEL_WIDTH:-$WIDTH}"
PIXEL_HEIGHT="${BL_PIXEL_HEIGHT:-$HEIGHT}"
SCALE="${BL_SCALE:-1}"

boot_step() {
  local step_num="$1"
  local msg="$2"
  echo "== [BOOT ${step_num}/6] ${msg}"
  if [ -n "${BL_BOOT_STATUS:-}" ]; then
    printf '%s|%s\n' "$step_num" "$msg" > "${BL_BOOT_STATUS}.tmp" 2>/dev/null && \
      mv -f "${BL_BOOT_STATUS}.tmp" "${BL_BOOT_STATUS}" 2>/dev/null || true
  fi
}

boot_ready() {
  local msg="$1"
  echo "== [BOOT READY] ${msg}"
  if [ -n "${BL_BOOT_STATUS:-}" ]; then
    printf 'READY|%s\n' "$msg" > "${BL_BOOT_STATUS}.tmp" 2>/dev/null && \
      mv -f "${BL_BOOT_STATUS}.tmp" "${BL_BOOT_STATUS}" 2>/dev/null || true
  fi
}

for conf in client client-rt; do
  if [ -d "/etc/pipewire" ] && [ ! -f "/etc/pipewire/$conf.conf.d/linuxdroid-rt.conf" ]; then
    linuxdroid-root sh -c "mkdir -p /etc/pipewire/$conf.conf.d && printf 'context.properties = {\n    module.rt = false\n}\n' >/etc/pipewire/$conf.conf.d/linuxdroid-rt.conf" 2>/dev/null || true
  fi
done

python3 /usr/local/bin/linuxdroid-open --install >/dev/null 2>&1 || true
update-mime-database "$HOME/.local/share/mime" >/dev/null 2>&1 &

desktop_choice="${LINUXDROID_DESKTOP:-auto}"
if [ "$desktop_choice" = "auto" ]; then
  if command -v startplasma-wayland >/dev/null 2>&1; then
    desktop_choice="kde"
  elif command -v startxfce4 >/dev/null 2>&1; then
    desktop_choice="xfce"
  elif command -v startlxqt >/dev/null 2>&1; then
    desktop_choice="lxqt"
  else
    desktop_choice="fallback"
  fi
fi

start_x11_helpers() {
  local disp="$1"
  local want_ime="${2:-}"
  (
    local chosen_disp=""
    for _ in $(seq 1 120); do
      for candidate in $disp; do
        if DISPLAY="$candidate" python3 -c "import ctypes; x=ctypes.CDLL('libX11.so.6'); x.XOpenDisplay.restype=ctypes.c_void_p; d=x.XOpenDisplay(None); raise SystemExit(0 if d else 1)" 2>/dev/null; then
          chosen_disp="$candidate"
          break 2
        fi
      done
      sleep 0.1
    done
    [ -n "$chosen_disp" ] || exit 0
    if [ -n "${BL_ANDROID_CLIPBOARD:-}" ] && [ -x /usr/local/bin/linuxdroid-clipboard ]; then
      DISPLAY="$chosen_disp" /usr/local/bin/linuxdroid-clipboard "$BL_ANDROID_CLIPBOARD" >/dev/null 2>&1 &
    fi
    if [ "$want_ime" = "x11-ime" ] && [ -x /usr/local/bin/linuxdroid-ime ]; then
      DISPLAY="$chosen_disp" /usr/local/bin/linuxdroid-ime --x11 >/dev/null 2>&1 &
    fi
    wait
  ) &
}

# Remove task manager launchers whose .desktop file is not installed (Plasma's default pins Discover,
# which would show up as a blank icon). Handles existing configs on disk and the live shell config.
prune_missing_launchers() {
  local rc="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
  local stamp="$HOME/.local/share/linuxdroid/launchers-v2" first=1
  [ -e "$stamp" ] && first=0
  if [ -f "$rc" ]; then
    if [ ! -e /usr/share/applications/org.kde.discover.desktop ]; then
      sed -i -E '/^launchers=/ { s#,applications:org\.kde\.discover\.desktop##g; s#=applications:org\.kde\.discover\.desktop,?#=#; }' "$rc" 2>/dev/null || true
    fi
    # An empty launchers list hides every pinned icon; drop it so Plasma falls back to its defaults.
    sed -i '/^launchers=$/d' "$rc" 2>/dev/null || true
  fi
  local js='
    var defaults = "applications:systemsettings.desktop,applications:org.kde.discover.desktop,preferred://filemanager,preferred://browser";
    var dropDiscover = '"$([ -e /usr/share/applications/org.kde.discover.desktop ] && echo false || echo true)"';
    var repairEmpty = '"$([ "$first" = 1 ] && echo true || echo false)"';
    var ps = panels();
    for (var i = 0; i < ps.length; i++) {
      var ws = ps[i].widgets();
      for (var j = 0; j < ws.length; j++) {
        var w = ws[j];
        if (w.type == "org.kde.plasma.icontasks" || w.type == "org.kde.plasma.taskmanager") {
          w.currentConfigGroup = ["General"];
          var cur = String(w.readConfig("launchers", defaults));
          if (cur.length == 0 && repairEmpty) { cur = defaults; }
          if (cur.length == 0) { continue; }
          var keep = cur.split(",").filter(function (l) {
            return l.length > 0 && !(dropDiscover && l.indexOf("org.kde.discover.desktop") >= 0);
          });
          if (keep.length > 0 && keep.join(",") != cur) { w.writeConfig("launchers", keep.join(",")); }
          else if (keep.length > 0 && String(w.readConfig("launchers", "")).length == 0) { w.writeConfig("launchers", keep.join(",")); }
        }
      }
    }'
  dbus-send --session --dest=org.kde.plasmashell --type=method_call /PlasmaShell \
    org.kde.PlasmaShell.evaluateScript string:"$js" >/dev/null 2>&1 || true
}

if [ "$desktop_choice" = "kde" ]; then
  prune_missing_launchers
  boot_step 5 "Starting KDE Plasma Wayland compositor (${PIXEL_WIDTH}x${PIXEL_HEIGHT}, scale=${SCALE})..."

  export XDG_SESSION_TYPE=wayland
  export XDG_CURRENT_DESKTOP=KDE
  export XDG_SESSION_DESKTOP=KDE
  export DESKTOP_SESSION=plasma
  export KDE_FULL_SESSION=true
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    export KDE_SESSION_VERSION=6
    KWRITECONFIG=kwriteconfig6
  else
    export KDE_SESSION_VERSION=5
    KWRITECONFIG=kwriteconfig5
  fi
  export KDE_APPLICATIONS_AS_SCOPE=0
  export QT_QPA_PLATFORM="wayland;xcb"
  unset QT_QPA_PLATFORMTHEME
  export GDK_BACKEND="wayland,x11"
  export SDL_VIDEODRIVER="wayland,x11"

  # Nested KWin Wayland uses QPainter wl_shm into LinuxDroid's Vulkan compositor so it starts
  # reliably across Snapdragon KGSL, MediaTek, and Exynos without requiring DRM/GBM modesetting.
  # Native SoC Vulkan (Turnip / Venus / PanVK) remains active via VK_ICD_FILENAMES, and full
  # hardware OpenGL is available anytime via `linuxdroid-gpu <program>`.
  export KWIN_COMPOSE=Q
  export QT_QUICK_BACKEND=software
  export GALLIUM_THREAD=0
  export KWIN_USE_OVERLAYS=0
  export KWIN_EFFECTS_FORCE_ANIMATIONS=0
  export KWIN_WAYLAND_NO_PERMISSION_CHECKS=1
  export KWIN_SCREENSHOT_NO_PERMISSION_CHECKS=1
  if [ "${GALLIUM_DRIVER:-}" = "zink" ]; then
    unset MESA_LOADER_DRIVER_OVERRIDE LIBGL_KOPPER_DRI2
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER=llvmpipe
  fi

  mkdir -p "$HOME/.local/share/applications" "$HOME/.config"
  cat > "$HOME/.local/share/applications/linuxdroid-ime.desktop" <<'ENTRY'
[Desktop Entry]
Type=Application
Name=Android Native Keyboard
Exec=/usr/local/bin/linuxdroid-ime
NoDisplay=true
X-KDE-Wayland-VirtualKeyboard=true
ENTRY

  if command -v "$KWRITECONFIG" >/dev/null 2>&1; then
    cursor_px=$(python3 -c "print(max(24, int(round(24 * float('$SCALE')))))" 2>/dev/null || echo 24)
    "$KWRITECONFIG" --file plasma-localerc --group Formats --key LANG "${LANG:-C.UTF-8}" 2>/dev/null || true
    "$KWRITECONFIG" --file kwinrc --group Wayland --key InputMethod "$HOME/.local/share/applications/linuxdroid-ime.desktop" 2>/dev/null || true
    "$KWRITECONFIG" --file kwinrc --group Wayland --key VirtualKeyboardEnabled true 2>/dev/null || true
    "$KWRITECONFIG" --file kwinrc --group Xwayland --key Scale "$SCALE" 2>/dev/null || true
    "$KWRITECONFIG" --file kcminputrc --group Mouse --key cursorSize "$cursor_px" 2>/dev/null || true
    "$KWRITECONFIG" --file kscreenlockerrc --group Daemon --key Autolock false 2>/dev/null || true
    "$KWRITECONFIG" --file kscreenlockerrc --group Daemon --key LockOnResume false 2>/dev/null || true
    "$KWRITECONFIG" --file kdeglobals --group KDE --key AnimationDurationFactor 0 2>/dev/null || true
    # KWin Wayland applies native --scale $SCALE directly to Wayland outputs, so forceFontDPI must stay 0
    # to avoid double-multiplying font sizes.
    "$KWRITECONFIG" --file kcmfonts --group General --key forceFontDPI 0 2>/dev/null || true
    # One-time desktop-style defaults (applied once so later user changes are kept): double-click to open
    # files, and a snappy hardware keyboard repeat rate for external keyboards.
    tuned_stamp="$HOME/.local/share/linuxdroid/desktop-tuned-v1"
    if [ ! -e "$tuned_stamp" ]; then
      "$KWRITECONFIG" --file kdeglobals --group KDE --key SingleClick false 2>/dev/null || true
      "$KWRITECONFIG" --file kcminputrc --group Keyboard --key RepeatDelay 300 2>/dev/null || true
      "$KWRITECONFIG" --file kcminputrc --group Keyboard --key RepeatRate 30 2>/dev/null || true
      mkdir -p "${tuned_stamp%/*}" && : > "$tuned_stamp"
    fi
  fi

  echo "== linuxdroid-desktop: starting KDE Plasma Wayland (logical=${WIDTH}x${HEIGHT}, pixel=${PIXEL_WIDTH}x${PIXEL_HEIGHT}, scale=${SCALE}, KWIN_COMPOSE=${KWIN_COMPOSE})"
  export -f start_x11_helpers prune_missing_launchers
  dbus-run-session -- /bin/bash -c '
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
      printf "%s\n" "$DBUS_SESSION_BUS_ADDRESS" > "$XDG_RUNTIME_DIR/bus-address" 2>/dev/null || true
    fi
    write_status() {
      echo "$2"
      if [ -n "${BL_BOOT_STATUS:-}" ]; then
        printf "%s\n" "$1" > "${BL_BOOT_STATUS}.tmp" 2>/dev/null && \
          mv -f "${BL_BOOT_STATUS}.tmp" "${BL_BOOT_STATUS}" 2>/dev/null || true
      fi
    }
    start_x11_helpers ":0 :1" ""
    (
      for _ in $(seq 1 150); do
        if [ -S "$XDG_RUNTIME_DIR/wayland-1" ]; then
          for kamd in /usr/lib/*/libexec/kactivitymanagerd /usr/lib/kactivitymanagerd /usr/libexec/kactivitymanagerd; do
            if [ -x "$kamd" ]; then
              WAYLAND_DISPLAY=wayland-1 "$kamd" >/dev/null 2>&1 &
              break
            fi
          done
          write_status "6|Loading KDE Plasma desktop shell & panels..." "== [BOOT 6/6] Loading KDE Plasma desktop shell & panels..."
          break
        fi
        sleep 0.1
      done
      for _ in $(seq 1 300); do
        if dbus-send --session --dest=org.kde.plasmashell --type=method_call --print-reply /PlasmaShell org.freedesktop.DBus.Introspectable.Introspect 2>/dev/null | grep -q "org.kde.PlasmaShell"; then
          dbus-send --session --dest=org.kde.KWin --type=method_call /VirtualKeyboard org.freedesktop.DBus.Properties.Set string:"org.kde.kwin.VirtualKeyboard" string:"enabled" variant:boolean:true >/dev/null 2>&1 || true
          sleep 0.2
          prune_missing_launchers
          mkdir -p "$HOME/.local/share/linuxdroid" && : > "$HOME/.local/share/linuxdroid/launchers-v2"
          write_status "READY|KDE Plasma desktop ready" "== [BOOT READY] KDE Plasma desktop ready"
          break
        fi
        sleep 0.2
      done
    ) &
    watcher_pid=$!
    trap "kill $watcher_pid 2>/dev/null || true" EXIT TERM INT
    startplasma-wayland
  '
  rc=$?
  echo "== linuxdroid-desktop: KDE Plasma Wayland exited (code=$rc)"
  exit "$rc"
fi

configure_xfce_scaling() {
  local scale_val="$1"
  mkdir -p "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml"
  python3 - "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml" "$scale_val" <<'PY' 2>/dev/null || true
import os
import sys
import xml.etree.ElementTree as ET

conf_dir = sys.argv[1]
try:
    scale = max(1.0, min(3.0, float(sys.argv[2])))
except Exception:
    scale = 1.0

dpi = int(round(96.0 * scale))
gdk_scale = 2 if scale >= 1.9 else 1
cursor_size = int(round(24.0 * scale))
wm_theme = "Default-xhdpi" if scale >= 1.75 else ("Default-hdpi" if scale >= 1.25 else "Default")

def load_channel(filename, channel_name, fallback_path=None):
    target = os.path.join(conf_dir, filename)
    source = target if os.path.isfile(target) else (fallback_path if fallback_path and os.path.isfile(fallback_path) else None)
    if source:
        try:
            tree = ET.parse(source)
            return target, tree, tree.getroot()
        except Exception:
            pass
    root = ET.Element("channel", {"name": channel_name, "version": "1.0"})
    return target, ET.ElementTree(root), root

def ensure_group(parent, name):
    for child in parent.findall("property"):
        if child.get("name") == name:
            child.set("type", "empty")
            child.attrib.pop("value", None)
            return child
    el = ET.SubElement(parent, "property", {"name": name, "type": "empty"})
    return el

def set_prop(parent, name, ptype, val):
    for child in parent.findall("property"):
        if child.get("name") == name:
            child.clear()
            child.set("name", name)
            child.set("type", ptype)
            child.set("value", str(val))
            return
    ET.SubElement(parent, "property", {"name": name, "type": ptype, "value": str(val)})

# 1. xsettings.xml (DPI, Gdk/WindowScalingFactor, CursorThemeSize)
xset_target, xset_tree, xset_root = load_channel(
    "xsettings.xml",
    "xsettings",
    "/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml",
)
xft_grp = ensure_group(xset_root, "Xft")
set_prop(xft_grp, "DPI", "int", dpi)
set_prop(xft_grp, "Antialias", "int", 1)
set_prop(xft_grp, "Hinting", "int", 1)
set_prop(xft_grp, "HintStyle", "string", "hintslight")

gdk_grp = ensure_group(xset_root, "Gdk")
set_prop(gdk_grp, "WindowScalingFactor", "int", gdk_scale)

gtk_grp = ensure_group(xset_root, "Gtk")
set_prop(gtk_grp, "CursorThemeSize", "int", cursor_size)
xset_tree.write(xset_target, encoding="UTF-8", xml_declaration=True)

# 2. xfwm4.xml (compositing off + HiDPI window border theme)
xfwm_target, xfwm_tree, xfwm_root = load_channel("xfwm4.xml", "xfwm4")
gen_grp = ensure_group(xfwm_root, "general")
set_prop(gen_grp, "use_compositing", "bool", "false")
set_prop(gen_grp, "vblank_mode", "string", "off")
set_prop(gen_grp, "theme", "string", wm_theme)
xfwm_tree.write(xfwm_target, encoding="UTF-8", xml_declaration=True)
PY
}

run_xwayland_desktop() {
  local session_cmd="$1"
  local desktop_name="$2"
  if ! command -v Xwayland >/dev/null 2>&1; then
    echo "ERROR: Xwayland is required for $desktop_name but is not installed." >&2
    exit 1
  fi
  local disp=":0"
  rm -f /tmp/.X0-lock /tmp/.X11-unix/X0 2>/dev/null || true

  local dpi
  dpi=$(python3 -c "print(max(96, int(round(96 * float('$SCALE')))))" 2>/dev/null || echo 96)

  boot_step 5 "Starting Xwayland display server (${WIDTH}x${HEIGHT}, scale=${SCALE})..."
  echo "== linuxdroid-desktop: starting Xwayland $disp (${WIDTH}x${HEIGHT}, dpi=${dpi}) on ${LINUXDROID_PARENT_WAYLAND} for $desktop_name"
  env LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe WAYLAND_DISPLAY="${LINUXDROID_PARENT_WAYLAND}" \
    Xwayland "$disp" -dpi "$dpi" -noreset -fullscreen -geometry "${WIDTH}x${HEIGHT}" >/tmp/linuxdroid-xwayland.log 2>&1 &
  local xw_pid=$!
  trap 'kill "$xw_pid" 2>/dev/null || true' EXIT TERM INT

  for _ in $(seq 1 100); do
    [ -S /tmp/.X11-unix/X0 ] && break
    kill -0 "$xw_pid" 2>/dev/null || break
    sleep 0.05
  done

  if [ ! -S /tmp/.X11-unix/X0 ]; then
    echo "ERROR: Xwayland failed to open /tmp/.X11-unix/X0"
    cat /tmp/linuxdroid-xwayland.log 2>/dev/null || true
    exit 1
  fi

  export DISPLAY="$disp"
  unset WAYLAND_DISPLAY
  export XDG_SESSION_TYPE=x11
  export GDK_BACKEND=x11
  export QT_QPA_PLATFORM=xcb
  export SDL_VIDEODRIVER=x11
  export GTK_MODULES="gail:atk-bridge"
  export QT_ACCESSIBILITY=1
  export QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1

  printf 'Xft.dpi: %s\nXcursor.size: %s\n' \
    "$dpi" \
    "$(python3 -c "print(max(24, int(round(24 * float('$SCALE')))))" 2>/dev/null || echo 24)" \
    | xrdb -nocpp -merge 2>/dev/null || true

  if [ "$SCALE" != "1" ] && [ "$SCALE" != "1.0" ]; then
    export QT_AUTO_SCREEN_SCALE_FACTOR=0
    export QT_SCALE_FACTOR="$SCALE"
    export QT_FONT_DPI=96
  else
    unset QT_SCALE_FACTOR QT_FONT_DPI
  fi

  boot_step 6 "Launching ${desktop_name} desktop session..."
  (
    for i in $(seq 1 150); do
      if DISPLAY="$disp" xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q "window id"; then
        if [ "$desktop_name" != "XFCE4" ] || pgrep -f xfce4-panel >/dev/null 2>&1 || pgrep -f xfdesktop >/dev/null 2>&1 || [ "$i" -ge 20 ]; then
          sleep 0.2
          boot_ready "${desktop_name} desktop ready"
          exit 0
        fi
      fi
      sleep 0.15
    done
    boot_ready "${desktop_name} desktop ready"
  ) &
  local ready_pid=$!
  export -f start_x11_helpers
  dbus-run-session -- /bin/bash -c "
    if [ -n \"\${XDG_RUNTIME_DIR:-}\" ] && [ -n \"\${DBUS_SESSION_BUS_ADDRESS:-}\" ]; then
      printf '%s\n' \"\$DBUS_SESSION_BUS_ADDRESS\" > \"\$XDG_RUNTIME_DIR/bus-address\" 2>/dev/null || true
    fi
    start_x11_helpers '$disp' 'x11-ime'
    exec $session_cmd
  "
  local rc=$?
  kill "$ready_pid" 2>/dev/null || true
  echo "== linuxdroid-desktop: ${desktop_name} exited (code=$rc)"
  kill "$xw_pid" 2>/dev/null || true
  exit "$rc"
}

if [ "$desktop_choice" = "xfce" ]; then
  export XDG_CURRENT_DESKTOP=XFCE
  export XDG_SESSION_DESKTOP=xfce
  export DESKTOP_SESSION=xfce
  configure_xfce_scaling "$SCALE"
  if [ ! -f "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml" ]; then
    cat > "$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml" <<'XFSESS'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-session" version="1.0">
  <property name="general" type="empty">
    <property name="FailsafeSessionName" type="string" value="Failsafe"/>
    <property name="SaveOnExit" type="bool" value="false"/>
  </property>
  <property name="startup" type="empty">
    <property name="ssh-agent" type="empty">
      <property name="enabled" type="bool" value="false"/>
    </property>
    <property name="gpg-agent" type="empty">
      <property name="enabled" type="bool" value="false"/>
    </property>
  </property>
</channel>
XFSESS
  fi
  run_xwayland_desktop "startxfce4" "XFCE4"
elif [ "$desktop_choice" = "lxqt" ]; then
  export XDG_CURRENT_DESKTOP=LXQt
  run_xwayland_desktop "startlxqt" "LXQt"
else
  for candidate in mate-session lxsession openbox-session xterm; do
    if command -v "$candidate" >/dev/null 2>&1; then
      run_xwayland_desktop "$candidate" "$candidate"
    fi
  done
  if command -v weston >/dev/null 2>&1; then
    boot_step 6 "Launching Weston Wayland desktop..."
    exec weston --backend=wayland-backend.so --width="$WIDTH" --height="$HEIGHT"
  fi
  echo "No supported desktop session found in rootfs; keeping shell alive."
  exec sleep infinity
fi
