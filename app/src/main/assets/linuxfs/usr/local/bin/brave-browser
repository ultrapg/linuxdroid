#!/bin/bash
# LinuxDroid: Chromium-based browsers cannot create their namespace sandbox under PRoot, so launch the real
# binary (found later in PATH) with the sandbox disabled.
name="$(basename "$0")"
IFS=: read -ra dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  [ "$d" = "/usr/local/bin" ] && continue
  if [ -x "$d/$name" ]; then
    for arg in "$@"; do
      case "$arg" in
        --version|-v|--help|-h) exec "$d/$name" "$@" ;;
      esac
    done
    flags=(--no-sandbox --no-zygote --disable-gpu-sandbox --disable-dev-shm-usage)
    if [ "${BL_GPU_APPS:-0}" = "1" ]; then
      flags+=(--ignore-gpu-blocklist --enable-gpu-rasterization --enable-zero-copy)
      exec /usr/local/bin/linuxdroid-gpu-launch "$d/$name" "${flags[@]}" "$@"
    fi
    exec "$d/$name" "${flags[@]}" "$@"
  fi
done
echo "$name: command not found" >&2
exit 127
