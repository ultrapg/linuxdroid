install_dev_tools() {
  echo "==> Installing C/C++, CMake, Python & Node.js 22 LTS Build Toolchain..."
  ensure_repo_prereqs
  sudo sh -c '
    set -e
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor --yes -o /usr/share/keyrings/nodesource.gpg
    chmod 644 /usr/share/keyrings/nodesource.gpg
    echo "deb [arch=arm64 signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list
  '
  # NodeSource nodejs 22 bundles npm/npx/corepack and conflicts with Ubuntu universe separate npm/libnode-dev
  if dpkg-query -W -f='${db:Status-Status}' npm 2>/dev/null | grep -qx "installed"; then
    sudo env DEBIAN_FRONTEND=noninteractive apt-get remove -y npm libnode-dev 2>/dev/null || true
  fi
  apt_install build-essential cmake ninja-build pkg-config gdb python3-pip python3-venv nodejs
  echo "==> Toolchain installed (Node $(node --version 2>/dev/null || echo 22.x))."
}

install_rust() {
  echo "==> Installing Latest Stable Rust Toolchain via official rustup..."
  apt_install ca-certificates curl build-essential pkg-config libssl-dev
  if dpkg-query -W -f='${db:Status-Status}' rustc 2>/dev/null | grep -qx "installed"; then
    sudo env DEBIAN_FRONTEND=noninteractive apt-get remove -y rustc cargo 2>/dev/null || true
  fi
  sudo sh -c '
    set -e
    export RUSTUP_HOME=/usr/local/rustup
    export CARGO_HOME=/usr/local/cargo
    mkdir -p "$RUSTUP_HOME" "$CARGO_HOME"
    curl --proto "=https" --tlsv1.2 -fsSL https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile default --default-toolchain stable
    chmod -R a+rX "$RUSTUP_HOME" "$CARGO_HOME"
    for bin in "$CARGO_HOME"/bin/*; do
      [ -x "$bin" ] && ln -sfn "$bin" "/usr/local/bin/$(basename "$bin")"
    done
  '
  echo "==> $(/usr/local/bin/rustc --version 2>/dev/null || echo 'Rust stable') installed!"
}

install_golang() {
  echo "==> Installing Latest Official Go Toolchain (go.dev ARM64)..."
  apt_install ca-certificates curl tar
  if dpkg-query -W -f='${db:Status-Status}' golang-go 2>/dev/null | grep -qx "installed"; then
    sudo env DEBIAN_FRONTEND=noninteractive apt-get remove -y golang-go golang-src 2>/dev/null || true
  fi
  local go_meta go_url go_sha tmp_go actual_sha
  go_meta="$(python3 -B -c '
import json, urllib.request
req = urllib.request.Request("https://go.dev/dl/?mode=json", headers={"User-Agent": "LinuxDroid-Apps/1.0"})
with urllib.request.urlopen(req, timeout=10) as r:
    releases = json.loads(r.read().decode("utf-8"))
for rel in releases:
    if not rel.get("stable"):
        continue
    for f in rel.get("files", []):
        if f.get("os") == "linux" and f.get("arch") == "arm64" and f.get("kind") == "archive":
            print("https://go.dev/dl/" + f["filename"] + "|" + f.get("sha256", ""))
            raise SystemExit(0)
raise SystemExit(1)
')"
  go_url="${go_meta%%|*}"
  go_sha="${go_meta#*|}"
  tmp_go="$(mktemp --suffix=.tar.gz)"
  echo "==> Downloading ${go_url} ..."
  curl -fL --retry 3 "$go_url" -o "$tmp_go"
  if [ -n "$go_sha" ]; then
    actual_sha="$(sha256sum "$tmp_go" | awk '{print $1}')"
    if [ "$actual_sha" != "$go_sha" ]; then
      rm -f "$tmp_go"
      echo "ERROR: Go archive SHA-256 mismatch (expected $go_sha, got $actual_sha)" >&2
      return 1
    fi
  fi
  sudo rm -rf /usr/local/go
  sudo tar -C /usr/local -xzf "$tmp_go"
  rm -f "$tmp_go"
  sudo ln -sfn /usr/local/go/bin/go /usr/local/bin/go
  sudo ln -sfn /usr/local/go/bin/gofmt /usr/local/bin/gofmt
  echo "==> $(/usr/local/bin/go version 2>/dev/null || echo 'Go') installed!"
}

install_openjdk() {
  echo "==> Installing OpenJDK 25 LTS SDK (Latest Java Development Kit)..."
  apt_install openjdk-25-jdk || apt_install openjdk-21-jdk
}

install_docker_cli() {
  echo "==> Installing Latest Official Docker CLI (docker-ce-cli, buildx, compose)..."
  ensure_repo_prereqs
  sudo sh -c '
    set -e
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
      | gpg --dearmor --yes -o /usr/share/keyrings/docker.gpg
    chmod 644 /usr/share/keyrings/docker.gpg
    echo "deb [arch=arm64 signed-by=/usr/share/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu noble stable" \
      > /etc/apt/sources.list.d/docker.list
  '
  apt_install docker-ce-cli docker-buildx-plugin docker-compose-plugin
}

