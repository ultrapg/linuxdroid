#!/bin/bash
set -euo pipefail

export FLATPAK_BWRAP="/usr/local/bin/bwrap"
export DEBIAN_FRONTEND=noninteractive

DPKG_FORCE_OPTS=(
  -o Dpkg::Options::=--force-confdef
  -o Dpkg::Options::=--force-confold
)

dpkg_needs_repair() {
  local audit_out
  audit_out="$(sudo env DEBIAN_FRONTEND=noninteractive dpkg --audit 2>/dev/null || true)"
  if [ -n "$audit_out" ]; then
    return 0
  fi
  if ! sudo env DEBIAN_FRONTEND=noninteractive apt-get check >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

clear_reinstreq_packages() {
  if ! command -v dpkg-query >/dev/null 2>&1; then
    return 0
  fi
  local pkgs
  pkgs="$(dpkg-query -W -f='${db:Status-Eflag} ${Package}\n' 2>/dev/null | awk 'tolower($1) == "reinstreq" {print $2}' || true)"
  if [ -n "$pkgs" ]; then
    echo "==> Removing orphaned reinstreq package entries: $(echo "$pkgs" | tr '\n' ' ')"
    # shellcheck disable=SC2086
    sudo env DEBIAN_FRONTEND=noninteractive dpkg --remove --force-remove-reinstreq --force-depends $pkgs || true
  fi
}

repair_package_state() {
  sudo env DEBIAN_FRONTEND=noninteractive dpkg --configure -a --force-confdef --force-confold || true
  if dpkg_needs_repair; then
    echo "==> Detected half-installed or broken package state; healing dpkg/apt..."
    if ! sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -f "${DPKG_FORCE_OPTS[@]}"; then
      clear_reinstreq_packages
    fi
    sudo env DEBIAN_FRONTEND=noninteractive dpkg --configure -a --force-confdef --force-confold || true
    if dpkg_needs_repair; then
      clear_reinstreq_packages
      sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -f "${DPKG_FORCE_OPTS[@]}"
      sudo env DEBIAN_FRONTEND=noninteractive dpkg --configure -a --force-confdef --force-confold || true
    fi
  fi
}

# Installs packages non-interactively; heals any interrupted or broken dpkg/apt state first (with zero extra package
# arguments on apt-get install -f), and retries cleanly if a package maintainer script reports a transient error.
apt_install() {
  sudo env DEBIAN_FRONTEND=noninteractive dpkg --configure -a --force-confdef --force-confold || true
  sudo env DEBIAN_FRONTEND=noninteractive apt-get update || true
  repair_package_state
  if ! sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${DPKG_FORCE_OPTS[@]}" "$@"; then
    echo "==> Install reported errors; repairing package state and retrying..."
    sudo env DEBIAN_FRONTEND=noninteractive dpkg --configure -a --force-confdef --force-confold || true
    if ! sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -f "${DPKG_FORCE_OPTS[@]}"; then
      clear_reinstreq_packages
      sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -f "${DPKG_FORCE_OPTS[@]}"
    fi
    sudo env DEBIAN_FRONTEND=noninteractive dpkg --configure -a --force-confdef --force-confold || true
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${DPKG_FORCE_OPTS[@]}" "$@"
  fi
}

pkg_not_broken() {
  local pkg="$1" st
  if ! command -v dpkg-query >/dev/null 2>&1; then
    return 0
  fi
  st="$(dpkg-query -W -f='${db:Status-Status} ${db:Status-Eflag}' "$pkg" 2>/dev/null || true)"
  case "$st" in
    ""|"not-installed ok"|"config-files ok"|"installed ok")
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

pkg_version_ge() {
  local pkg="$1" min_ver="$2" cur_ver st
  if ! command -v dpkg-query >/dev/null 2>&1 || ! command -v dpkg >/dev/null 2>&1; then
    return 1
  fi
  st="$(dpkg-query -W -f='${db:Status-Status} ${db:Status-Eflag}' "$pkg" 2>/dev/null || true)"
  [ "$st" = "installed ok" ] || return 1
  cur_ver="$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null || true)"
  [ -n "$cur_ver" ] && dpkg --compare-versions "$cur_ver" ge "$min_ver"
}

flatpak_app_installed() {
  local app_id="$1"
  [ -d "${HOME:-/home/linux}/.local/share/flatpak/app/${app_id}" ] || \
  { [ -n "${SUDO_USER:-}" ] && [ -d "/home/${SUDO_USER}/.local/share/flatpak/app/${app_id}" ]; } || \
  [ -d "/home/linux/.local/share/flatpak/app/${app_id}" ] || \
  [ -d "/var/lib/flatpak/app/${app_id}" ]
}

ALL_ITEMS=(
  "media-codecs|Media Codecs — video & audio playback"
  "warehouse|Warehouse — Flatpak app store"
  "fex-rootfs|FEX RootFS — run x86_64 apps"
  "chromium|Chromium — web browser"
  "vscode|VS Code — code editor"
  "vscodium|VSCodium — open-source code editor"
  "blender|Blender — 3D creation"
  "krita|Krita — digital painting"
  "obs-studio|OBS Studio — recording & streaming"
  "kdenlive|Kdenlive — video editor"
  "libreoffice|LibreOffice — office suite"
  "gimp|GIMP — image editor"
  "devtools|Dev Tools — C/C++, CMake, Python, Node.js"
  "rust|Rust — toolchain"
  "golang|Go — toolchain"
  "openjdk|OpenJDK 25 — Java SDK"
  "docker-cli|Docker CLI — with buildx & compose"
  "podman|Podman — rootless containers"
)

is_installed() {
  local id="$1"
  case "$id" in
    media-codecs)
      pkg_not_broken libavcodec60 && compgen -G "/usr/lib/*/libavcodec.so.60" >/dev/null 2>&1
      ;;
    warehouse)
      pkg_not_broken flatpak && [ -x /usr/bin/flatpak ] && flatpak_app_installed "io.github.flattool.Warehouse"
      ;;
    fex-rootfs)
      local xdg_data="${XDG_DATA_HOME:-${HOME:-/home/linux}/.local/share}"
      compgen -G "${xdg_data}/fex-emu/RootFS/*Ubuntu*" >/dev/null 2>&1 || \
      compgen -G "${xdg_data}/fex-emu/RootFS/*ubuntu*" >/dev/null 2>&1 || \
      compgen -G "${HOME:-/home/linux}/.fex-emu/RootFS/*Ubuntu*" >/dev/null 2>&1 || \
      compgen -G "${HOME:-/home/linux}/.fex-emu/RootFS/*ubuntu*" >/dev/null 2>&1
      ;;
    chromium)
      # /usr/local/bin/chromium is only a sandbox-disabling shim, so check for the real binary.
      pkg_not_broken chromium && {
        { [ -x /usr/bin/chromium ] && ! grep -qs "snap" /usr/bin/chromium; } || \
        [ -x /usr/lib/chromium/chromium ] || \
        [ -x /usr/lib/chromium-browser/chromium-browser ]
      }
      ;;
    vscode)
      pkg_not_broken code && command -v code >/dev/null 2>&1
      ;;
    vscodium)
      pkg_not_broken codium && command -v codium >/dev/null 2>&1
      ;;
    blender)
      [ -x /opt/blender/blender ] && command -v blender >/dev/null 2>&1
      ;;
    krita)
      pkg_version_ge krita "1:5.3" && command -v krita >/dev/null 2>&1
      ;;
    obs-studio)
      pkg_version_ge obs-studio "30.2" && command -v obs >/dev/null 2>&1
      ;;
    kdenlive)
      pkg_not_broken flatpak && [ -x /usr/bin/flatpak ] && flatpak_app_installed "org.kde.kdenlive"
      ;;
    libreoffice)
      pkg_version_ge libreoffice "4:25.0" && command -v libreoffice >/dev/null 2>&1
      ;;
    gimp)
      pkg_version_ge gimp "3.0" && command -v gimp >/dev/null 2>&1
      ;;
    devtools)
      pkg_not_broken build-essential && pkg_not_broken cmake && pkg_version_ge nodejs "22." && \
      command -v gcc >/dev/null 2>&1 && command -v cmake >/dev/null 2>&1 && command -v node >/dev/null 2>&1
      ;;
    rust)
      [ -x /usr/local/cargo/bin/rustc ] && [ -x /usr/local/cargo/bin/cargo ] && \
      command -v rustc >/dev/null 2>&1 && command -v cargo >/dev/null 2>&1
      ;;
    golang)
      [ -x /usr/local/go/bin/go ] && command -v go >/dev/null 2>&1
      ;;
    openjdk)
      { pkg_version_ge openjdk-25-jdk "25" || [ -d /usr/lib/jvm/java-25-openjdk-arm64 ]; } && \
      pkg_not_broken openjdk-25-jdk && command -v javac >/dev/null 2>&1
      ;;
    docker-cli)
      pkg_version_ge docker-ce-cli "5:27" && command -v docker >/dev/null 2>&1
      ;;
    podman)
      pkg_not_broken podman && command -v podman >/dev/null 2>&1
      ;;
    *)
      return 1
      ;;
  esac
}

status_tag() {
  if is_installed "$1"; then
    printf '[Installed]'
  else
    printf '[Not Installed]'
  fi
}

ensure_repo_prereqs() {
  if ! command -v curl >/dev/null 2>&1 || ! command -v gpg >/dev/null 2>&1 || [ ! -d /etc/ssl/certs ]; then
    apt_install ca-certificates curl gnupg
  fi
}

install_ppa_keyring() {
  local keyring_path="$1"
  shift
  ensure_repo_prereqs
  local tmp_armored
  tmp_armored="$(mktemp)"
  for fpr in "$@"; do
    curl -fsSL --retry 3 "https://keyserver.ubuntu.com/pks/lookup?op=get&search=${fpr}" >> "$tmp_armored"
    printf '\n' >> "$tmp_armored"
  done
  sudo mkdir -p "$(dirname "$keyring_path")"
  sudo gpg --dearmor --yes -o "$keyring_path" < "$tmp_armored"
  sudo chmod 644 "$keyring_path"
  rm -f "$tmp_armored"
}

resolve_flatpak_target_user() {
  FP_USER=""
  FP_HOME="${HOME:-/home/linux}"
  if [ "$(id -u)" -eq 0 ]; then
    if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ] && id "${SUDO_USER}" >/dev/null 2>&1; then
      FP_USER="${SUDO_USER}"
      FP_HOME="$(getent passwd "${SUDO_USER}" | cut -d: -f6)"
    elif id linux >/dev/null 2>&1; then
      FP_USER="linux"
      FP_HOME="/home/linux"
    fi
  fi
}

ensure_flatpak_flathub_ready() {
  apt_install \
    flatpak \
    xdg-dbus-proxy \
    ca-certificates \
    gir1.2-adw-1 \
    gir1.2-gtk-4.0 \
    python3-gi \
    python3-gi-cairo \
    libadwaita-1-0 \
    adwaita-icon-theme \
    librsvg2-common

  # Ensure /usr/bin/bwrap and /usr/bin/flatpak-spawn use our PRoot-compatible shims immediately
  for shim_tool in bwrap flatpak-spawn; do
    if [ -f "/usr/local/bin/${shim_tool}" ]; then
      if [ -f "/usr/bin/${shim_tool}" ] && ! [ -f "/usr/bin/${shim_tool}.distrib" ] && head -c 4 "/usr/bin/${shim_tool}" 2>/dev/null | grep -q "ELF"; then
        sudo mv -f "/usr/bin/${shim_tool}" "/usr/bin/${shim_tool}.distrib" 2>/dev/null || true
      fi
      sudo cp -f "/usr/local/bin/${shim_tool}" "/usr/bin/${shim_tool}" 2>/dev/null || true
      sudo chmod 755 "/usr/bin/${shim_tool}" 2>/dev/null || true
    fi
  done

  # Clean up any broken system-scope OSTree .l2s. symlink remnants left by older versions
  if [ -d /var/lib/flatpak/repo/objects ] && [ ! -d /var/lib/flatpak/app/io.github.flattool.Warehouse ]; then
    if find /var/lib/flatpak/repo/objects -maxdepth 3 -name '.l2s.*' -print -quit 2>/dev/null | grep -q .; then
      echo "==> Cleaning broken legacy system Flatpak object links..."
      sudo rm -rf /var/lib/flatpak/repo/tmp /var/lib/flatpak/repo/objects 2>/dev/null || true
      sudo ostree --repo=/var/lib/flatpak/repo init --mode=bare 2>/dev/null || true
    fi
  fi

  resolve_flatpak_target_user
  echo "==> Configuring unprivileged user Flathub remote (https://dl.flathub.org/repo/flathub.flatpakrepo)..."
  if [ -n "$FP_USER" ]; then
    su - "$FP_USER" -c "FLATPAK_BWRAP=/usr/local/bin/bwrap /usr/local/bin/flatpak --user remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo"
  else
    /usr/local/bin/flatpak --user remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
  fi
}

install_warehouse() {
  echo "==> Installing Flatpak, Flathub repository, and Warehouse (Flatpak Store)..."
  ensure_flatpak_flathub_ready
  echo "==> Installing Warehouse (io.github.flattool.Warehouse) from Flathub..."
  if [ -n "$FP_USER" ]; then
    su - "$FP_USER" -c "FLATPAK_BWRAP=/usr/local/bin/bwrap /usr/local/bin/flatpak --user install -y --or-update flathub io.github.flattool.Warehouse"
  else
    /usr/local/bin/flatpak --user install -y --or-update flathub io.github.flattool.Warehouse
  fi

  local wh_icon="system-software-install"
  local wh_svg="${FP_HOME}/.local/share/flatpak/exports/share/icons/hicolor/scalable/apps/io.github.flattool.Warehouse.svg"
  if [ -f "$wh_svg" ]; then
    sudo mkdir -p /usr/share/icons/hicolor/scalable/apps
    sudo cp -f "$wh_svg" /usr/share/icons/hicolor/scalable/apps/io.github.flattool.Warehouse.svg
    sudo chmod 644 /usr/share/icons/hicolor/scalable/apps/io.github.flattool.Warehouse.svg
    wh_icon="io.github.flattool.Warehouse"
  fi

  sudo sh -c "cat > /usr/share/applications/io.github.flattool.Warehouse.desktop <<EOF
[Desktop Entry]
Type=Application
Name=Warehouse (Flatpak Store)
GenericName=Flatpak Manager & Store
Comment=Manage installed Flatpaks, remotes, and install apps from Flathub
Exec=/usr/local/bin/flatpak run io.github.flattool.Warehouse
Icon=${wh_icon}
Terminal=false
Categories=System;PackageManager;GTK;
Keywords=flatpak;flathub;warehouse;store;packages;
StartupWMClass=io.github.flattool.Warehouse
EOF
chmod 644 /usr/share/applications/io.github.flattool.Warehouse.desktop"
  echo "==> Warehouse (Flatpak Store) installed! Launch it from the application menu or via: flatpak run io.github.flattool.Warehouse"
}

install_fex_rootfs() {
  echo "==> Fetching FEX-Emu Ubuntu 24.04 x86_64 RootFS..."
  /usr/local/bin/linuxdroid-fex fetch-rootfs
}

install_chromium() {
  echo "==> Installing Chromium (Latest ARM64 build from the xtradeb PPA)..."
  install_ppa_keyring "/usr/share/keyrings/xtradeb-apps.gpg" "0x5301FA4FD93244FBC6F6149982BB6851C64F6880"
  sudo sh -c '
    set -e
    echo "deb [arch=arm64 signed-by=/usr/share/keyrings/xtradeb-apps.gpg] https://ppa.launchpadcontent.net/xtradeb/apps/ubuntu noble main" \
      > /etc/apt/sources.list.d/xtradeb-apps.list
    printf "%s\n" \
      "Package: *" "Pin: release o=LP-PPA-xtradeb-apps" "Pin-Priority: 100" "" \
      "Package: chromium*" "Pin: release o=LP-PPA-xtradeb-apps" "Pin-Priority: 1001" "" \
      "Package: chromium-browser" "Pin: release *" "Pin-Priority: -1" \
      > /etc/apt/preferences.d/linuxdroid-chromium
  '
  apt_install chromium
  sudo sh -c '
    mkdir -p /etc/chromium.d
    printf "%s\n" "export CHROMIUM_FLAGS=\"\$CHROMIUM_FLAGS --no-sandbox --no-zygote --disable-gpu-sandbox --disable-dev-shm-usage --ozone-platform-hint=auto\"" \
      > /etc/chromium.d/linuxdroid
    f=/usr/share/applications/chromium.desktop
    if [ -f "$f" ] && ! grep -q -- "--no-sandbox" "$f"; then
      sed -i "s#^Exec=\([^ ]*chromium[^ ]*\)#Exec=\1 --no-sandbox --no-zygote --disable-gpu-sandbox --disable-dev-shm-usage --ozone-platform-hint=auto#" "$f"
    fi
  '
  /usr/local/bin/linuxdroid-default-browser --force || true
  echo "==> Chromium installed and set as the default browser."
}

install_vscodium() {
  echo "==> Installing VSCodium (Latest Official ARM64)..."
  ensure_repo_prereqs
  sudo sh -c '
    set -e
    curl -fsSL https://gitlab.com/paulcarroty/vscodium-deb-rpm-repo/raw/master/pub.gpg \
      | gpg --dearmor --yes -o /usr/share/keyrings/vscodium-archive-keyring.gpg
    chmod 644 /usr/share/keyrings/vscodium-archive-keyring.gpg
    echo "deb [arch=arm64 signed-by=/usr/share/keyrings/vscodium-archive-keyring.gpg] https://download.vscodium.com/debs vscodium main" \
      > /etc/apt/sources.list.d/vscodium.list
  '
  apt_install codium
  sudo sh -c '
    for f in $(dpkg -L codium 2>/dev/null | grep "^/usr/share/applications/.*\\.desktop$" || true) \
             /usr/share/applications/codium.desktop \
             /usr/share/applications/codium-url-handler.desktop \
             /usr/share/applications/com.visualstudio.CodeOSS.desktop \
             /usr/share/applications/com.visualstudio.CodeOSS.UrlHandler.desktop; do
      if [ -f "$f" ]; then
        sed -i -E "/--no-sandbox/! s#^Exec=/usr/share/codium/codium([[:space:]]|\$)#Exec=/usr/share/codium/codium --no-sandbox --no-zygote --disable-gpu-sandbox --disable-dev-shm-usage \\1#" "$f"
      fi
    done
    if [ -x /usr/share/codium/bin/codium ]; then
      cat > /usr/local/bin/codium <<'\''WRAP'\''
#!/bin/sh
exec /usr/share/codium/bin/codium --no-sandbox --no-zygote --disable-gpu-sandbox --disable-dev-shm-usage "$@"
WRAP
      chmod 755 /usr/local/bin/codium
    fi
  '
  echo "==> VSCodium installed."
}

install_vscode() {
  echo "==> Installing Visual Studio Code (Latest Official ARM64)..."
  ensure_repo_prereqs
  sudo sh -c '
    set -e
    curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
      | gpg --dearmor --yes -o /usr/share/keyrings/packages.microsoft.gpg
    chmod 644 /usr/share/keyrings/packages.microsoft.gpg
    echo "deb [arch=arm64 signed-by=/usr/share/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main" \
      > /etc/apt/sources.list.d/vscode.list
  '
  apt_install code
  sudo sh -c '
    for f in $(dpkg -L code 2>/dev/null | grep "^/usr/share/applications/.*\\.desktop$" || true) \
             /usr/share/applications/code.desktop \
             /usr/share/applications/code-url-handler.desktop \
             /usr/share/applications/com.microsoft.VSCode.desktop \
             /usr/share/applications/com.microsoft.VSCode.UrlHandler.desktop; do
      if [ -f "$f" ]; then
        sed -i -E "/--no-sandbox/! s#^Exec=/usr/share/code/code([[:space:]]|\$)#Exec=/usr/share/code/code --no-sandbox --no-zygote --disable-gpu-sandbox --disable-dev-shm-usage \\1#" "$f"
      fi
    done
    if [ -x /usr/share/code/bin/code ]; then
      cat > /usr/local/bin/code <<'\''WRAP'\''
#!/bin/sh
exec /usr/share/code/bin/code --no-sandbox --no-zygote --disable-gpu-sandbox --disable-dev-shm-usage "$@"
WRAP
      chmod 755 /usr/local/bin/code
    fi
  '
  echo "==> Visual Studio Code installed."
}

install_blender() {
  echo "==> Installing Blender (Latest Native ARM64 5.x Release)..."
  apt_install \
    ca-certificates curl xz-utils tar \
    libx11-6 libxrender1 libxi6 libxxf86vm1 libxfixes3 libxkbcommon0 \
    libwayland-client0 libwayland-cursor0 libwayland-egl1 libdecor-0-0 \
    libgl1 libegl1 libgomp1 libsm6 libice6

  # Remove outdated Ubuntu 4.0.2 blender apt package if previously installed so menus & CLI point to Blender 5.x
  if dpkg-query -W -f='${db:Status-Status}' blender 2>/dev/null | grep -qx "installed"; then
    echo "==> Removing legacy Ubuntu Blender 4.0 package before installing latest Blender 5.x..."
    sudo env DEBIAN_FRONTEND=noninteractive apt-get remove -y blender blender-data 2>/dev/null || true
  fi

  local fallback_url="https://github.com/lfdevs/blender-linux-arm64/releases/download/v5.1.0/blender-5.1.0-git20260325.ae6d847d66fa-aarch64.tar.gz"
  local bl_url
  bl_url="$(python3 -B -c '
import json, sys, urllib.request
fallback = sys.argv[1]
try:
    req = urllib.request.Request(
        "https://api.github.com/repos/lfdevs/blender-linux-arm64/releases/latest",
        headers={"User-Agent": "LinuxDroid-Apps/1.0", "Accept": "application/vnd.github+json"},
    )
    with urllib.request.urlopen(req, timeout=10) as r:
        data = json.loads(r.read().decode("utf-8"))
    for asset in data.get("assets", []):
        name = asset.get("name", "").lower()
        url = asset.get("browser_download_url", "")
        if ("aarch64" in name or "arm64" in name) and (name.endswith(".tar.gz") or name.endswith(".tar.xz")):
            print(url)
            raise SystemExit(0)
except Exception:
    pass
print(fallback)
' "$fallback_url")"

  local tmp_archive
  tmp_archive="$(mktemp --suffix=.tar.archive)"
  echo "==> Downloading ${bl_url} ..."
  curl -fL --retry 3 "$bl_url" -o "$tmp_archive"

  sudo rm -rf /opt/blender.new
  sudo mkdir -p /opt/blender.new
  case "$bl_url" in
    *.tar.xz) sudo tar -xJf "$tmp_archive" -C /opt/blender.new --strip-components=1 ;;
    *) sudo tar -xzf "$tmp_archive" -C /opt/blender.new --strip-components=1 ;;
  esac
  rm -f "$tmp_archive"

  if [ ! -x /opt/blender.new/blender ]; then
    sudo rm -rf /opt/blender.new
    echo "ERROR: Extracted Blender archive did not contain /opt/blender/blender" >&2
    return 1
  fi
  sudo rm -rf /opt/blender
  sudo mv /opt/blender.new /opt/blender

  sudo sh -c '
    cat > /usr/local/bin/blender <<'\''WRAP'\''
#!/bin/sh
unset MESA_NO_ERROR DRI_PRIME
export LP_NUM_THREADS="${BL_CPU_COUNT:-4}"
if [ "${LIBGL_ALWAYS_SOFTWARE:-}" = "1" ]; then
  set -- --python-expr "import bpy
try:
    bpy.context.preferences.system.viewport_aa = \"OFF\"
    bpy.context.preferences.system.anisotropic_filter = \"FILTER_0\"
except Exception:
    pass" "$@"
fi
if [ "${KWIN_COMPOSE:-}" = "Q" ] && [ "${BL_GPU_APPS:-0}" != "1" ]; then
  unset MESA_LOADER_DRIVER_OVERRIDE LIBGL_KOPPER_DRI2 MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE
  export LIBGL_ALWAYS_SOFTWARE=1
  export GALLIUM_DRIVER=llvmpipe
fi
if [ -x /opt/blender/blender-launcher ]; then
  exec /usr/local/bin/linuxdroid-gpu-launch /opt/blender/blender-launcher "$@"
fi
export LD_LIBRARY_PATH="/opt/blender/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec /usr/local/bin/linuxdroid-gpu-launch /opt/blender/blender "$@"
WRAP
    chmod 755 /usr/local/bin/blender
    if [ -f /opt/blender/blender.svg ]; then
      mkdir -p /usr/share/icons/hicolor/scalable/apps
      cp -f /opt/blender/blender.svg /usr/share/icons/hicolor/scalable/apps/blender.svg
      chmod 644 /usr/share/icons/hicolor/scalable/apps/blender.svg
    fi
    if [ -f /opt/blender/blender-symbolic.svg ]; then
      mkdir -p /usr/share/icons/hicolor/symbolic/apps
      cp -f /opt/blender/blender-symbolic.svg /usr/share/icons/hicolor/symbolic/apps/blender-symbolic.svg
      chmod 644 /usr/share/icons/hicolor/symbolic/apps/blender-symbolic.svg
    fi
    if [ -f /opt/blender/blender.desktop ]; then
      sed -e "s#^Exec=blender#Exec=/usr/local/bin/blender#" -e "/^PrefersNonDefaultGPU=/d" /opt/blender/blender.desktop > /usr/share/applications/blender.desktop
      chmod 644 /usr/share/applications/blender.desktop
    fi
  '
  update-desktop-database /usr/share/applications >/dev/null 2>&1 || sudo update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
  echo "==> $(/usr/local/bin/blender --version 2>/dev/null | grep -m1 '^Blender ' || echo 'Blender 5.x') installed!"
}

install_krita() {
  echo "==> Installing Krita (Latest 5.3+ ARM64 from ubuntuhandbook1/krita PPA)..."
  install_ppa_keyring "/usr/share/keyrings/ubuntuhandbook1-krita.gpg" \
    "0xF4E48910A020E77056748B745738AE8480447DDF" \
    "0xA0062203196CA4482DDB859E4C1CBE14852541CB"
  sudo sh -c '
    echo "deb [arch=arm64 signed-by=/usr/share/keyrings/ubuntuhandbook1-krita.gpg] https://ppa.launchpadcontent.net/ubuntuhandbook1/krita/ubuntu noble main" \
      > /etc/apt/sources.list.d/ubuntuhandbook1-krita.list
  '
