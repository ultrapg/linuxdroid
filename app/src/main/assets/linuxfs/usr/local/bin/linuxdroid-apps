  echo "==> Installing Podman (Rootless Container Engine)..."
  apt_install podman
}

install_media_codecs() {
  echo "==> Installing media codecs (FFmpeg libraries for Firefox video & audio)..."
  apt_install libavcodec60 libavformat60 libavutil58 libswresample4 ffmpeg
  echo "==> Done. Restart your browser to use the new codecs."
}

print_list() {
  echo "LinuxDroid Workstation Setup"
  for entry in "${ALL_ITEMS[@]}"; do
    local id="${entry%%|*}"
    local desc="${entry#*|}"
    printf "  %-14s %-15s %s\n" "$id" "$(status_tag "$id")" "$desc"
  done
}

run_action() {
  case "${1:-}" in
    media-codecs|codecs|ffmpeg) install_media_codecs ;;
    warehouse|flatpak|flathub) install_warehouse ;;
    fex-rootfs) install_fex_rootfs ;;
    chromium|chrome) install_chromium ;;
    vscode) install_vscode ;;
    vscodium) install_vscodium ;;
    blender) install_blender ;;
    krita) install_krita ;;
    obs-studio|obs) install_obs_studio ;;
    kdenlive) install_kdenlive ;;
    libreoffice) install_libreoffice ;;
    gimp) install_gimp ;;
    devtools) install_dev_tools ;;
    rust) install_rust ;;
    golang|go) install_golang ;;
    openjdk|java) install_openjdk ;;
    docker-cli|docker) install_docker_cli ;;
    podman) install_podman ;;
    --repair|repair)
      sudo env DEBIAN_FRONTEND=noninteractive apt-get update || true
      repair_package_state
      return 0
      ;;
    --list|list|--status|status|-l)
      print_list
      return 0
      ;;
    -h|--help|help)
      print_list
      return 0
      ;;
    *)
      echo "Usage: linuxdroid-apps [media-codecs | warehouse | fex-rootfs | chromium | vscode | vscodium | blender | krita | obs-studio | kdenlive | libreoffice | gimp | devtools | rust | golang | openjdk | docker-cli | podman | --repair | --list]"
      return 1
      ;;
  esac
}

if [ $# -gt 0 ]; then
  run_action "$1"
  exit 0
fi

if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
  menu_args=()
  for entry in "${ALL_ITEMS[@]}"; do
    item_id="${entry%%|*}"
    item_desc="${entry#*|}"
    menu_args+=("$item_id" "$(status_tag "$item_id") $item_desc")
  done

  if command -v kdialog >/dev/null 2>&1; then
    choice=$(kdialog --title "LinuxDroid Workstation Setup" --geometry 760x580 \
      --menu "Choose something to install:" \
      "${menu_args[@]}" 2>/dev/null || true)
  elif command -v zenity >/dev/null 2>&1; then
    choice=$(zenity --list --title="LinuxDroid Workstation Setup" --width=760 --height=580 \
      --column="ID" --column="Component" \
      "${menu_args[@]}" 2>/dev/null || true)
  else
    choice=""
  fi
  if [ -n "${choice:-}" ]; then
    for term in konsole xfce4-terminal xterm; do
      if command -v "$term" >/dev/null 2>&1; then
        exec "$term" -e bash -lc "/usr/local/bin/linuxdroid-apps '$choice'; rc=\$?; echo; if [ \$rc -eq 0 ]; then echo '[SUCCESS] Installation finished.'; else echo \"[FAILED] Installation exited with status \$rc.\"; fi; read -rp 'Press Enter to close...'"
      fi
    done
    run_action "$choice"
    exit 0
  fi
fi

print_list
