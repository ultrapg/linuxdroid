}

install_obs_studio() {
  echo "==> Installing OBS Studio (Latest ARM64 from Ubuntu noble-backports)..."
  if ! grep -Rqs "noble-backports" /etc/apt/sources.list /etc/apt/sources.list.d/ 2>/dev/null; then
    sudo sh -c '
      echo "deb [arch=arm64 signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] http://ports.ubuntu.com/ubuntu-ports/ noble-backports main universe restricted multiverse" \
        > /etc/apt/sources.list.d/noble-backports.list
    '
  fi
  apt_install -t noble-backports obs-studio || apt_install obs-studio
  echo "==> OBS Studio installed."
}

install_kdenlive() {
  echo "==> Installing Kdenlive (Latest 26.x ARM64 Release from Flathub)..."
  ensure_flatpak_flathub_ready
  if dpkg-query -W -f='${db:Status-Status}' kdenlive 2>/dev/null | grep -qx "installed"; then
    echo "==> Removing legacy Ubuntu Kdenlive 23.08 package before installing latest Kdenlive 26.x..."
    sudo env DEBIAN_FRONTEND=noninteractive apt-get remove -y kdenlive kdenlive-data 2>/dev/null || true
  fi
  if [ -n "$FP_USER" ]; then
    su - "$FP_USER" -c "FLATPAK_BWRAP=/usr/local/bin/bwrap /usr/local/bin/flatpak --user install -y --or-update flathub org.kde.kdenlive"
  else
    /usr/local/bin/flatpak --user install -y --or-update flathub org.kde.kdenlive
  fi

  local kd_icon="kdenlive"
  local kd_svg="${FP_HOME}/.local/share/flatpak/exports/share/icons/hicolor/scalable/apps/org.kde.kdenlive.svg"
  if [ -f "$kd_svg" ]; then
    sudo mkdir -p /usr/share/icons/hicolor/scalable/apps
    sudo cp -f "$kd_svg" /usr/share/icons/hicolor/scalable/apps/org.kde.kdenlive.svg
    sudo chmod 644 /usr/share/icons/hicolor/scalable/apps/org.kde.kdenlive.svg
    kd_icon="org.kde.kdenlive"
  fi
  sudo sh -c "cat > /usr/local/bin/kdenlive <<'WRAP'
#!/bin/sh
exec /usr/local/bin/flatpak run org.kde.kdenlive \"\$@\"
WRAP
chmod 755 /usr/local/bin/kdenlive
cat > /usr/share/applications/org.kde.kdenlive.desktop <<EOF
[Desktop Entry]
Type=Application
Name=Kdenlive
GenericName=Video Editor
Comment=Non-linear video editor by KDE (Flathub Latest)
Exec=/usr/local/bin/flatpak run org.kde.kdenlive %U
Icon=${kd_icon}
Terminal=false
Categories=Qt;KDE;AudioVideo;AudioVideoEditing;
MimeType=application/x-kdenlive;
StartupWMClass=kdenlive
EOF
chmod 644 /usr/share/applications/org.kde.kdenlive.desktop"
  echo "==> Kdenlive installed!"
}

