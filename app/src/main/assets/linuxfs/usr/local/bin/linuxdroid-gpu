#!/bin/bash
# Run an application with full hardware SoC OpenGL (Zink / VirGL) and Vulkan enabled.
set -u

case "${VK_ICD_FILENAMES:-}${VK_DRIVER_FILES:-}" in
  *lvp_icd*) ;;
  *) unset LIBGL_ALWAYS_SOFTWARE ;;
esac
unset QT_QUICK_BACKEND

if [ -r /etc/linuxdroid/gpu.env ]; then
  set -a
  # shellcheck disable=SC1091
  . /etc/linuxdroid/gpu.env
  set +a
fi
unset MESA_NO_ERROR

if [ "${LINUXDROID_GPU_ACTIVE:-}" = "turnip" ] || [ "${LINUXDROID_GPU_ACTIVE:-}" = "unified" ]; then
  case "${VK_ICD_FILENAMES:-}${VK_DRIVER_FILES:-}" in
    *lvp_icd*) ;;
    *) unset LIBGL_ALWAYS_SOFTWARE ;;
  esac
  if [ "${LINUXDROID_GPU_ACTIVE:-}" = "turnip" ]; then
    # Never override GL version to 4.6 without COMPAT; Mesa forces Core Profile and breaks
    # QWaylandBlitter / Qt Quick / legacy GL shaders. Zink + Turnip natively supports 4.6 Compat.
    unset MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE
    export TU_DEBUG="${TU_DEBUG:-noconform,sysmem}"
    export LIBGL_KOPPER_DRI2=true
    export MESA_VK_WSI_DEBUG=sw
    export MESA_VK_WSI_PRESENT_MODE=mailbox
    export QT_WAYLAND_FORCE_NONBLOCKING_SWAP_SUPPORT=1
  fi
  export MOZ_WEBRENDER=1
  export mesa_glthread=true
fi

# Never allow desktop apps to attach directly to the host compositor (wayland-0) when a nested
# desktop compositor (wayland-1 / wayland-2) is active; wayland-0 forces top-level windows to
# fullscreen and renders them above KWin, hiding the desktop and taskbar.
if [ -r "${XDG_RUNTIME_DIR:-/run/linuxdroid}/desktop.env" ]; then
  # shellcheck disable=SC1090
  . "${XDG_RUNTIME_DIR:-/run/linuxdroid}/desktop.env"
fi
if [ -z "${WAYLAND_DISPLAY:-}" ] || [ "${WAYLAND_DISPLAY:-}" = "wayland-0" ]; then
  if [ -S "${XDG_RUNTIME_DIR:-/run/linuxdroid}/wayland-1" ]; then
    export WAYLAND_DISPLAY=wayland-1
  elif [ -S "${XDG_RUNTIME_DIR:-/run/linuxdroid}/wayland-2" ]; then
    export WAYLAND_DISPLAY=wayland-2
  elif [ -S /tmp/.X11-unix/X0 ] || [ -S /tmp/.X11-unix/X1 ]; then
    export WAYLAND_DISPLAY=wayland-off
    export BL_FORCE_X11=1
  fi
fi

# Per-application profiles
if [ "$#" -gt 0 ]; then
  case "$(basename "$1")" in
    blender|blender-launcher)
      # Follow DroidDeck's desktop GPU pattern: run Blender on Xwayland (:0) with Turnip + Zink +
      # Kopper (LIBGL_KOPPER_DRI2=true, MESA_VK_WSI_DEBUG=sw) and WAYLAND_DISPLAY=wayland-off +
      # BL_FORCE_X11=1 so libblsession.so blocks GHOST_SystemWayland's wl_display_connect(nullptr)
      # from ever connecting to wayland-0 (the Android fullscreen host compositor) or wayland-1
      # (where KWIN_COMPOSE=Q lacks zwp_linux_dmabuf_v1 and causes Mesa EGL Wayland to fall back
      # to swrast). On Xwayland (:0), Zink+Turnip Kopper renders with full Adreno hardware
      # acceleration inside a decorated KWin window with Breeze titlebar and visible KDE taskbar.
      unset mesa_glthread ZINK_DEBUG ZINK_DESCRIPTORS
      export GALLIUM_THREAD=0
      export LIBDECOR_PLUGIN_DIR=/nonexistent
      if [ "${BLENDER_WAYLAND:-0}" != "1" ]; then
        if [ ! -S /tmp/.X11-unix/X0 ] && [ ! -S /tmp/.X11-unix/X1 ] && \
           { [ -S "${XDG_RUNTIME_DIR:-/run/linuxdroid}/wayland-1" ] || [ -S "${XDG_RUNTIME_DIR:-/run/linuxdroid}/wayland-2" ]; }; then
          for _ in $(seq 1 30); do
            [ -S /tmp/.X11-unix/X0 ] || [ -S /tmp/.X11-unix/X1 ] && break
            sleep 0.1
          done
        fi
        if [ -S /tmp/.X11-unix/X0 ] || [ -S /tmp/.X11-unix/X1 ]; then
          if [ -z "${DISPLAY:-}" ]; then
            if [ -S /tmp/.X11-unix/X0 ]; then
              export DISPLAY=:0
            else
              export DISPLAY=:1
            fi
          fi
          export WAYLAND_DISPLAY=wayland-off
          export BL_FORCE_X11=1
          export GDK_BACKEND=x11
          export QT_QPA_PLATFORM=xcb
          export SDL_VIDEODRIVER=x11
        elif [ -S "${XDG_RUNTIME_DIR:-/run/linuxdroid}/wayland-1" ]; then
          export WAYLAND_DISPLAY=wayland-1
        elif [ -S "${XDG_RUNTIME_DIR:-/run/linuxdroid}/wayland-2" ]; then
          export WAYLAND_DISPLAY=wayland-2
        fi
      fi
      if [ -z "${XAUTHORITY:-}" ] || [ ! -r "${XAUTHORITY:-}" ]; then
        for xa in "${XDG_RUNTIME_DIR:-/run/linuxdroid}"/xauth_* "${HOME:-/home/linux}/.Xauthority"; do
          if [ -r "$xa" ]; then
            export XAUTHORITY="$xa"
            break
          fi
        done
      fi
      # Ensure Blender opens as a normal decorated window inside the desktop workarea (leaving
      # the KDE Plasma / XFCE taskbar panel and KWin window titlebar visible) unless explicit
      # window or background CLI flags were passed.
      has_win_flag=0
      for arg in "${@:2}"; do
        case "$arg" in
          -b|--background|-v|--version|-h|--help|-w|--window-border|-W|--window-borderless|-M|--window-maximized|-p|--window-geometry)
            has_win_flag=1
            break
            ;;
        esac
      done
      if [ "$has_win_flag" = "0" ]; then
        bl_geom="$(python3 -c '
import ctypes, os
w, h = 0, 0
try:
    w = int(os.environ.get("BL_WIDTH", "0"))
    h = int(os.environ.get("BL_HEIGHT", "0"))
except Exception:
    w, h = 0, 0
if w <= 0 or h <= 0:
    try:
        x11 = ctypes.CDLL("libX11.so.6")
        x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
        x11.XOpenDisplay.restype = ctypes.c_void_p
        x11.XDefaultScreen.argtypes = [ctypes.c_void_p]
        x11.XDefaultScreen.restype = ctypes.c_int
        x11.XDisplayWidth.argtypes = [ctypes.c_void_p, ctypes.c_int]
        x11.XDisplayWidth.restype = ctypes.c_int
        x11.XDisplayHeight.argtypes = [ctypes.c_void_p, ctypes.c_int]
        x11.XDisplayHeight.restype = ctypes.c_int
        x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
        dpy = x11.XOpenDisplay(None)
        if dpy:
            scr = x11.XDefaultScreen(dpy)
            w = int(x11.XDisplayWidth(dpy, scr))
            h = int(x11.XDisplayHeight(dpy, scr))
            x11.XCloseDisplay(dpy)
    except Exception:
        pass
if w <= 0 or h <= 0:
    w, h = 1920, 1080
if w >= 640 and h >= 480:
    panel_h = 56
    title_h = 40
    win_w = max(560, w - 48)
    win_h = max(400, h - panel_h - title_h - 16)
    sx = max(0, (w - win_w) // 2)
    sy = panel_h + 4
    print(f"{sx} {sy} {win_w} {win_h}")
' 2>/dev/null || echo "24 60 1872 968")"
        if [ -n "$bl_geom" ]; then
          # shellcheck disable=SC2086
          set -- "$1" -w -p $bl_geom "${@:2}"
        else
          set -- "$1" -w "${@:2}"
        fi
        # Background window workarea enforcer for Blender on both KWin (D-Bus) and X11/XFCE
        (
          python3 - "$bl_geom" <<'PY' >/dev/null 2>&1 || true
import ctypes, os, subprocess, sys, time

geom_parts = [int(x) for x in (sys.argv[1] if len(sys.argv) > 1 else "").split() if x.lstrip("-").isdigit()]
sx, sy, win_w, win_h = geom_parts if len(geom_parts) == 4 else (24, 60, 0, 0)
top_y = 38

try:
    x11 = ctypes.CDLL("libX11.so.6")
except Exception:
    raise SystemExit(0)

class XClientMessageEvent(ctypes.Structure):
    _fields_ = [
        ("type", ctypes.c_int),
        ("serial", ctypes.c_ulong),
        ("send_event", ctypes.c_int),
        ("display", ctypes.c_void_p),
        ("window", ctypes.c_ulong),
        ("message_type", ctypes.c_ulong),
        ("format", ctypes.c_int),
        ("data", ctypes.c_long * 5),
    ]

class MotifWmHints(ctypes.Structure):
    _fields_ = [
        ("flags", ctypes.c_ulong),
        ("functions", ctypes.c_ulong),
        ("decorations", ctypes.c_ulong),
        ("input_mode", ctypes.c_long),
        ("status", ctypes.c_ulong),
    ]

x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XOpenDisplay.restype = ctypes.c_void_p
x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
x11.XDefaultRootWindow.restype = ctypes.c_ulong
x11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
x11.XInternAtom.restype = ctypes.c_ulong
x11.XChangeProperty.argtypes = [
    ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong,
    ctypes.c_int, ctypes.c_int, ctypes.c_void_p, ctypes.c_int
]
x11.XSendEvent.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_long, ctypes.c_void_p]
x11.XMoveResizeWindow.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_uint, ctypes.c_uint]
x11.XFlush.argtypes = [ctypes.c_void_p]
x11.XCloseDisplay.argtypes = [ctypes.c_void_p]

def find_blender_wids():
    wids = []
    try:
        out = subprocess.check_output(["xprop", "-root", "_NET_CLIENT_LIST"], stderr=subprocess.DEVNULL, timeout=1).decode(errors="ignore")
        if "#" in out:
            for tok in out.split("#", 1)[1].replace(",", " ").split():
                if tok.startswith("0x"):
                    wid = int(tok, 16)
                    if wid > 0:
                        p = subprocess.check_output(["xprop", "-id", hex(wid), "WM_CLASS", "_NET_WM_NAME"], stderr=subprocess.DEVNULL, timeout=1).decode(errors="ignore").lower()
                        if "blender" in p:
                            wids.append(wid)
    except Exception:
        pass
    return wids

for attempt in range(45):
    time.sleep(0.2)
    wids = find_blender_wids()
    if not wids:
        continue
    dpy = x11.XOpenDisplay(None)
    if not dpy:
        continue
    try:
        root = x11.XDefaultRootWindow(dpy)
        net_wm_state = x11.XInternAtom(dpy, b"_NET_WM_STATE", 0)
        state_fs = x11.XInternAtom(dpy, b"_NET_WM_STATE_FULLSCREEN", 0)
        state_max_h = x11.XInternAtom(dpy, b"_NET_WM_STATE_MAXIMIZED_HORZ", 0)
        state_max_v = x11.XInternAtom(dpy, b"_NET_WM_STATE_MAXIMIZED_VERT", 0)
        motif_atom = x11.XInternAtom(dpy, b"_MOTIF_WM_HINTS", 0)
        for wid in wids:
            hints = MotifWmHints(flags=2, functions=1, decorations=1, input_mode=0, status=0)
            x11.XChangeProperty(
                dpy, wid, motif_atom, motif_atom, 32, 0,
                ctypes.cast(ctypes.byref(hints), ctypes.c_void_p), 5
            )
            for atom1, atom2 in ((state_fs, 0), (state_max_h, state_max_v)):
                ev = XClientMessageEvent()
                ev.type = 33
                ev.serial = 0
                ev.send_event = 1
                ev.display = dpy
                ev.window = wid
                ev.message_type = net_wm_state
                ev.format = 32
                ev.data[0] = 0  # _NET_WM_STATE_REMOVE
                ev.data[1] = atom1
                ev.data[2] = atom2
                ev.data[3] = 1
                ev.data[4] = 0
                x11.XSendEvent(dpy, root, 0, (1 << 20) | (1 << 19), ctypes.byref(ev))
            if win_w >= 400 and win_h >= 300:
                x11.XMoveResizeWindow(dpy, wid, sx, top_y, win_w, win_h)
        x11.XFlush(dpy)
    finally:
        x11.XCloseDisplay(dpy)
    subprocess.run(
        ["dbus-send", "--session", "--dest=org.kde.KWin", "--type=method_call", "/KWin", "org.kde.KWin.reconfigure"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1
    )
    if attempt >= 5:
        time.sleep(0.5)
        break
PY
        ) &
      fi
      ;;
    chromium|chromium-browser|google-chrome|google-chrome-stable|brave-browser)
      export GALLIUM_THREAD=0
      set -- "$1" --ozone-platform=wayland --in-process-gpu --disable-gpu-watchdog --disable-vulkan "${@:2}"
      ;;
    firefox)
      export MOZ_ENABLE_WAYLAND=1 MOZ_WEBRENDER=1 GALLIUM_THREAD=0
      ;;
  esac
fi
export GALLIUM_THREAD=0

if [ "$#" -eq 0 ]; then
  echo "usage: linuxdroid-gpu PROGRAM [ARGS...]" >&2
  exit 2
fi
exec "$@"
