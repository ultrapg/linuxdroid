#!/bin/bash
# Run an application with full hardware SoC OpenGL (Zink / VirGL) and Vulkan enabled.
set -u

unset LIBGL_ALWAYS_SOFTWARE
unset QT_QUICK_BACKEND

if [ -r /etc/linuxdroid/gpu.env ]; then
  set -a
  # shellcheck disable=SC1091
  . /etc/linuxdroid/gpu.env
  set +a
fi
unset MESA_NO_ERROR

if [ "${LINUXDROID_GPU_ACTIVE:-}" = "turnip" ] || [ "${LINUXDROID_GPU_ACTIVE:-}" = "unified" ]; then
  unset LIBGL_ALWAYS_SOFTWARE
  export MOZ_WEBRENDER=1
  export mesa_glthread=true
  if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
    export GDK_BACKEND=x11
    export QT_QPA_PLATFORM=xcb
    export SDL_VIDEODRIVER=x11
  fi
fi

# Per-application profiles. Blender does not honour GDK/QT/SDL backend hints and would pick Wayland+dmabuf,
# which software-composited KWin cannot accept (black window). Force X11 (Xwayland) with the shm present path.
if [ "$#" -gt 0 ]; then
  case "$(basename "$1")" in
    blender|blender-launcher)
      unset WAYLAND_DISPLAY
      export DISPLAY="${DISPLAY:-:0}" GHOST_BACKEND=X11 XDG_SESSION_TYPE=x11
      export ZINK_DESCRIPTORS=lazy GALLIUM_THREAD=0 MESA_VK_WSI_DEBUG=sw
      ;;
    chromium|chromium-browser|google-chrome|google-chrome-stable|brave-browser)
      export GALLIUM_THREAD=0
      set -- "$1" --ozone-platform=x11 --use-angle=vulkan --enable-features=Vulkan "${@:2}"
      ;;
    firefox)
      export MOZ_ENABLE_WAYLAND=0 MOZ_WEBRENDER=1 GALLIUM_THREAD=0
      ;;
  esac
fi
export GALLIUM_THREAD=0

if [ "$#" -eq 0 ]; then
  echo "usage: linuxdroid-gpu PROGRAM [ARGS...]" >&2
  exit 2
fi
exec "$@"
