#!/bin/bash
# Run an application with full hardware SoC OpenGL (Zink / VirGL) and Vulkan enabled.
set -u

case "${VK_ICD_FILENAMES:-}${VK_DRIVER_FILES:-}" in
  *lvp_icd*) ;;
  *) unset LIBGL_ALWAYS_SOFTWARE ;;
esac
unset QT_QUICK_BACKEND

if [ -r /etc/linuxdroid/gpu.env ]; then
  set -a
  # shellcheck disable=SC1091
  . /etc/linuxdroid/gpu.env
  set +a
fi
unset MESA_NO_ERROR

if [ "${LINUXDROID_GPU_ACTIVE:-}" = "turnip" ] || [ "${LINUXDROID_GPU_ACTIVE:-}" = "unified" ]; then
  case "${VK_ICD_FILENAMES:-}${VK_DRIVER_FILES:-}" in
    *lvp_icd*) ;;
    *) unset LIBGL_ALWAYS_SOFTWARE ;;
  esac
  if [ "${LINUXDROID_GPU_ACTIVE:-}" = "turnip" ]; then
    # Never override GL version to 4.6 without COMPAT; Mesa forces Core Profile and breaks
    # QWaylandBlitter / Qt Quick / legacy GL shaders. Zink + Turnip natively supports 4.6 Compat.
    unset MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE
    export TU_DEBUG="${TU_DEBUG:-noconform,sysmem}"
    export LIBGL_KOPPER_DRI2=true
    export MESA_VK_WSI_DEBUG=sw
    export MESA_VK_WSI_PRESENT_MODE=mailbox
    export QT_WAYLAND_FORCE_NONBLOCKING_SWAP_SUPPORT=1
  fi
  export MOZ_WEBRENDER=1
  export mesa_glthread=true
fi

# Never allow desktop apps to attach directly to the host compositor (wayland-0) when a nested
# desktop compositor (wayland-1 / wayland-2) is active; wayland-0 forces top-level windows to
# fullscreen and renders them above KWin, hiding the desktop and taskbar.
if [ "${WAYLAND_DISPLAY:-}" = "wayland-0" ]; then
  if [ -S "${XDG_RUNTIME_DIR:-/run/linuxdroid}/wayland-1" ]; then
    export WAYLAND_DISPLAY=wayland-1
  elif [ -S "${XDG_RUNTIME_DIR:-/run/linuxdroid}/wayland-2" ]; then
    export WAYLAND_DISPLAY=wayland-2
  fi
fi

# Per-application profiles
if [ "$#" -gt 0 ]; then
  case "$(basename "$1")" in
    blender|blender-launcher)
      # Blender 5.x runs over Xwayland (GHOST_SystemX11) by default to avoid GHOST_SystemWayland's
      # background wl_display event-reader thread racing with Mesa Kopper's Wayland WSI swapchain
      # dispatch. Keep Turnip + Zink + Kopper hardware acceleration active.
      unset mesa_glthread ZINK_DEBUG ZINK_DESCRIPTORS
      export GALLIUM_THREAD=0
      export LIBDECOR_PLUGIN_DIR=/nonexistent
      if [ "${BLENDER_WAYLAND:-0}" != "1" ]; then
        if [ ! -S /tmp/.X11-unix/X0 ] && [ ! -S /tmp/.X11-unix/X1 ] && [ -S "${XDG_RUNTIME_DIR:-/run/linuxdroid}/wayland-1" ]; then
          for _ in $(seq 1 20); do
            [ -S /tmp/.X11-unix/X0 ] || [ -S /tmp/.X11-unix/X1 ] && break
            sleep 0.1
          done
        fi
        if [ -n "${DISPLAY:-}" ] || [ -S /tmp/.X11-unix/X0 ] || [ -S /tmp/.X11-unix/X1 ]; then
          if [ -z "${DISPLAY:-}" ]; then
            if [ -S /tmp/.X11-unix/X0 ]; then
              export DISPLAY=:0
            else
              export DISPLAY=:1
            fi
          fi
          if [ -z "${XAUTHORITY:-}" ] || [ ! -r "${XAUTHORITY:-}" ]; then
            for xa in "${XDG_RUNTIME_DIR:-/run/linuxdroid}"/xauth_* "${HOME:-/home/linux}/.Xauthority"; do
              if [ -r "$xa" ]; then
                export XAUTHORITY="$xa"
                break
              fi
            done
          fi
          unset WAYLAND_DISPLAY
        fi
      fi
      # Ensure Blender opens as a normal decorated window inside the desktop workarea (leaving
      # the KDE Plasma / XFCE taskbar panel and KWin window titlebar visible) unless explicit
      # window or background CLI flags were passed.
      has_win_flag=0
      for arg in "${@:2}"; do
        case "$arg" in
          -b|--background|-v|--version|-h|--help|-w|--window-border|-W|--window-borderless|-M|--window-maximized|-p|--window-geometry)
            has_win_flag=1
            break
            ;;
        esac
      done
      if [ "$has_win_flag" = "0" ]; then
        bl_geom="$(python3 -c '
import os, subprocess
w, h = 0, 0
try:
    out = subprocess.check_output(["xprop", "-root", "_NET_DESKTOP_GEOMETRY"], stderr=subprocess.DEVNULL, timeout=1).decode()
    nums = [int(x.strip()) for x in out.split("=")[-1].split(",") if x.strip().isdigit()]
    if len(nums) >= 2:
        w, h = nums[0], nums[1]
except Exception:
    pass
if w <= 0 or h <= 0:
    try:
        w = int(os.environ.get("BL_WIDTH", "0"))
        h = int(os.environ.get("BL_HEIGHT", "0"))
    except Exception:
        w, h = 0, 0
if w >= 640 and h >= 480:
    panel_h = 52
    title_h = 38
    win_w = max(600, w - 16)
    win_h = max(400, h - panel_h - title_h - 8)
    sx = max(0, (w - win_w) // 2)
    sy = panel_h
    print(f"{sx} {sy} {win_w} {win_h}")
' 2>/dev/null || true)"
        if [ -n "$bl_geom" ]; then
          # shellcheck disable=SC2086
          set -- "$1" -w -p $bl_geom "${@:2}"
        else
          set -- "$1" -w "${@:2}"
        fi
      fi
      ;;
    chromium|chromium-browser|google-chrome|google-chrome-stable|brave-browser)
      export GALLIUM_THREAD=0
      set -- "$1" --ozone-platform=wayland --in-process-gpu --disable-gpu-watchdog --disable-vulkan "${@:2}"
      ;;
    firefox)
      export MOZ_ENABLE_WAYLAND=1 MOZ_WEBRENDER=1 GALLIUM_THREAD=0
      ;;
  esac
fi
export GALLIUM_THREAD=0

if [ "$#" -eq 0 ]; then
  echo "usage: linuxdroid-gpu PROGRAM [ARGS...]" >&2
  exit 2
fi
exec "$@"
