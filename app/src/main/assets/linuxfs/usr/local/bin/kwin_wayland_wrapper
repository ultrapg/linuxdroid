#!/bin/bash
if [ "${BL_DESKTOP:-}" = "1" ]; then
  if [ -n "${XDG_RUNTIME_DIR:-}" ] && ! pgrep -x kwin_wayland >/dev/null 2>&1; then
    rm -f "$XDG_RUNTIME_DIR"/wayland-[1-9]* 2>/dev/null || true
  fi
  has_wl=0
  for arg in "$@"; do
    if [ "$arg" = "--wayland-display" ]; then
      has_wl=1
      break
    fi
  done
  if [ "$has_wl" = "0" ]; then
    set -- \
      --wayland-display "${LINUXDROID_PARENT_WAYLAND:-wayland-0}" \
      --socket wayland-1 \
      --width "${BL_WIDTH:-1920}" \
      --height "${BL_HEIGHT:-1080}" \
      --scale "${BL_SCALE:-1}" \
      --no-lockscreen \
      "$@"
  fi
  # Nested kwin_wayland composites onto LinuxDroid's host Wayland socket via QPainter/wl_shm.
  # Save the session's GPU variables so libblsession.so automatically restores hardware GPU
  # for any child process spawned by kwin_wayland while keeping kwin_wayland itself on QPainter.
  export LINUXDROID_SAVED_QT_QUICK_BACKEND="${QT_QUICK_BACKEND:-}"
  export LINUXDROID_SAVED_LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-}"
  export LINUXDROID_SAVED_GALLIUM_DRIVER="${GALLIUM_DRIVER:-}"
  export LINUXDROID_SAVED_MESA_LOADER_DRIVER_OVERRIDE="${MESA_LOADER_DRIVER_OVERRIDE:-}"
  export LINUXDROID_SAVED_LIBGL_KOPPER_DRI2="${LIBGL_KOPPER_DRI2:-}"
  export LINUXDROID_KWIN_ONLY_SW=1
  export KWIN_COMPOSE=Q
  export QT_QUICK_BACKEND=software
  export LIBGL_ALWAYS_SOFTWARE=1
  export GALLIUM_DRIVER=llvmpipe
  unset MESA_LOADER_DRIVER_OVERRIDE LIBGL_KOPPER_DRI2
fi
exec /usr/bin/kwin_wayland_wrapper "$@"
