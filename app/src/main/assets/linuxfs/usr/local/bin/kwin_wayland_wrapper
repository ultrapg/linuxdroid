#!/bin/bash
if [ "${BL_DESKTOP:-}" = "1" ]; then
  if [ -n "${XDG_RUNTIME_DIR:-}" ] && ! pgrep -x kwin_wayland >/dev/null 2>&1; then
    rm -f "$XDG_RUNTIME_DIR"/wayland-[1-9]* 2>/dev/null || true
  fi
  has_wl=0
  for arg in "$@"; do
    if [ "$arg" = "--wayland-display" ]; then
      has_wl=1
      break
    fi
  done
  if [ "$has_wl" = "0" ]; then
    set -- \
      --wayland-display "${LINUXDROID_PARENT_WAYLAND:-wayland-0}" \
      --socket wayland-1 \
      --width "${BL_WIDTH:-1920}" \
      --height "${BL_HEIGHT:-1080}" \
      --scale "${BL_SCALE:-1}" \
      --no-lockscreen \
      "$@"
  fi
  export KWIN_COMPOSE=Q
  export QT_QUICK_BACKEND=software
fi
exec /usr/bin/kwin_wayland_wrapper "$@"
