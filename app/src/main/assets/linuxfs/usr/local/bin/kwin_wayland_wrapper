#!/bin/bash
# LinuxDroid kwin_wayland_wrapper
REAL_KWIN_WRAPPER=""
for candidate in /usr/lib/linuxdroid/kwin_wayland_wrapper.real /usr/bin/kwin_wayland_wrapper.distrib /usr/bin/kwin_wayland_wrapper; do
  if [ -x "$candidate" ] && ! grep -q "^# LinuxDroid kwin_wayland_wrapper" "$candidate" 2>/dev/null; then
    REAL_KWIN_WRAPPER="$candidate"
    break
  fi
done
if [ -z "$REAL_KWIN_WRAPPER" ]; then
  echo "linuxdroid kwin_wayland_wrapper: real kwin_wayland_wrapper binary not found" >&2
  exit 127
fi

if [ "${BL_DESKTOP:-}" = "1" ]; then
  rm -rf /tmp/.X11-unix /tmp/.ICE-unix /tmp/.X*-lock 2>/dev/null || true
  mkdir -p /tmp/.X11-unix /tmp/.ICE-unix 2>/dev/null || true
  chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix 2>/dev/null || \
    linuxdroid-root chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix 2>/dev/null || true
  if [ -n "${XDG_RUNTIME_DIR:-}" ] && ! pgrep -x kwin_wayland >/dev/null 2>&1; then
    rm -f "$XDG_RUNTIME_DIR"/wayland-[1-9]* 2>/dev/null || true
  fi
  has_wl=0
  has_xwl=0
  for arg in "$@"; do
    case "$arg" in
      --wayland-display) has_wl=1 ;;
      --xwayland) has_xwl=1 ;;
    esac
  done
  if [ "$has_xwl" = "0" ]; then
    set -- --xwayland "$@"
  fi
  if [ "$has_wl" = "0" ]; then
    set -- \
      --wayland-display "${LINUXDROID_PARENT_WAYLAND:-wayland-0}" \
      --socket wayland-1 \
      --width "${BL_WIDTH:-1920}" \
      --height "${BL_HEIGHT:-1080}" \
      --scale "${BL_SCALE:-1}" \
      --no-lockscreen \
      "$@"
  fi
  export KWIN_COMPOSE=Q
  export QT_QUICK_BACKEND=software
  export QSG_RENDER_LOOP=basic
  export LIBGL_ALWAYS_SOFTWARE=1
  export GALLIUM_DRIVER=llvmpipe
  export KWIN_WAYLAND_NO_XAUTHORITY=1
  unset MESA_LOADER_DRIVER_OVERRIDE LIBGL_KOPPER_DRI2 MESA_GL_VERSION_OVERRIDE MESA_GLSL_VERSION_OVERRIDE ZINK_DESCRIPTORS MESA_NO_ERROR
fi
exec "$REAL_KWIN_WRAPPER" "$@"
