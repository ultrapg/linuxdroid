# Safe /dev/shm check for PRoot/container environments where findmnt may return empty.
shm_avail="$(df -PB1 /dev/shm 2>/dev/null | awk 'NR==2 {print $4}')"
case "$shm_avail" in
  ''|*[!0-9]*)
    export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --disable-dev-shm-usage"
    ;;
  *)
    if [ "$shm_avail" -lt 4080218931 ]; then
      export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --disable-dev-shm-usage"
    fi
    ;;
esac
