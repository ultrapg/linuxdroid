 	return handle_seccomp_event_common(tracee);
@@ -518,6 +524,90 @@ static int handle_seccomp_event_common(Tracee *tracee)
 		break;
 	}
 
+	case PR_fchmodat2:
+	{
+		word_t flags = peek_reg(tracee, CURRENT, SYSARG_4);
+		int dirfd = (int) peek_reg(tracee, CURRENT, SYSARG_1);
+		char original[PATH_MAX];
+		char path[PATH_MAX];
+		struct stat st;
+		int size;
+
+		if ((flags & ~(AT_SYMLINK_NOFOLLOW | AT_EMPTY_PATH)) != 0) {
+			set_result_after_seccomp(tracee, -EINVAL);
+			break;
+		}
+		if (peek_reg(tracee, CURRENT, SYSARG_2) == 0) {
+			set_result_after_seccomp(tracee, -EFAULT);
+			break;
+		}
+		size = read_string(tracee, original, peek_reg(tracee, CURRENT, SYSARG_2), PATH_MAX);
+		if (size < 0) {
+			set_result_after_seccomp(tracee, size);
+			break;
+		}
+		if (size >= PATH_MAX) {
+			set_result_after_seccomp(tracee, -ENAMETOOLONG);
+			break;
+		}
+		if (size == 1) {
+			if ((flags & AT_EMPTY_PATH) == 0) {
+				set_result_after_seccomp(tracee, -ENOENT);
+				break;
+			}
+			if (dirfd == AT_FDCWD) {
+				strcpy(original, ".");
+			} else {
+				snprintf(path, sizeof(path), "/proc/%d/fd/%d", tracee->pid, dirfd);
+				if (stat(path, &st) < 0) {
+					set_result_after_seccomp(tracee, -EBADF);
+					break;
+				}
+				if (S_ISLNK(st.st_mode)) {
+					set_result_after_seccomp(tracee, -EOPNOTSUPP);
+					break;
+				}
+				snprintf(path, sizeof(path), "/proc/self/fd/%d", dirfd);
+				ret = set_sysarg_path(tracee, path, SYSARG_2);
+				if (ret < 0) {
+					set_result_after_seccomp(tracee, ret);
+					break;
+				}
+				set_sysnum(tracee, PR_fchmodat);
+				poke_reg(tracee, SYSARG_1, AT_FDCWD);
+				poke_reg(tracee, SYSARG_4, 0);
+				restart_syscall_after_seccomp(tracee);
+				break;
+			}
+		}
+		if ((flags & AT_SYMLINK_NOFOLLOW) != 0) {
+			status = translate_path(tracee, path, dirfd, original, false);
+			if (status < 0) {
+				set_result_after_seccomp(tracee, status);
+				break;
+			}
+			if (lstat(path, &st) < 0) {
+				set_result_after_seccomp(tracee, -errno);
+				break;
+			}
+			if (S_ISLNK(st.st_mode)) {
+				set_result_after_seccomp(tracee, -EOPNOTSUPP);
+				break;
+			}
+		}
+		if (size == 1 && dirfd == AT_FDCWD) {
+			ret = set_sysarg_path(tracee, original, SYSARG_2);
+			if (ret < 0) {
+				set_result_after_seccomp(tracee, ret);
+				break;
+			}
+		}
+		set_sysnum(tracee, PR_fchmodat);
+		poke_reg(tracee, SYSARG_4, 0);
+		restart_syscall_after_seccomp(tracee);
+		break;
+	}
+
 	case PR_ftruncate:
 	{
 		if (detranslate_sysnum(get_abi(tracee), PR_ftruncate64) == SYSCALL_AVOIDER) {
