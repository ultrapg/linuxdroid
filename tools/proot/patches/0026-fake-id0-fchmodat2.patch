+#define AT_EMPTY_PATH 0x1000
+#endif
 
 #include "extension/extension.h"
 #include "cli/note.h"
@@ -97,6 +102,7 @@ int handle_seccomp_event(Tracee* tracee)
 	tracee->_regs[CURRENT].orig_eax = tracee->_regs[CURRENT].eax;
