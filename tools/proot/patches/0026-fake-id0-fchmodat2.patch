From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Date: Wed, 4 Nov 2026 16:15:00 +0000
Subject: [PATCH] fake_id0: handle PR_fchmodat2 mode preservation, symlink
 resolution, AT_SYMLINK_NOFOLLOW, and permission-error masking

---
--- a/src/extension/fake_id0/config.h
+++ b/src/extension/fake_id0/config.h
@@ -2,7 +2,11 @@
 #define FAKE_ID0_CONFIG_H
 
 #include <sys/types.h>   /* uid_t, gid_t */
+#include <sys/queue.h>   /* LIST_*, */
 #include <stdbool.h>
+
+struct ModifiedNode;
+LIST_HEAD(ModifiedNodes, ModifiedNode);
 
 typedef struct {
 	uid_t ruid;
@@ -17,7 +21,7 @@
 
 	mode_t umask;
 
-
+	struct ModifiedNodes modified_nodes;
 
 	bool identity;
 } Config;
--- a/src/extension/fake_id0/fake_id0.c
+++ b/src/extension/fake_id0/fake_id0.c
@@ -23,6 +23,8 @@
 #include <assert.h>      /* assert(3), */
 #include <stdint.h>      /* intptr_t, */
 #include <errno.h>       /* E*, */
+#include <fcntl.h>       /* AT_*, */
+#include <string.h>      /* strcmp(3), */
 #include <sys/stat.h>    /* chmod(2), stat(2) */
 #include <sys/types.h>   /* uid_t, gid_t, get*id(2), */
 #include <unistd.h>      /* get*id(2),  */
@@ -47,6 +49,10 @@
 #include "path/binding.h"
 #include "path/f2fs-bug.h"
 #include "arch.h"
+#include "compat.h"
+#ifndef AT_EMPTY_PATH
+#define AT_EMPTY_PATH 0x1000
+#endif
 
 #include "extension/fake_id0/chown.h"
 #include "extension/fake_id0/chroot.h"
@@ -259,9 +265,10 @@
 	return 0;							\
 } while (0)
 
-typedef struct {
+typedef struct ModifiedNode {
 	char *path;
 	mode_t mode;
+	LIST_ENTRY(ModifiedNode) link;
 } ModifiedNode;
 
 /* List of syscalls handled by this extensions.  */
@@ -290,6 +297,7 @@
 	{ PR_execve,		FILTER_SYSEXIT },
 	{ PR_fchmod,		FILTER_SYSEXIT },
 	{ PR_fchmodat,		FILTER_SYSEXIT },
+	{ PR_fchmodat2,		FILTER_SYSEXIT },
 	{ PR_fchown,		FILTER_SYSEXIT },
 	{ PR_fchown32,		FILTER_SYSEXIT },
 	{ PR_fchownat,		FILTER_SYSEXIT },
@@ -394,8 +402,38 @@
  */
 static int restore_mode(ModifiedNode *node)
 {
+	LIST_REMOVE(node, link);
 	(void) chmod(node->path, node->mode);
 	return 0;
+}
+
+static bool get_chmod_final_mode(const Tracee *tracee, const char *path, mode_t *mode_out)
+{
+	switch (get_sysnum(tracee, ORIGINAL)) {
+	case PR_chmod:
+		*mode_out = peek_reg(tracee, ORIGINAL, SYSARG_2);
+		return true;
+
+	case PR_fchmodat:
+		*mode_out = peek_reg(tracee, ORIGINAL, SYSARG_3);
+		return true;
+
+	case PR_fchmodat2: {
+		word_t flags = peek_reg(tracee, ORIGINAL, SYSARG_4);
+		if ((flags & ~(AT_SYMLINK_NOFOLLOW | AT_EMPTY_PATH)) != 0)
+			return false;
+		if ((flags & AT_SYMLINK_NOFOLLOW) != 0) {
+			struct stat lperms;
+			if (lstat(path, &lperms) < 0 || S_ISLNK(lperms.st_mode))
+				return false;
+		}
+		*mode_out = peek_reg(tracee, ORIGINAL, SYSARG_3);
+		return true;
+	}
+
+	default:
+		return false;
+	}
 }
 
 /**
@@ -404,17 +442,41 @@
  * The original permissions are restored through talloc destructors.
  * See canonicalize() for the meaning of @is_final.
  */
-static void override_permissions(const Tracee *tracee, const char *path, bool is_final)
+static void override_permissions(const Tracee *tracee, Config *config, const char *path, bool is_final)
 {
 	ModifiedNode *node;
 	struct stat perms;
 	mode_t new_mode;
+	mode_t chmod_mode = 0;
+	bool is_chmod_final = false;
 	int status;
 
 	/* Get the meta-data */
 	if (should_skip_file_access_due_to_f2fs_bug(tracee, path)) 
 		return;
 
+	if (is_final && get_sysnum(tracee, ORIGINAL) == PR_fchmodat2) {
+		word_t flags = peek_reg(tracee, ORIGINAL, SYSARG_4);
+		if ((flags & ~(AT_SYMLINK_NOFOLLOW | AT_EMPTY_PATH)) != 0)
+			return;
+		if ((flags & AT_SYMLINK_NOFOLLOW) != 0) {
+			struct stat lperms;
+			if (lstat(path, &lperms) < 0 || S_ISLNK(lperms.st_mode))
+				return;
+		}
+	}
+
+	if (is_final) {
+		is_chmod_final = get_chmod_final_mode(tracee, path, &chmod_mode);
+		if (is_chmod_final) {
+			ModifiedNode *existing;
+			LIST_FOREACH(existing, &config->modified_nodes, link) {
+				if (strcmp(existing->path, path) == 0)
+					existing->mode = chmod_mode;
+			}
+		}
+	}
+
 	status = stat(path, &perms);
 	if (status < 0)
 		return;
@@ -441,17 +503,11 @@
 		/* Restore the previous mode of any non final components.  */
 		node->mode = perms.st_mode;
 	}
+	else if (is_chmod_final) {
+		node->mode = chmod_mode;
+	}
 	else {
 		switch (get_sysnum(tracee, ORIGINAL)) {
-		/* For chmod syscalls: restore the new mode of the final component.  */
-		case PR_chmod:
-			node->mode = peek_reg(tracee, ORIGINAL, SYSARG_2);
-			break;
-
-		case PR_fchmodat:
-			node->mode = peek_reg(tracee, ORIGINAL, SYSARG_3);
-			break;
-
 		/* For stat syscalls: don't touch the mode of the final component.  */
 		case PR_fstatat64:
 		case PR_lstat:
@@ -463,6 +519,7 @@
 		case PR_stat64:
 		case PR_statfs:
 		case PR_statfs64:
+			TALLOC_FREE(node);
 			return;
 
 		/* Otherwise: restore the previous mode of the final component.  */
@@ -478,6 +535,8 @@
 		TALLOC_FREE(node);
 		return;
 	}
+
+	LIST_INSERT_HEAD(&config->modified_nodes, node, link);
 
 	/* The mode restoration works because Talloc destructors are
 	 * called in reverse order.  */
@@ -957,6 +1016,7 @@
 	case PR_fchown32:
 	case PR_lchown32:
 	case PR_fchmodat:
+	case PR_fchmodat2:
 	case PR_fchownat: 
 		return handle_perm_err_exit_end(tracee, config, false);
 
@@ -1163,6 +1223,7 @@
 		config->fsgid = gid;
 			/* Set the umask to the typical linux value. */
 			config->umask = 022;
+		LIST_INIT(&config->modified_nodes);
 
 		config->identity = (uid != 0 && uid == (int) getuid() && gid == (int) getgid());
 		extension->filtered_sysnums = config->identity
@@ -1193,6 +1254,7 @@
 			return -1;
 
 		memcpy(extension->config, parent->config, sizeof(Config));
+		LIST_INIT(&((Config *)extension->config)->modified_nodes);
 		return 0;
 	}
 
@@ -1203,7 +1265,7 @@
 		/* Force permissions if the tracee was supposed to
 		 * have the capability.  */
 		if (config->euid == 0) /* TODO: || HAS_CAP(DAC_OVERRIDE) */
-			override_permissions(tracee, (char*) data1, (bool) data2);
+			override_permissions(tracee, config, (char*) data1, (bool) data2);
 		return 0;
 	}
 
