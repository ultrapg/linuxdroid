 static int restore_mode(ModifiedNode *node)
 {
-	(void) chmod(node->path, node->mode);
+	LIST_REMOVE(node, link);
+	if (!node->skip_restore && node->path != NULL)
+		(void) chmod(node->path, node->mode);
 	return 0;
 }
 
+static void restore_all_modified_nodes(Config *config)
+{
+	while (!LIST_EMPTY(&config->modified_nodes)) {
+		ModifiedNode *node = LIST_FIRST(&config->modified_nodes);
+		TALLOC_FREE(node);
+	}
+}
+
+static bool resolve_l2s_final(const char *path, char resolved[PATH_MAX], struct stat *perms)
+{
+	char inter[PATH_MAX];
+	const char *base;
+	ssize_t n;
+
+	n = readlink(path, inter, PATH_MAX - 1);
+	if (n <= 0 || n >= PATH_MAX - 1)
+		return false;
+	inter[n] = '\0';
+
+	base = strrchr(inter, '/');
+	base = (base == NULL ? inter : base + 1);
+	if (strncmp(base, ".l2s.", 5) != 0 && strncmp(base, ".proot.l2s.", 11) != 0)
+		return false;
+
+	n = readlink(inter, resolved, PATH_MAX - 1);
+	if (n <= 0 || n >= PATH_MAX - 1)
+		return false;
+	resolved[n] = '\0';
+
+	if (lstat(resolved, perms) < 0 || S_ISLNK(perms->st_mode))
+		return false;
+	return true;
+}
+
+static void finalize_modified_nodes_before_exit(const Tracee *tracee, Config *config)
+{
+	char target_path[PATH_MAX];
+	ModifiedNode *node;
+	struct stat st;
+	Sysnum sysnum;
+	int status;
+
+	if (config->in_sigsys || tracee->status < 0 || LIST_EMPTY(&config->modified_nodes))
+		return;
+
+	if ((int) peek_reg(tracee, CURRENT, SYSARG_RESULT) != 0)
+		return;
+
+	sysnum = get_sysnum(tracee, ORIGINAL);
+	switch (sysnum) {
+	case PR_chmod:
+	case PR_fchmodat:
+	case PR_fchmodat2: {
+		Reg path_reg = (sysnum == PR_chmod ? SYSARG_1 : SYSARG_2);
+		word_t flags = (sysnum == PR_fchmodat2 ? peek_reg(tracee, ORIGINAL, SYSARG_4) : 0);
+
+		status = read_path(tracee, target_path, peek_reg(tracee, MODIFIED, path_reg));
+		if (status < 0)
+			return;
+		if (sysnum == PR_fchmodat2 && target_path[0] == '\0' && (flags & AT_EMPTY_PATH) != 0) {
+			snprintf(target_path, sizeof(target_path), "/proc/%d/fd/%d",
+				tracee->pid, (int) peek_reg(tracee, MODIFIED, SYSARG_1));
+			status = stat(target_path, &st);
+		} else if (sysnum == PR_fchmodat2 && (flags & AT_SYMLINK_NOFOLLOW) != 0) {
+			status = lstat(target_path, &st);
+		} else {
+			status = stat(target_path, &st);
+		}
+		if (status < 0 || !S_ISDIR(st.st_mode))
+			return;
+		LIST_FOREACH(node, &config->modified_nodes, link) {
+			if (node->is_dir && node->dev == st.st_dev && node->ino == st.st_ino)
+				node->skip_restore = true;
+		}
+		return;
+	}
+
+	case PR_rename:
+	case PR_renameat:
+	case PR_renameat2: {
+		Reg new_reg = (sysnum == PR_rename ? SYSARG_2 : SYSARG_4);
+		if (read_path(tracee, target_path, peek_reg(tracee, MODIFIED, new_reg)) <= 0)
+			return;
+		if (lstat(target_path, &st) < 0 || !S_ISDIR(st.st_mode))
+			return;
+		LIST_FOREACH(node, &config->modified_nodes, link) {
+			if (node->is_dir && node->dev == st.st_dev && node->ino == st.st_ino) {
+				char *dup = talloc_strdup(node, target_path);
+				if (dup != NULL) {
+					TALLOC_FREE(node->path);
+					node->path = dup;
+				}
+			}
+		}
+		return;
+	}
+
+	default:
+		return;
+	}
+}
