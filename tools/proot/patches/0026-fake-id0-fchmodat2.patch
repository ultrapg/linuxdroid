 /**
  * Force permissions of @path to "rwx" during the path translation of
  * current @tracee's syscall, in order to simulate CAP_DAC_OVERRIDE.
- * The original permissions are restored through talloc destructors.
+ * The original permissions are restored on syscall exit (or tracee teardown).
  * See canonicalize() for the meaning of @is_final.
  */
-static void override_permissions(const Tracee *tracee, const char *path, bool is_final)
+static void override_permissions(Tracee *tracee, Config *config, const char *path, bool is_final)
 {
+	char l2s_target[PATH_MAX];
+	const char *effective_path = path;
 	ModifiedNode *node;
 	struct stat perms;
 	mode_t new_mode;
-	int status;
+	Sysnum sysnum;
 
 	/* Get the meta-data */
-	if (should_skip_file_access_due_to_f2fs_bug(tracee, path)) 
+	if (should_skip_file_access_due_to_f2fs_bug(tracee, path))
 		return;
 
-	status = stat(path, &perms);
-	if (status < 0)
+	sysnum = config->in_sigsys
+		? get_sysnum(tracee, CURRENT)
+		: get_sysnum(tracee, ORIGINAL);
+
+	if (lstat(path, &perms) < 0)
 		return;
 
+	if (S_ISLNK(perms.st_mode)) {
+		if (!is_final
+		    || sysnum == PR_unlink
+		    || sysnum == PR_unlinkat
+		    || sysnum == PR_link
+		    || sysnum == PR_linkat
+		    || sysnum == PR_rename
+		    || sysnum == PR_renameat
+		    || sysnum == PR_renameat2
+		    || !resolve_l2s_final(path, l2s_target, &perms))
+			return;
+		effective_path = l2s_target;
+	}
+
+	switch (sysnum) {
+	/* chmod/fchmodat/fchmodat2 never require permission bits on the target
+	 * file or target directory itself; only intermediate directories
+	 * traversed during path lookup need S_IXUSR. */
+	case PR_chmod:
+	case PR_fchmodat:
+	case PR_fchmodat2:
+		if (is_final || !S_ISDIR(perms.st_mode))
+			return;
+		break;
+
+	/* Syscalls that never check permission bits on the final component. */
+	case PR_fstatat64:
+	case PR_lstat:
+	case PR_lstat64:
+	case PR_newfstatat:
+	case PR_oldlstat:
+	case PR_oldstat:
+	case PR_stat:
+	case PR_stat64:
+	case PR_statfs:
+	case PR_statfs64:
+	case PR_statx:
+	case PR_readlink:
+	case PR_readlinkat:
+	case PR_lchown:
+	case PR_lchown32:
+	case PR_unlink:
+	case PR_unlinkat:
+	case PR_rmdir:
+		if (is_final)
+			return;
+		break;
+
+	/* rename only checks write permission on a moved directory (for ".."),
+	 * never on renamed or replaced non-directory files. */
+	case PR_rename:
+	case PR_renameat:
+	case PR_renameat2:
+		if (is_final && !S_ISDIR(perms.st_mode))
+			return;
+		break;
+
+	default:
+		break;
+	}
+
 	/* Copy the current permissions */
 	new_mode = perms.st_mode & (S_IRWXU | S_IRWXG | S_IRWXO);
 
@@ -433,59 +616,33 @@ static void override_permissions(const Tracee *tracee, const char *path, bool is
 	if (new_mode == (perms.st_mode & (S_IRWXU | S_IRWXG | S_IRWXO)))
 		return;
 
-	node = talloc_zero(tracee->ctx, ModifiedNode);
+	node = talloc_zero(config, ModifiedNode);
 	if (node == NULL)
 		return;
 
-	if (!is_final) {
-		/* Restore the previous mode of any non final components.  */
-		node->mode = perms.st_mode;
-	}
-	else {
-		switch (get_sysnum(tracee, ORIGINAL)) {
-		/* For chmod syscalls: restore the new mode of the final component.  */
-		case PR_chmod:
-			node->mode = peek_reg(tracee, ORIGINAL, SYSARG_2);
-			break;
-
-		case PR_fchmodat:
-			node->mode = peek_reg(tracee, ORIGINAL, SYSARG_3);
-			break;
-
-		/* For stat syscalls: don't touch the mode of the final component.  */
-		case PR_fstatat64:
-		case PR_lstat:
-		case PR_lstat64:
-		case PR_newfstatat:
-		case PR_oldlstat:
-		case PR_oldstat:
-		case PR_stat:
-		case PR_stat64:
-		case PR_statfs:
-		case PR_statfs64:
-			return;
-
-		/* Otherwise: restore the previous mode of the final component.  */
-		default:
-			node->mode = perms.st_mode;
-			break;
-		}
-	}
-
-	node->path = talloc_strdup(node, path);
+	node->mode = perms.st_mode;
+	node->dev = perms.st_dev;
+	node->ino = perms.st_ino;
+	node->is_dir = S_ISDIR(perms.st_mode);
+	node->skip_restore = false;
+	node->path = talloc_strdup(node, effective_path);
 	if (node->path == NULL) {
 		/* Keep only consistent nodes.  */
 		TALLOC_FREE(node);
 		return;
 	}
 
-	/* The mode restoration works because Talloc destructors are
-	 * called in reverse order.  */
+	LIST_INSERT_HEAD(&config->modified_nodes, node, link);
+
+	/* The mode restoration works in reverse (LIFO) order.  */
 	talloc_set_destructor(node, restore_mode);
 
-	(void) chmod(path, new_mode);
+	if (!config->in_sigsys && tracee->seccomp == ENABLED) {
+		tracee->restart_how = PTRACE_SYSCALL;
+		tracee->sysexit_pending = true;
+	}
 
-	return;
+	(void) chmod(effective_path, new_mode);
 }
 
 /**
@@ -957,6 +1114,7 @@ static int handle_sysexit_end(Tracee *tracee, Config *config)
 	case PR_fchown32:
 	case PR_lchown32:
 	case PR_fchmodat:
+	case PR_fchmodat2:
 	case PR_fchownat: 
 		return handle_perm_err_exit_end(tracee, config, false);
 
@@ -1163,6 +1321,8 @@ int fake_id0_callback(Extension *extension, ExtensionEvent event, intptr_t data1
 		config->fsgid = gid;
 			/* Set the umask to the typical linux value. */
 			config->umask = 022;
+		LIST_INIT(&config->modified_nodes);
+		config->in_sigsys = false;
 
 		config->identity = (uid != 0 && uid == (int) getuid() && gid == (int) getgid());
 		extension->filtered_sysnums = config->identity
@@ -1193,6 +1353,25 @@ int fake_id0_callback(Extension *extension, ExtensionEvent event, intptr_t data1
 			return -1;
 
 		memcpy(extension->config, parent->config, sizeof(Config));
+		LIST_INIT(&((Config *)extension->config)->modified_nodes);
+		((Config *)extension->config)->in_sigsys = false;
+		return 0;
+	}
+
+	case NEW_STATUS: {
+		Tracee *tracee = TRACEE(extension);
+		Config *config = talloc_get_type_abort(extension->config, Config);
+		int tracee_status = (int) data1;
+
+		config->in_sigsys = (WIFSTOPPED(tracee_status) && WSTOPSIG(tracee_status) == SIGSYS);
+		if (!config->in_sigsys && IS_IN_SYSENTER(tracee))
+			restore_all_modified_nodes(config);
+		return 0;
+	}
+
+	case SYSCALL_ENTER_START: {
+		Config *config = talloc_get_type_abort(extension->config, Config);
+		restore_all_modified_nodes(config);
 		return 0;
 	}
 
@@ -1203,7 +1382,7 @@ int fake_id0_callback(Extension *extension, ExtensionEvent event, intptr_t data1
 		/* Force permissions if the tracee was supposed to
 		 * have the capability.  */
 		if (config->euid == 0) /* TODO: || HAS_CAP(DAC_OVERRIDE) */
-			override_permissions(tracee, (char*) data1, (bool) data2);
+			override_permissions(tracee, config, (char*) data1, (bool) data2);
 		return 0;
 	}
 
@@ -1270,8 +1449,12 @@ int fake_id0_callback(Extension *extension, ExtensionEvent event, intptr_t data1
 	case SYSCALL_EXIT_END: {
 		Tracee *tracee = TRACEE(extension);
 		Config *config = talloc_get_type_abort(extension->config, Config);
+		int status;
 
-		return handle_sysexit_end(tracee, config);
+		finalize_modified_nodes_before_exit(tracee, config);
+		status = handle_sysexit_end(tracee, config);
+		restore_all_modified_nodes(config);
+		return status;
 	}
 
 	case SIGSYS_OCC: {
diff --git a/src/syscall/enter.c b/src/syscall/enter.c
index 98241bd..d7bf570 100644
--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -491,6 +491,10 @@ int translate_syscall_enter(Tracee *tracee)
 		if (status < 0)
 			break;
 
