+static bool is_hex_pair(const char *s)
+{
+	return isxdigit((unsigned char) s[0]) && isxdigit((unsigned char) s[1]);
+}
+
+static bool is_ostree_or_flatpak_path(const char *path)
+{
+	const char *p;
+	size_t len;
+
+	if (path == NULL || path[0] == '\0')
+		return false;
+
+	if (strstr(path, "/flatpak/") != NULL || strstr(path, "/ostree/") != NULL)
+		return true;
+
+	/* Match custom OSTree repos (.../objects/XX/<hash>.file) */
+	p = strstr(path, "/objects/");
+	while (p != NULL) {
+		const char *after = p + strlen("/objects/");
+		if (is_hex_pair(after) && after[2] == '/') {
+			len = strlen(after + 3);
+			if ((len > 5 && strcmp(after + 3 + len - 5, ".file") == 0)
+			    || (len > 6 && strcmp(after + 3 + len - 6, ".filez") == 0)
+			    || (len > 8 && strcmp(after + 3 + len - 8, ".dirtree") == 0)
+			    || (len > 8 && strcmp(after + 3 + len - 8, ".dirmeta") == 0)
+			    || (len > 7 && strcmp(after + 3 + len - 7, ".commit") == 0)) {
+				return true;
+			}
+		}
+		p = strstr(after, "/objects/");
+	}
+
+	return false;
+}
