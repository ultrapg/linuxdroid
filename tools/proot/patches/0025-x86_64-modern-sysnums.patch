From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Date: Wed, 04 Nov 2026 12:39:00 +0000
Subject: [PATCH] syscall: add openat2, fchmodat2, and new mount API sysnums
 for x86_64 and i386

Ensure host x86_64/i386 PRoot builds (including QEMU user-mode rootfs builds
and x86/x86_64 tracees) translate openat2, fchmodat2, and the new mount API
syscalls identically to arm64 and arm.
---
 src/syscall/sysnums-i386.h   | 6 ++++++
 src/syscall/sysnums-x86_64.h | 6 ++++++
 2 files changed, 12 insertions(+)

diff --git a/src/syscall/sysnums-i386.h b/src/syscall/sysnums-i386.h
index 24f5df6..9bc57f9 100644
--- a/src/syscall/sysnums-i386.h
+++ b/src/syscall/sysnums-i386.h
@@ -381,6 +381,12 @@ static const Sysnum sysnums_i386[] = {
 	[ 381 ] = PR_pkey_alloc,
 	[ 382 ] = PR_pkey_free,
 	[ 383 ] = PR_statx,
+	[ 428 ] = PR_open_tree,
+	[ 429 ] = PR_move_mount,
+	[ 433 ] = PR_fspick,
 	[ 435 ] = PR_clone3,
+	[ 437 ] = PR_openat2,
 	[ 439 ] = PR_faccessat2,
+	[ 442 ] = PR_mount_setattr,
+	[ 452 ] = PR_fchmodat2,
 };
diff --git a/src/syscall/sysnums-x86_64.h b/src/syscall/sysnums-x86_64.h
index 2ceaf90..a9f90e0 100644
--- a/src/syscall/sysnums-x86_64.h
+++ b/src/syscall/sysnums-x86_64.h
@@ -334,6 +334,12 @@ static const Sysnum sysnums_x86_64[] = {
 	[ 330 ] = PR_pkey_alloc,
 	[ 331 ] = PR_pkey_free,
 	[ 332 ] = PR_statx,
+	[ 428 ] = PR_open_tree,
+	[ 429 ] = PR_move_mount,
+	[ 433 ] = PR_fspick,
         [ 435 ] = PR_clone3,
+	[ 437 ] = PR_openat2,
 	[ 439 ] = PR_faccessat2,
+	[ 442 ] = PR_mount_setattr,
+	[ 452 ] = PR_fchmodat2,
 };
