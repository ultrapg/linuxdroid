+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   const uint64_t aligned_size = align(alloc_info->allocationSize, 4096);
+   if (aligned_size == 0 || aligned_size > UINT32_MAX)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
