+typedef const void *(*pfn_ahb_get_native_handle)(const AHardwareBuffer *);
+
+static pfn_ahb_get_native_handle
+vkr_get_ahb_native_handle_fn(void)
+{
+   static pfn_ahb_get_native_handle fn = NULL;
+   static bool initialized = false;
+   if (!initialized) {
+      void *nw = dlopen("libnativewindow.so", RTLD_NOW | RTLD_NOLOAD);
+      if (!nw)
+         nw = dlopen("libnativewindow.so", RTLD_NOW);
+      if (nw) {
+         void *sym = dlsym(nw, "AHardwareBuffer_getNativeHandle");
+         if (sym)
+            memcpy(&fn, &sym, sizeof(fn));
+      }
+      initialized = true;
+   }
+   return fn;
+}
+
+static inline void
+vkr_ahb_release(struct AHardwareBuffer *ahb)
+{
+   if (ahb)
+      AHardwareBuffer_release(ahb);
+}
+
+static int
+vkr_ahb_export_dmabuf_fd(struct AHardwareBuffer *ahb, uint64_t min_size)
+{
+   pfn_ahb_get_native_handle get_nh = vkr_get_ahb_native_handle_fn();
+   if (!get_nh || !ahb)
+      return -1;
+   const struct vkr_android_native_handle *nh =
+      (const struct vkr_android_native_handle *)get_nh(ahb);
+   if (!nh || nh->numFds < 1)
+      return -1;
+   int best_fd = -1;
+   for (int i = 0; i < nh->numFds; i++) {
+      int candidate = nh->data[i];
+      if (candidate < 0)
+         continue;
+      off_t sz = lseek(candidate, 0, SEEK_END);
+      if (sz >= 0 && (uint64_t)sz >= min_size) {
+         best_fd = candidate;
+         break;
+      }
+      if (best_fd < 0)
+         best_fd = candidate;
+   }
+   return best_fd >= 0 ? os_dupfd_cloexec(best_fd) : -1;
+}
