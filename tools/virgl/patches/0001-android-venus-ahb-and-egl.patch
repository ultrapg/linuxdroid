+   PFN_vkGetAndroidHardwareBufferPropertiesANDROID get_props =
+      (PFN_vkGetAndroidHardwareBufferPropertiesANDROID)vkGetDeviceProcAddr(
+         dev->base.handle.device, "vkGetAndroidHardwareBufferPropertiesANDROID");
+   if (!get_props) {
+      AHardwareBuffer_release(ahb);
+      return VK_ERROR_EXTENSION_NOT_PRESENT;
+   }
+
+   VkAndroidHardwareBufferPropertiesANDROID ahb_props = {
+      .sType = VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_PROPERTIES_ANDROID,
+   };
+   VkResult res = get_props(dev->base.handle.device, ahb, &ahb_props);
+   if (res != VK_SUCCESS || ahb_props.memoryTypeBits == 0) {
+      AHardwareBuffer_release(ahb);
+      return res != VK_SUCCESS ? res : VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   }
+
+   if (!((1u << alloc_info->memoryTypeIndex) & ahb_props.memoryTypeBits)) {
+      int chosen = -1;
+      for (uint32_t i = 0; i < physical_dev->memory_properties.memoryTypeCount; i++) {
+         if (!((1u << i) & ahb_props.memoryTypeBits))
+            continue;
+         uint32_t flags = physical_dev->memory_properties.memoryTypes[i].propertyFlags;
+         if ((flags & req_prop_flags) == req_prop_flags) {
+            chosen = (int)i;
+            break;
+         }
+         if (chosen < 0 && (flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+            chosen = (int)i;
+      }
+      if (chosen < 0)
+         chosen = ffs((int)ahb_props.memoryTypeBits) - 1;
+      alloc_info->memoryTypeIndex = (uint32_t)chosen;
+   }
+
+   if (dedicated && dedicated->buffer != VK_NULL_HANDLE &&
+       ahb_props.allocationSize != alloc_info->allocationSize) {
+      VkBaseInStructure *prev_ded = vkr_find_prev_struct(
+         alloc_info, VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO);
+      if (prev_ded)
+         prev_ded->pNext = ((const VkBaseInStructure *)dedicated)->pNext;
+   }
+
+   alloc_info->allocationSize = ahb_props.allocationSize;
+   *out_import = (VkImportAndroidHardwareBufferInfoANDROID){
+      .sType = VK_STRUCTURE_TYPE_IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID,
+      .pNext = alloc_info->pNext,
+      .buffer = ahb,
+   };
+   alloc_info->pNext = out_import;
+   *out_ahb = ahb;
+   return VK_SUCCESS;
+}
